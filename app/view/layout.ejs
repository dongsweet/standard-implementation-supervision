<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - 安全规范落实与持续监管系统</title>
  <link rel="stylesheet" href="/public/vendor/adminlte/css/adminlte.min.css">
  <style>
    .sidebar-brand-mark { display:inline-grid; place-items:center; width:2rem; height:2rem; margin-right:.55rem; border-radius:.45rem; background:#0d6efd; color:#fff; font-weight:700; }
    .sidebar-section { padding:.85rem 1rem .35rem; color:rgba(255,255,255,.55); font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; }
    .nav-link.disabled-item { color:rgba(255,255,255,.5); cursor:default; }
    .nav-link.disabled-item:hover { background:transparent; }
    .nav-link.disabled-item .badge { font-size:.6rem; font-weight:500; }
    .app-content-header { padding:1rem 1.5rem .25rem; }
    .app-content { padding:1rem 1.5rem 1.5rem; }
    @media (max-width:575.98px) { .app-content-header,.app-content { padding-left:.75rem; padding-right:.75rem; } }
  </style>
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">
    <nav class="app-header navbar navbar-expand bg-body border-bottom">
      <div class="container-fluid">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="展开或收起导航"><span aria-hidden="true">☰</span></a></li>
          <li class="nav-item d-none d-sm-block"><span class="nav-link text-secondary">安全规范落实与持续监管系统</span></li>
        </ul>
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item me-2">
            <form method="post" action="/current-project" class="d-flex align-items-center gap-2">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="returnTo" value="/project-overview">
              <label class="small text-secondary text-nowrap" for="currentProjectSelect">当前项目</label>
              <select id="currentProjectSelect" name="projectId" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="切换当前项目" style="max-width:260px">
                <option value="">未选择</option>
                <% (projects || []).forEach(project => { %><option value="<%= project.id %>" <%= currentProject && currentProject.id === project.id ? 'selected' : '' %>><%= project.name %></option><% }) %>
              </select>
            </form>
          </li>
          <li class="nav-item"><span class="nav-link"><%= user.display_name %></span></li>
          <li class="nav-item px-2">
            <form method="post" action="/logout" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit">退出</button>
            </form>
          </li>
        </ul>
      </div>
    </nav>

    <aside class="app-sidebar bg-dark shadow" data-bs-theme="dark">
      <div class="sidebar-brand border-bottom border-secondary border-opacity-25">
        <a href="/" class="brand-link text-decoration-none">
          <span class="sidebar-brand-mark">安</span><span class="brand-text fw-light">安全规范监管</span>
        </a>
      </div>
      <div class="sidebar-wrapper">
        <nav class="mt-2" aria-label="主导航">
          <ul class="nav sidebar-menu flex-column" role="menu">
            <li class="nav-item">
              <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>"><span class="nav-icon">⌂</span><p>系统工作台</p></a>
            </li>

            <li class="sidebar-section">项目协同</li>
            <li class="nav-item"><a href="/project-overview" class="nav-link <%= currentPath.startsWith('/project-overview') ? 'active' : '' %>"><span class="nav-icon">⌂</span><p>项目总览</p></a></li>
            <li class="nav-item"><a href="/projects" class="nav-link <%= currentPath.startsWith('/projects') ? 'active' : '' %>"><span class="nav-icon">▦</span><p>项目管理</p></a></li>
            <li class="nav-item"><span class="nav-link disabled-item"><span class="nav-icon">▧</span><p>云中心管理<span class="badge text-bg-secondary ms-auto">建设中</span></p></span></li>

            <li class="sidebar-section">规范应答</li>
            <li class="nav-item"><a href="/standards" class="nav-link <%= currentPath.startsWith('/standards') ? 'active' : '' %>"><span class="nav-icon">≡</span><p>标准接入</p></a></li>
            <li class="nav-item"><span class="nav-link disabled-item"><span class="nav-icon">✓</span><p>章节应答<span class="badge text-bg-secondary ms-auto">建设中</span></p></span></li>
            <li class="nav-item"><span class="nav-link disabled-item"><span class="nav-icon">▤</span><p>证据材料<span class="badge text-bg-secondary ms-auto">建设中</span></p></span></li>

            <li class="sidebar-section">持续监督</li>
            <li class="nav-item"><span class="nav-link disabled-item"><span class="nav-icon">◷</span><p>监督定义<span class="badge text-bg-secondary ms-auto">建设中</span></p></span></li>
            <li class="nav-item">
              <a href="/dedupe" class="nav-link <%= currentPath.startsWith('/dedupe') ? 'active' : '' %>"><span class="nav-icon">⇄</span><p>去重复核</p></a>
            </li>
            <li class="nav-item"><span class="nav-link disabled-item"><span class="nav-icon">☑</span><p>检查记录<span class="badge text-bg-secondary ms-auto">建设中</span></p></span></li>

            <li class="sidebar-section">系统管理</li>
            <li class="nav-item"><a href="/users" class="nav-link <%= currentPath.startsWith('/users') ? 'active' : '' %>"><span class="nav-icon">⚙</span><p>用户与权限</p></a></li>
            <li class="nav-item"><span class="nav-link disabled-item"><span class="nav-icon">▣</span><p>审计日志<span class="badge text-bg-secondary ms-auto">建设中</span></p></span></li>
          </ul>
        </nav>
      </div>
    </aside>

    <main class="app-main">
      <div class="app-content-header">
        <div class="container-fluid">
          <div class="row align-items-center">
            <div class="col-sm-6"><h3 class="mb-0"><%= title %></h3></div>
            <div class="col-sm-6">
              <ol class="breadcrumb float-sm-end mb-0">
                <li class="breadcrumb-item"><a href="/">工作台</a></li>
                <% if (currentPath !== '/') { %><li class="breadcrumb-item active" aria-current="page"><%= title %></li><% } %>
              </ol>
            </div>
          </div>
        </div>
      </div>
      <div class="app-content"><div class="container-fluid"><%- bodyContent %></div></div>
    </main>
  </div>
  <div class="modal fade" id="appNoticeModal" tabindex="-1" aria-labelledby="appNoticeModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="appNoticeModalTitle">提示</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body" id="appNoticeModalMessage"></div>
      <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">知道了</button></div>
    </div></div>
  </div>
  <div class="modal fade" id="appConfirmModal" tabindex="-1" aria-labelledby="appConfirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="appConfirmModalTitle">请确认</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body" id="appConfirmModalMessage"></div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button type="button" class="btn btn-danger" id="appConfirmModalSubmit">确认</button></div>
    </div></div>
  </div>
  <script src="/public/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/public/vendor/adminlte/js/adminlte.min.js"></script>
  <script>
    (() => {
      const noticeElement = document.getElementById('appNoticeModal');
      const noticeModal = bootstrap.Modal.getOrCreateInstance(noticeElement);
      const confirmElement = document.getElementById('appConfirmModal');
      const confirmModal = bootstrap.Modal.getOrCreateInstance(confirmElement);
      const confirmButton = document.getElementById('appConfirmModalSubmit');

      window.showAppNotice = (message, title = '提示') => {
        document.getElementById('appNoticeModalTitle').textContent = title;
        document.getElementById('appNoticeModalMessage').textContent = String(message || '');
        noticeModal.show();
      };

      window.confirmAppAction = (message, title = '请确认') => new Promise(resolve => {
        document.getElementById('appConfirmModalTitle').textContent = title;
        document.getElementById('appConfirmModalMessage').textContent = String(message || '');
        let settled = false;
        const finish = value => {
          if (settled) return;
          settled = true;
          confirmButton.removeEventListener('click', onConfirm);
          confirmElement.removeEventListener('hidden.bs.modal', onCancel);
          resolve(value);
        };
        const onConfirm = () => {
          finish(true);
          confirmModal.hide();
        };
        const onCancel = () => finish(false);
        confirmButton.addEventListener('click', onConfirm);
        confirmElement.addEventListener('hidden.bs.modal', onCancel, { once: true });
        confirmModal.show();
      });

      document.addEventListener('submit', event => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || !form.dataset.confirm || form.dataset.confirmed === 'true') return;
        event.preventDefault();
        const submitter = event.submitter;
        const activeModal = document.querySelector('.modal.show');
        const askAndSubmit = () => window.confirmAppAction(form.dataset.confirm, form.dataset.confirmTitle || '请确认').then(confirmed => {
          if (!confirmed) {
            if (activeModal) bootstrap.Modal.getOrCreateInstance(activeModal).show();
            return;
          }
          form.dataset.confirmed = 'true';
          if (submitter) form.requestSubmit(submitter);
          else form.requestSubmit();
        });
        if (activeModal) {
          activeModal.addEventListener('hidden.bs.modal', askAndSubmit, { once: true });
          bootstrap.Modal.getOrCreateInstance(activeModal).hide();
        } else askAndSubmit();
      });

      const params = new URLSearchParams(window.location.search);
      const notice = params.get('notice');
      if (notice) {
        window.showAppNotice(notice);
        params.delete('notice');
        const query = params.toString();
        window.history.replaceState({}, '', window.location.pathname + (query ? '?' + query : '') + window.location.hash);
      }
    })();
  </script>
</body>
</html>
