<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <p class="text-secondary mb-0">用户账号由系统统一维护；固定角色决定全局能力，项目角色在项目配置中单独授权。</p>
  <button class="btn btn-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#createUserModal">新建用户</button>
</div>

<div class="alert alert-light border mb-3"><strong>权限边界：</strong>系统管理员管理用户、角色和项目；审计管理员全局只读；安全管理员维护规范与安全业务；项目管理员和操作员只在被授权项目内生效。</div>

<div class="card mb-4">
  <div class="card-header"><h3 class="card-title">固定角色矩阵</h3></div>
  <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>角色</th><th>作用范围</th><th>职责说明</th></tr></thead><tbody><% roles.forEach(role => { %><tr><td><span class="badge <%= role.scope === 'global' ? 'text-bg-primary' : 'text-bg-light' %>"><%= role.name %></span></td><td><%= role.scope === 'global' ? '全局' : '项目' %></td><td><%= role.description %></td></tr><% }) %></tbody></table></div>
</div>

<div class="card">
  <div class="card-header"><h3 class="card-title">账号列表</h3><span class="badge text-bg-secondary ms-auto"><%= users.length %> 个账号</span></div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>用户名</th><th>显示名称</th><th>全局角色</th><th>项目授权</th><th>状态</th><th class="text-end">操作</th></tr></thead>
      <tbody>
        <% users.forEach(account => { %>
          <tr>
            <td><strong><%= account.username %></strong></td>
            <td><%= account.display_name %></td>
            <td><% (account.global_roles || []).forEach(role => { %><span class="badge text-bg-primary me-1"><%= role.name %></span><% }) %><% if (!(account.global_roles || []).length) { %><span class="text-secondary">无</span><% } %></td>
            <td><%= account.project_count %> 个项目</td>
            <td><span class="badge <%= account.is_active ? 'text-bg-success' : 'text-bg-secondary' %>"><%= account.is_active ? '启用' : '停用' %></span></td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <form method="post" action="/users/<%= account.id %>/active" data-confirm="确定<%= account.is_active ? '停用' : '启用' %>账号“<%= account.display_name %>”吗？" data-confirm-title="账号状态变更">
                  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="isActive" value="<%= account.is_active ? 'false' : 'true' %>"><button class="btn btn-outline-secondary" type="submit"><%= account.is_active ? '停用' : '启用' %></button>
                </form>
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editUserModal-<%= account.id %>">编辑权限</button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!users.length) { %><tr><td colspan="6" class="text-center text-secondary py-5">暂无用户。</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/users"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="createUserModalLabel">创建本地账号</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-md-4"><label class="form-label" for="newUsername">用户名</label><input class="form-control" id="newUsername" name="username" required autocomplete="off"></div>
      <div class="col-md-4"><label class="form-label" for="newDisplayName">显示名称</label><input class="form-control" id="newDisplayName" name="displayName" required></div>
      <div class="col-md-4"><label class="form-label" for="newPassword">初始密码</label><input class="form-control" id="newPassword" type="password" name="password" minlength="12" required autocomplete="new-password"><div class="form-text">至少 12 位。</div></div>
      <div class="col-12"><label class="form-label" for="newGlobalRole">全局角色</label><select class="form-select" id="newGlobalRole" name="globalRoles"><option value="">无全局角色</option><% roles.filter(role => role.scope === 'global').forEach(role => { %><option value="<%= role.code %>"><%= role.name %></option><% }) %></select></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">创建用户</button></div>
  </form>
</div></div></div>

<% users.forEach(account => { %>
  <div class="modal fade" id="editUserModal-<%= account.id %>" tabindex="-1" aria-labelledby="editUserModalLabel-<%= account.id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="editUserModalLabel-<%= account.id %>">编辑账号权限 · <%= account.display_name %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <form class="mb-4" method="post" action="/users/<%= account.id %>/roles">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">全局角色（固定角色，可多选）</label>
        <div class="d-flex flex-wrap gap-3 mb-3"><% roles.filter(role => role.scope === 'global').forEach(role => { const checked = (account.global_roles || []).some(current => current.code === role.code); %><div class="form-check"><input class="form-check-input" type="checkbox" name="globalRoles" value="<%= role.code %>" id="<%= account.id %>-<%= role.code %>" <%= checked ? 'checked' : '' %>><label class="form-check-label" for="<%= account.id %>-<%= role.code %>"><%= role.name %></label></div><% }) %></div>
        <button class="btn btn-primary" type="submit">保存全局角色</button>
      </form>
      <hr>
      <form method="post" action="/users/<%= account.id %>/password" data-confirm="确定重置“<%= account.display_name %>”的登录密码吗？" data-confirm-title="重置密码">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label" for="password-<%= account.id %>">重置密码</label>
        <div class="input-group"><input class="form-control" id="password-<%= account.id %>" type="password" name="password" minlength="12" required placeholder="至少 12 位"><button class="btn btn-outline-primary" type="submit">重置密码</button></div>
      </form>
      <div class="form-text mt-3">项目角色请进入对应项目的“项目配置”维护。章节负责人也是项目级授权，不属于全局角色。</div>
    </div>
  </div></div></div>
<% }) %>
