<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <p class="text-secondary mb-0">用户账号由系统统一维护；固定角色决定全局能力，项目角色在项目配置中单独授权。</p>
  <button class="btn btn-primary ms-auto" data-bs-toggle="collapse" data-bs-target="#newUserForm">新建用户</button>
</div>

<div class="alert alert-light border mb-3">
  <strong>权限边界：</strong>系统管理员管理用户、角色和项目；审计管理员全局只读；安全管理员维护规范与安全业务；项目管理员和操作员只在被授权项目内生效。
</div>

<div class="collapse mb-4" id="newUserForm">
  <div class="card card-primary card-outline">
    <form method="post" action="/users">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="card-header"><h3 class="card-title">创建本地账号</h3></div>
      <div class="card-body row g-3">
        <div class="col-md-3"><label class="form-label">用户名</label><input class="form-control" name="username" required autocomplete="off"></div>
        <div class="col-md-3"><label class="form-label">显示名称</label><input class="form-control" name="displayName" required></div>
        <div class="col-md-4"><label class="form-label">初始密码</label><input class="form-control" type="password" name="password" minlength="12" required autocomplete="new-password"><div class="form-text">至少 12 位。</div></div>
        <div class="col-md-2"><label class="form-label">全局角色</label><select class="form-select" name="globalRoles"><option value="">无全局角色</option><% roles.filter(role => role.scope === 'global').forEach(role => { %><option value="<%= role.code %>"><%= role.name %></option><% }) %></select></div>
      </div>
      <div class="card-footer"><button class="btn btn-primary" type="submit">创建用户</button></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3 class="card-title">账号列表</h3><span class="badge text-bg-secondary float-end"><%= users.length %> 个账号</span></div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>用户名</th><th>显示名称</th><th>全局角色</th><th>项目授权</th><th>状态</th><th class="text-end">操作</th></tr></thead>
      <tbody>
        <% users.forEach(account => { %>
          <tr>
            <td><strong><%= account.username %></strong></td>
            <td><%= account.display_name %></td>
            <td><% (account.global_roles || []).forEach(role => { %><span class="badge text-bg-primary me-1"><%= role.name %></span><% }) %><% if (!(account.global_roles || []).length) { %><span class="text-secondary">无</span><% } %></td>
            <td><%= account.project_count %> 个项目</td>
            <td><span class="badge <%= account.is_active ? 'text-bg-success' : 'text-bg-secondary' %>"><%= account.is_active ? '启用' : '停用' %></span></td>
            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <form method="post" action="/users/<%= account.id %>/active"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="isActive" value="<%= account.is_active ? 'false' : 'true' %>"><button class="btn btn-outline-secondary" type="submit"><%= account.is_active ? '停用' : '启用' %></button></form>
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#user-<%= account.id %>">编辑权限</button>
              </div>
            </td>
          </tr>
          <tr class="collapse bg-body-tertiary" id="user-<%= account.id %>"><td colspan="6">
            <div class="row g-3 align-items-end p-2">
              <form class="col-md-5" method="post" action="/users/<%= account.id %>/roles"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">全局角色（固定角色，可多选）</label><div class="d-flex flex-wrap gap-3"><% roles.filter(role => role.scope === 'global').forEach(role => { const checked = (account.global_roles || []).some(current => current.code === role.code); %><div class="form-check"><input class="form-check-input" type="checkbox" name="globalRoles" value="<%= role.code %>" id="<%= account.id %>-<%= role.code %>" <%= checked ? 'checked' : '' %>><label class="form-check-label" for="<%= account.id %>-<%= role.code %>"><%= role.name %></label></div><% }) %></div><button class="btn btn-sm btn-primary mt-2" type="submit">保存全局角色</button></form>
              <form class="col-md-4" method="post" action="/users/<%= account.id %>/password"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">重置密码</label><input class="form-control form-control-sm" type="password" name="password" minlength="12" required placeholder="至少 12 位"><button class="btn btn-sm btn-outline-primary mt-2" type="submit">重置密码</button></form>
              <div class="col-md-3 small text-secondary">项目角色请进入对应项目的“项目配置”维护。章节负责人也是项目级授权，不属于全局角色。</div>
            </div>
          </td></tr>
        <% }) %>
        <% if (!users.length) { %><tr><td colspan="6" class="text-center text-secondary py-5">暂无用户。</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
