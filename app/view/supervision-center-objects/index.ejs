<%
  const centerValue = typeof center === 'undefined' ? '' : (center || '');
  const searchValue = typeof search === 'undefined' ? '' : (search || '');
  const categoryValue = typeof category === 'undefined' ? '' : (category || '');
  const categoryInputValue = typeof categoryInput === 'undefined' ? categoryValue : (categoryInput || categoryValue);
  const viewValue = [ 'overview', 'pending', 'categories' ].includes(typeof view === 'undefined' ? '' : view) ? view : 'overview';
  const objectCategoriesValue = Array.isArray(typeof objectCategories === 'undefined' ? null : objectCategories) ? objectCategories : [];
  const centerObjectsValue = Array.isArray(typeof centerObjects === 'undefined' ? null : centerObjects) ? centerObjects : [];
  const totalValue = typeof total === 'undefined' ? centerObjectsValue.length : total;
  const pageValue = typeof page === 'undefined' ? 1 : (page || 1);
  const pageCountValue = typeof pageCount === 'undefined' ? 1 : (pageCount || 1);
  const buildUrl = (targetView = viewValue, targetPage = 1, options = {}) => {
    const params = [ 'view=' + encodeURIComponent(targetView) ];
    const nextCenter = Object.hasOwn(options, 'center') ? options.center : centerValue;
    const nextSearch = Object.hasOwn(options, 'search') ? options.search : searchValue;
    const nextCategory = Object.hasOwn(options, 'categoryInput') ? options.categoryInput : categoryInputValue;
    if (nextCenter) params.push('center=' + encodeURIComponent(nextCenter));
    if (nextSearch) params.push('search=' + encodeURIComponent(nextSearch));
    if (nextCategory) params.push('categoryInput=' + encodeURIComponent(nextCategory));
    if (targetPage > 1) params.push('page=' + targetPage);
    return '/supervision-center-objects?' + params.join('&');
  };
  const resetUrl = targetView => buildUrl(targetView, 1, {
    center: '',
    search: '',
    categoryInput: '',
  });
  const canWrite = user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code));
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div><h2 class="h4 mb-1">检查对象</h2><p class="text-secondary mb-0">维护规范化对象、对象分类和适用机构关系。检查方案中的检查方法、层面和检查内容仍在方案页维护。</p></div>
  <div class="ms-auto d-flex gap-2"><a class="btn btn-outline-primary" href="/supervision-center-objects/dedupe">对象去重复核</a><a class="btn btn-outline-secondary" href="/supervision-definitions">查看检查方案</a></div>
</div>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item"><a class="nav-link <%= viewValue === 'overview' ? 'active' : '' %>" href="<%= buildUrl('overview') %>">对象总览</a></li>
  <li class="nav-item"><a class="nav-link <%= viewValue === 'pending' ? 'active' : '' %>" href="<%= buildUrl('pending') %>">待整理对象</a></li>
  <li class="nav-item"><a class="nav-link <%= viewValue === 'categories' ? 'active' : '' %>" href="<%= buildUrl('categories') %>">分类维护</a></li>
</ul>

<% if (viewValue === 'categories') { %>
<div class="row g-3">
  <% if (canWrite) { %><div class="col-12 col-lg-4"><div class="card"><div class="card-header"><h3 class="card-title">新增对象分类</h3></div><div class="card-body"><form method="post" action="/api/supervision-center-objects/categories" id="categoryForm"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="mb-3"><label class="form-label" for="categoryName">分类名称</label><input class="form-control" id="categoryName" name="name" maxlength="200" required placeholder="例如：制度、技术、人员"></div><div class="mb-3"><label class="form-label" for="categoryDescription">分类说明</label><textarea class="form-control" id="categoryDescription" name="description" rows="3"></textarea></div><button class="btn btn-primary" type="submit">保存分类</button></form></div></div></div><% } %>
  <div class="col-12 <%= canWrite ? 'col-lg-8' : '' %>"><div class="card"><div class="card-header d-flex align-items-center"><h3 class="card-title">对象分类</h3><span class="badge text-bg-secondary ms-auto"><%= objectCategoriesValue.length %> 个</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>分类</th><th>说明</th><th>对象数量</th><th class="text-end">操作</th></tr></thead><tbody><% objectCategoriesValue.forEach(item => { %><tr><td><strong><%= item.name %></strong></td><td><%= item.description || '-' %></td><td><%= item.object_count %></td><td class="text-end"><% if (canWrite && Number(item.object_count) === 0) { %><button class="btn btn-sm btn-outline-danger" type="button" data-category-id="<%= item.id %>" data-category-name="<%= item.name %>" onclick="deleteObjectCategory(this)">删除</button><% } else if (canWrite) { %><span class="small text-secondary">有对象使用</span><% } %></td></tr><% }) %><% if (!objectCategoriesValue.length) { %><tr><td colspan="4" class="text-center text-secondary py-5">尚未建立对象分类。</td></tr><% } %></tbody></table></div></div></div>
</div>
<% } else { %>
<style>
  .object-category-combobox { position: relative; }
  .object-category-combobox-input { padding-right: 2.5rem; background: #fff; }
  .object-category-combobox-toggle { position: absolute; top: 1px; right: 1px; bottom: 1px; width: 2.25rem; border: 0; background: transparent; color: #6c757d; }
  .object-category-combobox-toggle:hover, .object-category-combobox-toggle:focus { color: #0d6efd; outline: none; }
  .object-category-combobox-menu { position: absolute; z-index: 1050; top: calc(100% + 4px); left: 0; right: 0; max-height: 180px; overflow-y: auto; background: #fff; border: 1px solid #d8dee6; border-radius: .25rem; box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12); padding: .25rem 0; }
  .object-category-combobox-option, .object-category-combobox-empty { display: block; width: 100%; border: 0; background: transparent; padding: .55rem .75rem; text-align: left; }
  .object-category-combobox-option { cursor: pointer; color: #212529; }
  .object-category-combobox-option:hover, .object-category-combobox-option.is-active { background: #f1f4f8; }
  .object-category-combobox-option .option-subtitle { display: block; margin-top: .1rem; color: #6c757d; font-size: .8125rem; }
  .object-category-combobox-empty { color: #6c757d; }
  .object-plan-numbers { display: flex; flex-wrap: wrap; gap: .2rem .35rem; }
  .object-plan-number { border: 0; padding: 0; background: transparent; color: #0d6efd; font: inherit; text-decoration: underline; text-underline-offset: 2px; cursor: help; }
  .object-plan-number:hover, .object-plan-number:focus-visible { color: #0a58ca; }
  #objectPlanPopover { position: fixed; inset: auto; width: min(30rem, calc(100vw - 2rem)); max-height: min(30rem, calc(100dvh - 2rem)); margin: 0; padding: 0; border: 1px solid #d8dee6; border-radius: .35rem; box-shadow: 0 .75rem 2rem rgba(0,0,0,.18); }
  #objectPlanPopover::backdrop { background: transparent; }
  .object-plan-popover-head { display: flex; align-items: center; gap: .5rem; padding: .65rem .75rem; border-bottom: 1px solid #e8edf3; }
  .object-plan-popover-body { max-height: 24rem; overflow-y: auto; padding: .75rem; font-size: .875rem; line-height: 1.55; }
  .object-plan-popover-row { margin-bottom: .45rem; }
  .object-plan-popover-row:last-child { margin-bottom: 0; }
</style>
<div class="card mb-3"><div class="card-body"><form method="get" action="/supervision-center-objects" class="row g-2 align-items-end"><input type="hidden" name="view" value="<%= viewValue %>"><div class="col-12 col-md-4"><label class="form-label" for="objectSearch">规范对象、原始名称或分类</label><input class="form-control" id="objectSearch" name="search" value="<%= searchValue %>" placeholder="搜索对象、别名或对象分类"></div><div class="col-6 col-md-3"><label class="form-label" for="objectCenter">适用机构</label><select class="form-select" id="objectCenter" name="center"><option value="">全部机构</option><% centerOptions.forEach(option => { %><option value="<%= option %>" <%= centerValue === option ? 'selected' : '' %>><%= option %></option><% }) %></select></div><div class="col-6 col-md-3"><label class="form-label" for="objectCategory">对象分类</label><div class="object-category-combobox" id="objectCategoryCombobox"><input class="form-control object-category-combobox-input" id="objectCategory" name="categoryInput" type="search" value="<%= categoryInputValue %>" autocomplete="off" placeholder="输入对象分类名称筛选" role="combobox" aria-expanded="false" aria-controls="objectCategoryMenu" aria-autocomplete="list"><button class="object-category-combobox-toggle" id="objectCategoryToggle" type="button" aria-label="展开对象分类候选">&#9662;</button><div class="object-category-combobox-menu d-none" id="objectCategoryMenu" role="listbox"></div></div><select class="d-none" id="objectCategorySource" tabindex="-1" aria-hidden="true"><option value="未分类" data-name="未分类"></option><% objectCategoriesValue.filter(item => item.name !== '未分类').forEach(item => { %><option value="<%= item.name %>" data-name="<%= item.name %>" data-count="<%= item.object_count %>"><%= item.name %></option><% }) %></select><div class="visually-hidden" id="objectCategorySearchStatus" role="status" aria-live="polite"></div></div><div class="col-12 col-md-2 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">筛选</button><a class="btn btn-outline-secondary" href="<%= resetUrl(viewValue) %>">重置</a></div></form></div></div>
<div class="card"><div class="card-header d-flex align-items-center"><h3 class="card-title"><%= viewValue === 'pending' ? '待整理对象' : '规范对象总览' %></h3><span class="badge text-bg-secondary ms-auto"><%= totalValue %> 个对象</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>规范对象</th><th>对象分类</th><th>适用机构</th><th>原始名称</th><th>检查方案</th><th>关联标准项</th><th class="text-end">操作</th></tr></thead><tbody><% centerObjectsValue.forEach(row => { %><tr><td><strong><%= row.canonical_name %></strong><% if (row.notes) { %><div class="small text-secondary"><%= row.notes %></div><% } %></td><td><% if (row.object_category) { %><span class="badge text-bg-light border"><%= row.object_category %></span><% } else { %><span class="badge text-bg-warning">未分类</span><% } %></td><td><% (row.centers || []).forEach(item => { %><span class="badge text-bg-light border me-1 mb-1"><%= item %></span><% }) %><% if (!(row.centers || []).length) { %><span class="text-secondary">未关联</span><% } %></td><td><% (row.aliases || []).slice(0, 4).forEach(alias => { %><span class="badge text-bg-light border me-1 mb-1"><%= alias %></span><% }) %><% if ((row.aliases || []).length > 4) { %><span class="small text-secondary">另有 <%= row.aliases.length - 4 %> 个</span><% } %></td><td><span class="badge text-bg-primary"><%= row.plan_count %> 个</span><div class="small object-plan-numbers"><% (row.plan_numbers || []).forEach(number => { const plan = (row.plans || []).find(item => Number(item.planNumber) === Number(number)); %><% if (plan) { %><button class="object-plan-number" type="button" data-plan="<%= encodeURIComponent(JSON.stringify(plan)) %>" onclick="showObjectPlanPreview(event, this)"><%= String(number).padStart(3, '0') %></button><% } else { %><span><%= String(number).padStart(3, '0') %></span><% } %><% }) %><% if (!(row.plan_numbers || []).length) { %>-<% } %></div></td><td><%= row.standard_item_count %> 项</td><td class="text-end text-nowrap"><% if (canWrite) { %><button class="btn btn-sm btn-outline-primary" type="button" data-object-id="<%= row.id %>" data-object-name="<%= row.canonical_name %>" data-category="<%= row.object_category || '' %>" data-categories="<%= encodeURIComponent(JSON.stringify(Array.from(new Set((row.plans || []).map(plan => plan.objectCategory).filter(Boolean))))) %>" data-notes="<%= row.notes || '' %>" onclick="editObject(this)">整理</button><button class="btn btn-sm btn-outline-danger" type="button" data-object-id="<%= row.id %>" data-object-name="<%= row.canonical_name %>" data-plan-count="<%= row.plan_count %>" onclick="openMergeObject(this)">合并到</button><% } %><a class="btn btn-sm btn-outline-primary" href="/joint-reviews?objectId=<%= encodeURIComponent(row.id) %>">联合复核</a><a class="btn btn-sm btn-outline-secondary" href="/supervision-definitions?search=<%= encodeURIComponent(row.canonical_name) %>">查看方案</a></td></tr><% }) %><% if (!centerObjectsValue.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">没有找到匹配的对象。</td></tr><% } %></tbody></table></div>
<% if (pageCountValue > 1) { %><div class="card-footer d-flex flex-wrap align-items-center gap-2"><span class="small text-secondary">第 <%= pageValue %> / <%= pageCountValue %> 页</span><nav class="ms-auto"><ul class="pagination pagination-sm mb-0"><li class="page-item <%= pageValue <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= pageValue <= 1 ? '#' : buildUrl(viewValue, pageValue - 1) %>">上一页</a></li><% for (let number = 1; number <= pageCountValue; number += 1) { %><li class="page-item <%= number === pageValue ? 'active' : '' %>"><a class="page-link" href="<%= buildUrl(viewValue, number) %>"><%= number %></a></li><% } %><li class="page-item <%= pageValue >= pageCountValue ? 'disabled' : '' %>"><a class="page-link" href="<%= pageValue >= pageCountValue ? '#' : buildUrl(viewValue, pageValue + 1) %>">下一页</a></li></ul></nav></div><% } %></div>
<div id="objectPlanPopover" popover="manual" aria-labelledby="objectPlanPopoverTitle">
  <div class="object-plan-popover-head"><strong id="objectPlanPopoverTitle">检查方案</strong><button class="btn-close btn-close-sm ms-auto" type="button" aria-label="关闭" onclick="document.getElementById('objectPlanPopover').hidePopover()"></button></div>
  <div class="object-plan-popover-body" id="objectPlanPopoverBody"></div>
</div>
<script>
  function showObjectPlanPreview(event, trigger) {
    const popover = document.getElementById('objectPlanPopover');
    const body = document.getElementById('objectPlanPopoverBody');
    let plan;
    try {
      plan = JSON.parse(decodeURIComponent(trigger.dataset.plan || ''));
    } catch {
      return;
    }
    const rows = [
      [ '检查对象', plan.objectName ],
      [ '对象分类', plan.objectCategory ],
      [ '适用机构', (plan.centers || []).join('、') ],
      [ '检查层面', plan.checkLayer ],
      [ '检查方法', plan.checkMethod ],
      [ '检查描述', plan.description ],
      [ '检查步骤', plan.steps ],
      [ '频率 / 方式', [ plan.frequency, plan.accessMode ].filter(Boolean).join(' / ') ],
    ];
    document.getElementById('objectPlanPopoverTitle').textContent = '检查方案 ' + String(plan.planNumber || '').padStart(3, '0');
    const fragment = document.createDocumentFragment();
    for (const [ label, value ] of rows) {
      const row = document.createElement('div');
      row.className = 'object-plan-popover-row';
      const caption = document.createElement('div');
      caption.className = 'small text-secondary';
      caption.textContent = label;
      const content = document.createElement('div');
      content.className = 'text-break';
      content.textContent = value || '-';
      row.append(caption, content);
      fragment.appendChild(row);
    }
    body.replaceChildren(fragment);
    if (!popover.matches(':popover-open')) popover.showPopover();
    const triggerRect = trigger.getBoundingClientRect();
    const popoverRect = popover.getBoundingClientRect();
    const viewportGap = 8;
    const horizontalGap = 6;
    let left = triggerRect.left;
    if (left + popoverRect.width > window.innerWidth - viewportGap) {
      left = window.innerWidth - popoverRect.width - viewportGap;
    }
    left = Math.max(viewportGap, left);
    let top = triggerRect.bottom + horizontalGap;
    if (top + popoverRect.height > window.innerHeight - viewportGap) {
      top = Math.max(viewportGap, triggerRect.top - popoverRect.height - horizontalGap);
    }
    popover.style.left = left + 'px';
    popover.style.top = top + 'px';
    event.stopPropagation();
  }
  const objectPopover = document.getElementById('objectPlanPopover');
  document.addEventListener('mouseover', event => {
    const trigger = event.target.closest('.object-plan-number');
    if (trigger) showObjectPlanPreview(event, trigger);
  });
  document.addEventListener('focusin', event => {
    const trigger = event.target.closest('.object-plan-number');
    if (trigger) showObjectPlanPreview(event, trigger);
  });
  document.addEventListener('pointerdown', event => {
    if (objectPopover?.matches(':popover-open')
      && !event.target.closest('.object-plan-number')
      && !event.target.closest('#objectPlanPopover')) {
      objectPopover.hidePopover();
    }
  }, true);
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && objectPopover?.matches(':popover-open')) objectPopover.hidePopover();
  });
  (() => {
    const root = document.getElementById('objectCategoryCombobox');
    const input = document.getElementById('objectCategory');
    const toggle = document.getElementById('objectCategoryToggle');
    const menu = document.getElementById('objectCategoryMenu');
    const source = document.getElementById('objectCategorySource');
    const status = document.getElementById('objectCategorySearchStatus');
    const form = input?.closest('form');
    if (!root || !input || !toggle || !menu || !source || !form) return;
    const options = Array.from(source.options)
      .filter(option => option.value)
      .map(option => ({
        name: option.getAttribute('data-name') || option.textContent.trim(),
        count: option.getAttribute('data-count') || '',
        search: option.textContent.trim(),
      }));
    let visible = [];
    let activeIndex = -1;
    let open = false;
    const normalize = value => String(value || '').normalize('NFKC').toLowerCase().replace(/\s+/g, '');
    const close = () => {
      open = false;
      activeIndex = -1;
      menu.classList.add('d-none');
      input.setAttribute('aria-expanded', 'false');
    };
    const show = () => {
      open = true;
      menu.classList.remove('d-none');
      input.setAttribute('aria-expanded', 'true');
    };
    const paint = (items, message) => {
      visible = items;
      activeIndex = items.length ? 0 : -1;
      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'object-category-combobox-empty';
        empty.textContent = message;
        menu.replaceChildren(empty);
        return;
      }
      menu.replaceChildren(...items.map((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'object-category-combobox-option' + (index === activeIndex ? ' is-active' : '');
        button.setAttribute('role', 'option');
        button.dataset.index = String(index);
        const label = document.createElement('span');
        label.textContent = item.name;
        button.appendChild(label);
        if (item.count) {
          const subtitle = document.createElement('span');
          subtitle.className = 'option-subtitle';
          subtitle.textContent = `${item.count} 个规范对象`;
          button.appendChild(subtitle);
        }
        return button;
      }));
    };
    const updateActive = next => {
      if (!visible.length) return;
      activeIndex = (next + visible.length) % visible.length;
      menu.querySelectorAll('.object-category-combobox-option').forEach((option, index) => {
        option.classList.toggle('is-active', index === activeIndex);
        if (index === activeIndex) option.scrollIntoView({ block: 'nearest' });
      });
    };
    const select = item => {
      if (!item) return;
      input.value = item.name;
      status.textContent = `已选择：${item.name}`;
      close();
    };
    const renderMatches = () => {
      const keyword = normalize(input.value);
      if (!keyword) {
        paint(options, '暂无可选分类');
        status.textContent = `共 ${options.length} 个分类，可直接选择或输入名称筛选。`;
        show();
        return;
      }
      const matches = options.filter(item => normalize(item.search).includes(keyword));
      paint(matches, '没有匹配的分类');
      status.textContent = `匹配 ${matches.length} 个分类。`;
      show();
    };
    const matchingValue = () => options.find(item => normalize(item.name) === normalize(input.value));
    input.addEventListener('focus', renderMatches);
    input.addEventListener('input', renderMatches);
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!open) renderMatches();
        updateActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!open) renderMatches();
        updateActive(activeIndex - 1);
      } else if (event.key === 'Enter' && open && visible[activeIndex]) {
        event.preventDefault();
        select(visible[activeIndex]);
      } else if (event.key === 'Escape') {
        close();
      }
    });
    toggle.addEventListener('click', () => {
      input.focus();
      if (open) close();
      else renderMatches();
    });
    menu.addEventListener('mousedown', event => event.preventDefault());
    menu.addEventListener('click', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (!option) return;
      select(visible[Number(option.dataset.index)]);
    });
    menu.addEventListener('mouseover', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) updateActive(Number(option.dataset.index));
    });
    document.addEventListener('click', event => {
      if (!root.contains(event.target)) close();
    });
    form.addEventListener('submit', event => {
      if (!input.value.trim()) return;
      const selected = matchingValue();
      if (selected) {
        input.value = selected.name;
        return;
      }
      event.preventDefault();
      input.focus();
      renderMatches();
      window.showAppNotice('请从分类候选中选择一个对象分类，或清空分类筛选。', '对象分类未选择');
    });
    if (input.value.trim() && matchingValue()) status.textContent = `已选择：${input.value.trim()}`;
    else status.textContent = `共 ${options.length} 个分类，可直接选择或输入名称筛选。`;
  })();
</script>
<% } %>

<% if (canWrite && viewValue === 'categories') { %><script>
  async function deleteObjectCategory(button) {
    if (!await window.confirmAppAction(`确认删除对象分类“${button.dataset.categoryName}”吗？该分类当前没有规范对象使用。`, '删除对象分类')) return;
    const response = await fetch('/api/supervision-center-objects/categories/' + button.dataset.categoryId + '/delete', {
      method: 'POST', headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>' }, body: '{}'
    });
    const data = await response.json();
    if (!response.ok) { window.showAppNotice(data.message || '删除失败', '删除分类失败'); return; }
    window.location.reload();
  }
  document.getElementById('categoryForm')?.addEventListener('submit', async event => {
    event.preventDefault(); const form = event.currentTarget;
    const response = await fetch(form.action, { method: 'POST', headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>' }, body: JSON.stringify({ name: form.name.value, description: form.description.value }) });
    const data = await response.json(); if (!response.ok) { window.showAppNotice(data.message || '保存失败', '分类维护失败'); return; } window.location.reload();
  });
</script><% } %>

<% if (canWrite && viewValue !== 'categories') { %><div class="modal fade" id="objectMergeModal" tabindex="-1" aria-labelledby="objectMergeTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="objectMergeForm"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="modal-header"><h2 class="modal-title fs-5" id="objectMergeTitle">合并规范对象</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="alert alert-warning py-2" id="objectMergeSummary"></div><label class="form-label" for="mergeTargetObject">合并到</label><div class="object-category-combobox" id="mergeTargetCombobox"><input class="form-control object-category-combobox-input" id="mergeTargetObject" type="search" autocomplete="off" placeholder="搜索要保留的规范对象" role="combobox" aria-expanded="false" aria-controls="mergeTargetObjectMenu" aria-autocomplete="list"><button class="object-category-combobox-toggle" id="mergeTargetObjectToggle" type="button" aria-label="展开保留对象候选">&#9662;</button><div class="object-category-combobox-menu d-none" id="mergeTargetObjectMenu" role="listbox"></div></div><input type="hidden" id="mergeTargetObjectId"><div class="small text-secondary mt-1" id="mergeTargetHint">来源对象的检查方案会迁移到保留对象，来源对象将标记为已合并。</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-danger" type="submit">确认合并</button></div></form></div></div></div><script>
  const mergeObjectCatalog = <%- JSON.stringify((typeof objectOptions === 'undefined' ? [] : objectOptions).map(item => ({ id: item.id, name: item.canonical_name || item.name || '', category: item.object_category || item.category || '' }))).replace(/</g, '\\u003c') %>;
  const mergeObjectPicker = (() => {
    const root = document.getElementById('mergeTargetCombobox');
    const input = document.getElementById('mergeTargetObject');
    const hidden = document.getElementById('mergeTargetObjectId');
    const toggle = document.getElementById('mergeTargetObjectToggle');
    const menu = document.getElementById('mergeTargetObjectMenu');
    let visible = [];
    let activeIndex = -1;
    let open = false;
    let sourceId = '';
    const normalize = value => String(value || '').normalize('NFKC').trim().toLowerCase();
    const close = () => {
      open = false;
      activeIndex = -1;
      menu.classList.add('d-none');
      input.setAttribute('aria-expanded', 'false');
    };
    const show = () => {
      open = true;
      menu.classList.remove('d-none');
      input.setAttribute('aria-expanded', 'true');
    };
    const paint = items => {
      visible = items;
      activeIndex = items.length ? 0 : -1;
      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'object-category-combobox-empty';
        empty.textContent = '没有匹配的规范对象';
        menu.replaceChildren(empty);
        return;
      }
      menu.replaceChildren(...items.map((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'object-category-combobox-option' + (index === activeIndex ? ' is-active' : '');
        button.setAttribute('role', 'option');
        button.dataset.index = String(index);
        const label = document.createElement('span');
        label.textContent = item.name;
        const subtitle = document.createElement('span');
        subtitle.className = 'option-subtitle';
        subtitle.textContent = item.category || '未分类';
        button.append(label, subtitle);
        return button;
      }));
    };
    const updateActive = next => {
      if (!visible.length) return;
      activeIndex = (next + visible.length) % visible.length;
      menu.querySelectorAll('.object-category-combobox-option').forEach((item, index) => item.classList.toggle('is-active', index === activeIndex));
    };
    const select = item => {
      if (!item) return;
      input.value = item.name;
      hidden.value = item.id;
      close();
    };
    const render = () => {
      const keyword = normalize(input.value);
      paint(mergeObjectCatalog
        .filter(item => item.id !== sourceId)
        .filter(item => !keyword || normalize(item.name).includes(keyword) || normalize(item.category).includes(keyword)));
      show();
    };
    input.addEventListener('focus', render);
    input.addEventListener('input', () => {
      hidden.value = '';
      render();
    });
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!open) render();
        updateActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!open) render();
        updateActive(activeIndex - 1);
      } else if (event.key === 'Enter' && open && visible[activeIndex]) {
        event.preventDefault();
        select(visible[activeIndex]);
      } else if (event.key === 'Escape') {
        close();
      }
    });
    toggle.addEventListener('click', () => {
      input.focus();
      if (open) close();
      else render();
    });
    menu.addEventListener('mousedown', event => event.preventDefault());
    menu.addEventListener('click', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) select(visible[Number(option.dataset.index)]);
    });
    menu.addEventListener('mouseover', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) updateActive(Number(option.dataset.index));
    });
    document.addEventListener('pointerdown', event => {
      if (!root.contains(event.target)) close();
    }, true);
    return {
      reset(id) {
        sourceId = id;
        input.value = '';
        hidden.value = '';
        close();
      },
      value: () => hidden.value,
    };
  })();
  function openMergeObject(button) {
    const form = document.getElementById('objectMergeForm');
    form.action = '/api/supervision-center-objects/objects/' + button.dataset.objectId + '/merge';
    form.dataset.sourceName = button.dataset.objectName || '';
    form.dataset.planCount = button.dataset.planCount || '0';
    mergeObjectPicker.reset(button.dataset.objectId);
    document.getElementById('objectMergeSummary').textContent = `来源对象“${button.dataset.objectName}”当前关联 ${button.dataset.planCount || '0'} 个检查方案。请选择要保留的对象。`;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('objectMergeModal')).show();
  }
  document.getElementById('objectMergeForm').addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const targetId = mergeObjectPicker.value();
    if (!targetId) return window.showAppNotice('请从候选对象中选择要保留的规范对象。', '合并未完成');
    const targetName = document.getElementById('mergeTargetObject').value.trim();
    const confirmed = await window.confirmAppAction(
      `确认将“${form.dataset.sourceName}”的 ${form.dataset.planCount} 个检查方案合并到“${targetName}”？来源对象会标记为已合并。`,
      '确认合并规范对象'
    );
    if (!confirmed) return;
    const response = await fetch(form.action, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>' },
      body: JSON.stringify({ targetId }),
    });
    const data = await response.json();
    if (!response.ok) return window.showAppNotice(data.message || '合并失败', '对象合并失败');
    window.location.reload();
  });
</script><% } %>
<% if (canWrite && viewValue !== 'categories') { %><div class="modal fade" id="objectEditModal" tabindex="-1" aria-labelledby="objectEditTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" id="objectEditForm"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="modal-header"><h2 class="modal-title fs-5" id="objectEditTitle">整理规范对象</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label" for="editCanonicalName">规范对象名称</label><input class="form-control" id="editCanonicalName" name="canonicalName" maxlength="500" required></div><div class="mb-3"><label class="form-label" for="editObjectCategory">对象分类</label><div class="object-category-combobox" id="editObjectCategoryCombobox"><input class="form-control object-category-combobox-input" id="editObjectCategory" type="search" autocomplete="off" placeholder="输入分类名称搜索，或从历史分类选择" role="combobox" aria-expanded="false" aria-controls="editObjectCategoryMenu" aria-autocomplete="list"><button class="object-category-combobox-toggle" id="editObjectCategoryToggle" type="button" aria-label="展开对象分类候选">&#9662;</button><div class="object-category-combobox-menu d-none" id="editObjectCategoryMenu" role="listbox"></div></div><input type="hidden" id="editCategoryId" name="categoryId"><div class="visually-hidden" id="editObjectCategoryStatus" role="status" aria-live="polite"></div><div class="small text-secondary mt-1" id="editCategoryHint">优先显示当前对象在检查方案中使用过的分类。</div></div><div><label class="form-label" for="editObjectNotes">整理备注</label><textarea class="form-control" id="editObjectNotes" name="notes" rows="3"></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存</button></div></form></div></div></div><script>
  const objectEditCategories = <%- JSON.stringify(objectCategoriesValue.map(item => ({ id: item.id, name: item.name, count: Number(item.object_count) || 0 }))).replace(/</g, '\\u003c') %>;
  const objectEditPicker = (() => {
    const root = document.getElementById('editObjectCategoryCombobox');
    const input = document.getElementById('editObjectCategory');
    const hidden = document.getElementById('editCategoryId');
    const toggle = document.getElementById('editObjectCategoryToggle');
    const menu = document.getElementById('editObjectCategoryMenu');
    const status = document.getElementById('editObjectCategoryStatus');
    const hint = document.getElementById('editCategoryHint');
    let historical = [];
    let visible = [];
    let activeIndex = -1;
    let open = false;
    const normalize = value => String(value || '').normalize('NFKC').trim().toLowerCase();
    const close = () => {
      open = false;
      activeIndex = -1;
      menu.classList.add('d-none');
      input.setAttribute('aria-expanded', 'false');
    };
    const show = () => {
      open = true;
      menu.classList.remove('d-none');
      input.setAttribute('aria-expanded', 'true');
    };
    const categoryFor = item => objectEditCategories.find(category => normalize(category.name) === normalize(item.name));
    const options = () => {
      const historyOptions = historical.map(name => {
        const category = categoryFor({ name });
        return {
          id: category?.id || '',
          name,
          count: category?.count || 0,
          historical: true,
          known: Boolean(category),
        };
      });
      const knownHistory = new Set(historyOptions.filter(item => item.known).map(item => normalize(item.name)));
      const remaining = objectEditCategories
        .filter(category => !knownHistory.has(normalize(category.name)))
        .map(category => ({ ...category, historical: false, known: true }));
      return [ ...historyOptions, ...remaining ];
    };
    const paint = (items, message) => {
      visible = items;
      activeIndex = items.length ? 0 : -1;
      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'object-category-combobox-empty';
        empty.textContent = message;
        menu.replaceChildren(empty);
        return;
      }
      menu.replaceChildren(...items.map((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'object-category-combobox-option' + (index === activeIndex ? ' is-active' : '');
        button.setAttribute('role', 'option');
        button.dataset.index = String(index);
        const label = document.createElement('span');
        label.textContent = item.name;
        button.appendChild(label);
        const subtitle = document.createElement('span');
        subtitle.className = 'option-subtitle';
        subtitle.textContent = item.historical
          ? (item.known ? '原方案使用过 · 现有分类' : '原方案使用过 · 保存时采用为此分类')
          : `${item.count} 个规范对象`;
        button.appendChild(subtitle);
        return button;
      }));
    };
    const updateActive = next => {
      if (!visible.length) return;
      activeIndex = (next + visible.length) % visible.length;
      menu.querySelectorAll('.object-category-combobox-option').forEach((option, index) => {
        option.classList.toggle('is-active', index === activeIndex);
        if (index === activeIndex) option.scrollIntoView({ block: 'nearest' });
      });
    };
    const select = item => {
      if (!item) return;
      input.value = item.name;
      hidden.value = item.id || '';
      status.textContent = item.known ? `已选择：${item.name}` : `将采用历史分类：${item.name}`;
      hint.textContent = item.known
        ? '保存后会同步更新该对象下的检查方案分类。'
        : '该历史分类尚未登记，保存时会自动加入分类主数据。';
      close();
    };
    const renderMatches = () => {
      const keyword = normalize(input.value);
      const all = options();
      const matches = keyword
        ? all.filter(item => normalize(item.name).includes(keyword))
        : all;
      paint(matches, '没有匹配的分类');
      show();
    };
    const findExact = value => options().find(item => normalize(item.name) === normalize(value));
    const setValue = value => {
      const exact = findExact(value);
      input.value = value || '';
      hidden.value = exact?.id || '';
      hint.textContent = value
        ? '优先显示当前对象在检查方案中使用过的分类。'
        : '留空表示未分类。';
    };
    input.addEventListener('focus', renderMatches);
    input.addEventListener('input', () => {
      hidden.value = '';
      renderMatches();
    });
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!open) renderMatches();
        updateActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!open) renderMatches();
        updateActive(activeIndex - 1);
      } else if (event.key === 'Enter' && open && visible[activeIndex]) {
        event.preventDefault();
        select(visible[activeIndex]);
      } else if (event.key === 'Escape') {
        close();
      }
    });
    toggle.addEventListener('click', () => {
      input.focus();
      if (open) close();
      else renderMatches();
    });
    menu.addEventListener('mousedown', event => event.preventDefault());
    menu.addEventListener('click', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) select(visible[Number(option.dataset.index)]);
    });
    menu.addEventListener('mouseover', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) updateActive(Number(option.dataset.index));
    });
    document.addEventListener('pointerdown', event => {
      if (!root.contains(event.target)) close();
    }, true);
    return {
      setHistorical(items) {
        historical = Array.from(new Set((items || []).filter(Boolean)));
      },
      setValue,
      close,
      exactValue: () => input.value.trim() ? findExact(input.value) : null,
      rawValue: () => input.value.trim(),
    };
  })();
  function editObject(button) {
    document.getElementById('objectEditForm').action = '/api/supervision-center-objects/objects/' + button.dataset.objectId;
    document.getElementById('editCanonicalName').value = button.dataset.objectName || '';
    document.getElementById('editObjectNotes').value = button.dataset.notes || '';
    let history = [];
    try {
      history = JSON.parse(decodeURIComponent(button.dataset.categories || ''));
    } catch {}
    objectEditPicker.setHistorical(history);
    objectEditPicker.setValue(button.dataset.category || '');
    bootstrap.Modal.getOrCreateInstance(document.getElementById('objectEditModal')).show();
  }
  document.getElementById('objectEditForm').addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const categoryName = objectEditPicker.rawValue();
    const exact = objectEditPicker.exactValue();
    if (categoryName && !exact) {
      const confirmed = await window.confirmAppAction(`分类“${categoryName}”尚未在分类主数据中，保存后会创建该分类并应用到当前对象。`, '采用历史分类');
      if (!confirmed) return;
    }
    const response = await fetch(form.action, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>' },
      body: JSON.stringify({
        canonicalName: form.canonicalName.value,
        categoryId: exact?.id || form.categoryId.value,
        categoryName: exact ? '' : categoryName,
        notes: form.notes.value,
      }),
    });
    const data = await response.json();
    if (!response.ok) { window.showAppNotice(data.message || '保存失败', '对象整理失败'); return; }
    window.location.reload();
  });
</script><% } %>
