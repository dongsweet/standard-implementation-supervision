      const centerMatches = !center || optionCenters.includes(center);
      const layerMatches = !layer || option.dataset.layer === layer;
      const hidden = !centerMatches || !layerMatches;
      option.classList.toggle('d-none', hidden);
      if (!hidden) visible += 1;
    }
    if (center || layer) {
      document.querySelectorAll('.object-split-group details').forEach(details => { details.open = true; });
    }
    document.getElementById('splitFilterCount').textContent = `当前显示 ${visible} / ${options.length} 个方案`;
  }
  function normalizedTargetName(value) {
    return String(value || '').normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '');
  }
  function splitTargetConflict(name) {
    const normalized = normalizedTargetName(name);
    if (!normalized) return null;
    const sourceId = splitObjectState?.object?.id;
    return splitTargetCatalog.find(object =>
      object.id !== sourceId && object.names.some(item => normalizedTargetName(item) === normalized)
    ) || null;
  }
  function readSplitDraft() {
    return Array.from(document.querySelectorAll('.object-split-group'))
      .map(group => ({
        name: group.querySelector('.split-group-name').value.trim(),
        category: group.querySelector('.split-group-category').value.trim(),
        planIds: [...group.querySelectorAll('.split-plan-check:checked')].map(input => input.value),
      }))
      .filter(group => group.planIds.length);
  }
  function refreshSplitDraft() {
    const groups = readSplitDraft();
    const errorBox = document.getElementById('objectSplitErrors');
    const errors = [];
    const names = new Set();
    const plans = new Set();
    for (const group of groups) {
      if (!group.name) errors.push('每个有检查方案的拆分目标都需要填写新对象名称。');
      if (!group.category) errors.push('每个有检查方案的拆分目标都需要填写对象分类。');
      if (names.has(group.name)) errors.push(`新对象名称重复：${group.name}`);
      names.add(group.name);
      if (group.name && splitTargetConflict(group.name)) {
        errors.push(`拆分目标“${group.name}”已存在，不能重复创建；请选择现有对象进行合并，或填写新的对象名称。`);
      }
      for (const planId of group.planIds) {
        if (plans.has(planId)) errors.push('同一个检查方案不能出现在多个拆分目标。');
        plans.add(planId);
      }
    }
    if (!groups.length) errors.push('至少需要选择一个要拆出的检查方案。');
    const remain = splitObjectState ? splitObjectState.plans.length - plans.size : 0;
    document.getElementById('objectSplitCounts').textContent = splitObjectState
      ? `拆出 ${plans.size} 个 · 保留在来源对象 ${remain} 个`
      : '待计算';
    document.querySelectorAll('.object-split-group').forEach(group => {
      const allPlans = group.querySelectorAll('.split-plan-check');
      const checkedPlans = group.querySelectorAll('.split-plan-check:checked');
      group.querySelector('.split-group-count').textContent = `${checkedPlans.length} 个`;
      const badge = group.querySelector('.split-group-badge');
      if (badge) {
        badge.textContent = badge.textContent.replace(/已选 \d+ \/ \d+$/, `已选 ${checkedPlans.length} / ${allPlans.length}`);
      }
    });
    errorBox.textContent = errors.join('；');
    errorBox.classList.toggle('d-none', !errors.length);
    document.getElementById('saveSplitDraft').disabled = errors.length > 0;
  }
  document.getElementById('objectSplitModal').addEventListener('input', refreshSplitDraft);
  document.getElementById('objectSplitModal').addEventListener('change', refreshSplitDraft);
  document.getElementById('splitFilterCenter').addEventListener('change', applySplitFilters);
  document.getElementById('splitFilterLayer').addEventListener('change', applySplitFilters);
  document.getElementById('splitFilterSelectAll').addEventListener('click', () => {
    document.querySelectorAll('.split-plan-option:not(.d-none) .split-plan-check').forEach(input => { input.checked = true; });
    refreshSplitDraft();
  });
  document.getElementById('splitFilterSelectNone').addEventListener('click', () => {
    document.querySelectorAll('.split-plan-option:not(.d-none) .split-plan-check').forEach(input => { input.checked = false; });
    refreshSplitDraft();
  });
  document.getElementById('objectSplitGroups').addEventListener('click', event => {
    const allButton = event.target.closest('.split-group-all');
    const noneButton = event.target.closest('.split-group-none');
    if (!allButton && !noneButton) return;
    const group = event.target.closest('.object-split-group');
    group.querySelectorAll('.split-plan-check').forEach(input => {
      input.checked = Boolean(allButton);
    });
    refreshSplitDraft();
  });
  document.getElementById('saveSplitDraft').addEventListener('click', async event => {
    const button = event.currentTarget;
    const groups = readSplitDraft();
    if (!splitObjectState?.object?.id || !groups.length) return;
    const confirmed = await window.confirmAppAction(
      '保存后只会生成拆分草案，不会修改对象和检查方案。是否继续？',
      '保存拆分草案'
    );
    if (!confirmed) return;
    button.disabled = true;
    try {
      const response = await fetch('/api/supervision-center-objects/objects/' + encodeURIComponent(splitObjectState.object.id) + '/split-drafts', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>' },
        body: JSON.stringify({ groups }),
      });
      const contentType = response.headers.get('content-type') || '';
      let payload = {};
      if (contentType.includes('application/json')) {
        payload = await response.json();
      } else {
        await response.text();
        payload.message = `请求失败（HTTP ${response.status}），请刷新页面后重试`;
      }
      if (!response.ok) throw new Error(payload.message || '拆分草案保存失败');
      window.location.assign('/supervision-center-objects/split-drafts/' + encodeURIComponent(payload.data.id));
    } catch (error) {
      button.disabled = false;
      window.showAppNotice(error.message, '拆分草案未保存');
    }
  });
</script><% } %>
<% if (canWrite && viewValue !== 'categories') { %><div class="modal fade" id="objectMergeModal" tabindex="-1" aria-labelledby="objectMergeTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="objectMergeForm"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="modal-header"><h2 class="modal-title fs-5" id="objectMergeTitle">合并规范对象</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="alert alert-warning py-2" id="objectMergeSummary"></div><label class="form-label" for="mergeTargetObject">合并到</label><div class="object-category-combobox" id="mergeTargetCombobox"><input class="form-control object-category-combobox-input" id="mergeTargetObject" type="search" autocomplete="off" placeholder="搜索要保留的规范对象" role="combobox" aria-expanded="false" aria-controls="mergeTargetObjectMenu" aria-autocomplete="list"><button class="object-category-combobox-toggle" id="mergeTargetObjectToggle" type="button" aria-label="展开保留对象候选">&#9662;</button><div class="object-category-combobox-menu d-none" id="mergeTargetObjectMenu" role="listbox"></div></div><input type="hidden" id="mergeTargetObjectId"><div class="small text-secondary mt-1" id="mergeTargetHint">来源对象的检查方案会迁移到保留对象，来源对象将标记为已合并。</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-danger" type="submit">确认合并</button></div></form></div></div></div><script>
  const mergeObjectCatalog = <%- JSON.stringify((typeof objectOptions === 'undefined' ? [] : objectOptions).map(item => ({ id: item.id, name: item.canonical_name || item.name || '', category: item.object_category || item.category || '' }))).replace(/</g, '\\u003c') %>;
  const mergeObjectPicker = (() => {
    const root = document.getElementById('mergeTargetCombobox');
    const input = document.getElementById('mergeTargetObject');
    const hidden = document.getElementById('mergeTargetObjectId');
    const toggle = document.getElementById('mergeTargetObjectToggle');
    const menu = document.getElementById('mergeTargetObjectMenu');
    let visible = [];
    let activeIndex = -1;
    let open = false;
    let sourceId = '';
    const normalize = value => String(value || '').normalize('NFKC').trim().toLowerCase();
    const close = () => {
      open = false;
      activeIndex = -1;
      menu.classList.add('d-none');
      input.setAttribute('aria-expanded', 'false');
    };
    const show = () => {
      open = true;
      menu.classList.remove('d-none');
      input.setAttribute('aria-expanded', 'true');
    };
    const paint = items => {
      visible = items;
      activeIndex = items.length ? 0 : -1;
      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'object-category-combobox-empty';
        empty.textContent = '没有匹配的规范对象';
        menu.replaceChildren(empty);
        return;
      }
      menu.replaceChildren(...items.map((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'object-category-combobox-option' + (index === activeIndex ? ' is-active' : '');
        button.setAttribute('role', 'option');
        button.dataset.index = String(index);
        const label = document.createElement('span');
        label.textContent = item.name;
        const subtitle = document.createElement('span');
        subtitle.className = 'option-subtitle';
        subtitle.textContent = item.category || '未分类';
        button.append(label, subtitle);
        return button;
      }));
    };
    const updateActive = next => {
      if (!visible.length) return;
      activeIndex = (next + visible.length) % visible.length;
      menu.querySelectorAll('.object-category-combobox-option').forEach((item, index) => item.classList.toggle('is-active', index === activeIndex));
    };
    const select = item => {
      if (!item) return;
      input.value = item.name;
      hidden.value = item.id;
      close();
    };
    const render = () => {
      const keyword = normalize(input.value);
      paint(mergeObjectCatalog
        .filter(item => item.id !== sourceId)
        .filter(item => !keyword || normalize(item.name).includes(keyword) || normalize(item.category).includes(keyword)));
      show();
    };
    input.addEventListener('focus', render);
    input.addEventListener('input', () => {
      hidden.value = '';
      render();
    });
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!open) render();
        updateActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!open) render();
        updateActive(activeIndex - 1);
      } else if (event.key === 'Enter' && open && visible[activeIndex]) {
        event.preventDefault();
        select(visible[activeIndex]);
      } else if (event.key === 'Escape') {
        close();
      }
    });
    toggle.addEventListener('click', () => {
      input.focus();
      if (open) close();
      else render();
    });
    menu.addEventListener('mousedown', event => event.preventDefault());
    menu.addEventListener('click', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) select(visible[Number(option.dataset.index)]);
    });
    menu.addEventListener('mouseover', event => {
      const option = event.target.closest('.object-category-combobox-option');
      if (option) updateActive(Number(option.dataset.index));
    });
    document.addEventListener('pointerdown', event => {
      if (!root.contains(event.target)) close();
    }, true);
    return {
      reset(id) {
        sourceId = id;
        input.value = '';
        hidden.value = '';
        close();
      },
      value: () => hidden.value,
    };
  })();
  function openMergeObject(button) {
    const form = document.getElementById('objectMergeForm');
    form.action = '/api/supervision-center-objects/objects/' + button.dataset.objectId + '/merge';
    form.dataset.sourceName = button.dataset.objectName || '';
    form.dataset.planCount = button.dataset.planCount || '0';
    mergeObjectPicker.reset(button.dataset.objectId);
