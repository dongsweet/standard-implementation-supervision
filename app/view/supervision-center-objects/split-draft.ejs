<%
  const groups = Array.isArray(draft.groups) ? draft.groups : [];
  const snapshotPlans = groups.flatMap(group => group.plans || []);
  const planById = new Map([ ...(preview.plans || []), ...snapshotPlans ].map(plan => [ plan.id, plan ]));
  const sourcePlanCount = (preview.plans || []).length;
  const assignedPlanCount = groups.reduce((count, group) => count + (group.planIds || []).length, 0);
  const submitted = draft.status === 'submitted';
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div>
    <h2 class="h4 mb-1"><%= submitted ? '拆分结果' : '核对拆分草案' %></h2>
    <p class="text-secondary mb-0"><%= submitted ? '该草案已经提交，检查方案和规范对象已按下列分组更新。' : '请核对目标名称、分类和方案归属。提交后才会真正拆分对象并迁移检查方案。' %></p>
  </div>
  <a class="btn btn-outline-secondary ms-auto" href="/supervision-center-objects/split-drafts">返回拆分草案</a>
</div>

<div class="card mb-3">
  <div class="card-body">
    <div class="row g-3 align-items-end">
      <div class="col-12 col-md-4"><div class="small text-secondary">来源规范对象</div><div class="fs-5 fw-semibold"><%= draft.source_object_name %></div></div>
      <div class="col-6 col-md-2"><div class="small text-secondary">来源分类</div><div><%= draft.source_category || '未分类' %></div></div>
      <div class="col-6 col-md-2"><div class="small text-secondary">检查方案</div><div><%= sourcePlanCount %> 个</div></div>
      <div class="col-6 col-md-2"><div class="small text-secondary">拆分目标</div><div><%= groups.length %> 个对象</div></div>
      <div class="col-6 col-md-2"><div class="small text-secondary">状态</div><span class="badge <%= submitted ? 'text-bg-success' : 'text-bg-warning' %>"><%= submitted ? '已提交' : '待提交' %></span></div>
    </div>
    <% if (assignedPlanCount !== sourcePlanCount) { %><div class="alert alert-danger mt-3 mb-0">方案归属不完整：来源有 <%= sourcePlanCount %> 个方案，草案仅分配 <%= assignedPlanCount %> 个。该草案不能提交。</div><% } %>
  </div>
</div>

<div class="row g-3">
  <% groups.forEach((group, index) => { %>
    <div class="col-12 col-xl-6">
      <section class="card h-100">
        <div class="card-header d-flex align-items-center gap-2"><h3 class="card-title">目标 <%= index + 1 %></h3><span class="badge text-bg-primary ms-auto"><%= (group.planIds || []).length %> 个方案</span></div>
        <div class="card-body">
          <div class="row g-2 mb-3">
            <div class="col-md-7"><div class="small text-secondary">新规范对象</div><div class="fs-5 fw-semibold"><%= group.name %></div></div>
            <div class="col-md-5"><div class="small text-secondary">对象分类</div><div><span class="badge text-bg-light border"><%= group.category %></span></div></div>
          </div>
          <div class="list-group list-group-flush">
            <% (group.planIds || []).forEach(planId => { const plan = planById.get(planId); %>
              <div class="list-group-item px-0">
                <div class="d-flex gap-2"><span class="badge text-bg-primary"><%= String(plan?.plan_number || '').padStart(3, '0') %></span><strong class="text-break"><%= plan?.description || '检查方案' %></strong></div>
                <div class="small text-secondary mt-1"><%= plan?.object_category || '未分类' %> · <%= plan?.check_layer || '-' %> · <%= plan?.check_method || '-' %></div>
                <div class="small text-secondary"><%= (plan?.centers || []).join('、') || '未指定机构' %></div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    </div>
  <% }) %>
</div>

<% if (!submitted && canWrite) { %>
<div class="card mt-3">
  <div class="card-body">
    <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="splitSubmitConfirmation"><label class="form-check-label" for="splitSubmitConfirmation">我已核对拆分目标、分类和全部检查方案归属，确认执行拆分。</label></div>
    <button class="btn btn-warning" type="button" id="submitSplitDraft" disabled>最终提交拆分</button>
  </div>
</div>
<script>
  const splitSubmitConfirmation = document.getElementById('splitSubmitConfirmation');
  const splitSubmitButton = document.getElementById('submitSplitDraft');
  splitSubmitConfirmation.addEventListener('change', () => {
    splitSubmitButton.disabled = !splitSubmitConfirmation.checked || <%= assignedPlanCount !== sourcePlanCount ? 'true' : 'false' %>;
  });
  splitSubmitButton.addEventListener('click', async () => {
    if (!await window.confirmAppAction('最终提交后将创建新的规范对象并把来源检查方案迁移过去。是否继续？', '确认提交对象拆分')) return;
    splitSubmitButton.disabled = true;
    try {
      const response = await fetch('/api/supervision-center-objects/split-drafts/<%= draft.id %>/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>' },
        body: '{}',
      });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.message || '拆分提交失败');
      window.location.reload();
    } catch (error) {
      splitSubmitButton.disabled = false;
      window.showAppNotice(error.message, '拆分提交失败');
    }
  });
</script>
<% } %>
