<%
  const thresholdValue = typeof queryThreshold === 'number' && Number.isFinite(queryThreshold) ? queryThreshold : 0.6;
  const hasResults = typeof scanned !== 'undefined' && scanned;
  const activeFilter = [ 'all', 'ai_duplicate', 'ai_excluded', 'ai_pending' ].includes(filter) ? filter : 'all';
  const filterLabels = {
    all: '规则候选',
    ai_duplicate: 'AI 判重',
    ai_excluded: 'AI 排除',
    ai_pending: '未做 AI',
  };
  const filterUrl = value => `/supervision-center-objects/dedupe?run=1&threshold=${encodeURIComponent(thresholdValue)}&filter=${value}`;
%>
<style>
  .object-filter-cards a.card { transition: border-color 120ms ease, box-shadow 120ms ease; }
  .object-filter-cards a.card:hover { border-color: var(--bs-primary); box-shadow: 0 .25rem .75rem rgba(13, 110, 253, .12); }
  .object-filter-cards a.card:focus-visible { outline: 2px solid var(--bs-primary); outline-offset: 2px; }
</style>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div>
    <h2 class="h4 mb-1">中心检查对象去重</h2>
    <p class="text-secondary mb-0">按名称相似度规则筛选后，可直接由人工判断是否重复。AI 语义复核为可选辅助，所有合并都必须人工确认。</p>
  </div>
  <div class="ms-auto d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/supervision-center-objects/dedupe/history">查看复核历史</a>
    <a class="btn btn-outline-secondary" href="/supervision-center-objects">返回中心检查对象</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <div class="row g-3 align-items-end">
      <div class="col-12 col-md-5">
        <label class="form-label" for="objectThreshold">规则预筛门限</label>
        <div class="input-group">
          <span class="input-group-text">名称相似度 ≥</span>
          <input class="form-control" id="objectThreshold" type="number" min="0" max="1" step="0.01" value="<%= thresholdValue %>">
        </div>
      </div>
      <div class="col-12 col-md-7 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" type="button" id="runRuleScreen" onclick="runRuleScreen(this)">运行规则筛选</button>
        <% if (hasResults && (summary.pendingCount || summary.failedCount)) { %><button class="btn btn-outline-primary" type="button" id="runObjectAiScreen" data-pending="<%= summary.pendingCount + summary.failedCount %>" onclick="runObjectAiScreen(this)"><%= summary.failedCount ? '重试可选 AI 语义复核' : '可选 AI 语义复核' %>（<%= summary.pendingCount + summary.failedCount %>）</button><% } %>
      </div>
    </div>
    <div class="form-text mt-2">门限可自行填写（0～1）。进入页面不会自动扫描；点击“运行规则筛选”后才查询候选。AI 不是合并前置条件，可以完全不运行。</div>
  </div>
</div>

<% if (!hasResults) { %>
<div class="card mb-3"><div class="card-body text-center text-secondary py-5">
  <div class="fs-5 mb-2">尚未运行规则筛选</div>
  <div>填写门限后点击“运行规则筛选”。页面不会自动查找候选，也不会自动调用 AI。</div>
</div></div>
<% } else { %>
<div class="row g-3 mb-3 object-filter-cards">
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'all' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('all') %>" <%= activeFilter === 'all' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">规则候选</div><% if (activeFilter === 'all') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold"><%= summary.candidateCount %></div><div class="small text-secondary">名称相似度 ≥ <%= thresholdValue %></div></div></a></div>
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'ai_duplicate' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('ai_duplicate') %>" <%= activeFilter === 'ai_duplicate' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">AI 判重</div><% if (activeFilter === 'ai_duplicate') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold text-danger"><%= summary.aiDuplicateCount %></div><div class="small text-secondary">可选复核结果</div></div></a></div>
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'ai_excluded' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('ai_excluded') %>" <%= activeFilter === 'ai_excluded' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">AI 排除</div><% if (activeFilter === 'ai_excluded') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold text-success"><%= summary.excludedCount %></div><div class="small text-secondary">相似但不同或无关</div></div></a></div>
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'ai_pending' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('ai_pending') %>" <%= activeFilter === 'ai_pending' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">未做 AI</div><% if (activeFilter === 'ai_pending') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold text-warning"><%= summary.pendingCount + summary.failedCount %></div><div class="small text-secondary">不影响人工判断</div></div></a></div>
</div>

<section class="card mb-3">
  <div class="card-header d-flex align-items-center gap-2"><h3 class="card-title">规则筛选结果</h3><span class="badge text-bg-primary">当前：<%= filterLabels[activeFilter] %></span><span class="badge text-bg-secondary ms-auto"><%= candidates.length %> 组</span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th style="width:7rem">检查中心</th><th>对象 A</th><th>对象 B</th><th style="width:14rem">筛选结论</th><th style="width:24rem">人工复核</th></tr></thead>
    <tbody>
      <% candidates.forEach(candidate => { %>
        <tr>
          <td><span class="badge text-bg-light border"><%= candidate.center_name %></span></td>
          <td>
            <strong><%= candidate.left_object_name %></strong>
            <div class="small text-secondary mt-1"><%= candidate.left.plan_count %> 个方案 · 关联标准项 <%= candidate.left.standard_item_count || 0 %> 项</div>
            <div class="small text-secondary"><%= (candidate.left.check_methods || []).join('、') || '-' %></div>
            <details class="small mt-1"><summary>查看方案与描述</summary><div class="mt-1"><%= (candidate.left.plan_numbers || []).map(number => String(number).padStart(3, '0')).join('、') || '-' %></div><% (candidate.left.descriptions || []).slice(0, 5).forEach(description => { %><div class="text-break mt-1"><%= description %></div><% }) %></details>
          </td>
          <td>
            <strong><%= candidate.right_object_name %></strong>
            <div class="small text-secondary mt-1"><%= candidate.right.plan_count %> 个方案 · 关联标准项 <%= candidate.right.standard_item_count || 0 %> 项</div>
            <div class="small text-secondary"><%= (candidate.right.check_methods || []).join('、') || '-' %></div>
            <details class="small mt-1"><summary>查看方案与描述</summary><div class="mt-1"><%= (candidate.right.plan_numbers || []).map(number => String(number).padStart(3, '0')).join('、') || '-' %></div><% (candidate.right.descriptions || []).slice(0, 5).forEach(description => { %><div class="text-break mt-1"><%= description %></div><% }) %></details>
          </td>
          <td>
            <span class="badge <%= candidate.candidate_type === 'exact' ? 'text-bg-danger' : 'text-bg-warning' %>"><%= candidate.candidate_type === 'exact' ? '规范化后同名' : '名称相似' %></span>
            <div class="small mt-1">相似度 <%= Number(candidate.similarity_score || 0).toFixed(3) %></div>
            <% if (candidate.ai) { %><div class="mt-1"><span class="badge <%= candidate.ai.relation === 'duplicate' ? 'text-bg-danger' : 'text-bg-success' %>"><%= candidate.ai.relation === 'duplicate' ? 'AI 判重' : candidate.ai.relation === 'unrelated' ? 'AI 判无关' : candidate.ai.relation === 'similar_but_distinct' ? 'AI 判不同' : 'AI 不确定' %></span></div><div class="small text-secondary mt-1">置信度 <%= Number(candidate.ai.confidence || 0).toFixed(3) %></div><div class="small text-secondary"><%= candidate.ai.reason || '-' %></div><% } %><% if (candidate.ai_status === 'failed') { %><div class="small text-danger mt-1">上次 AI 分析失败，不影响人工判断</div><% } %>
          </td>
          <td>
            <div class="d-flex flex-column align-items-start gap-1 object-review-actions">
              <div class="d-flex flex-nowrap gap-1">
                <button class="btn btn-sm btn-danger text-nowrap" type="button" data-center="<%= candidate.center_name %>" data-left="<%= candidate.left_object_name %>" data-right="<%= candidate.right_object_name %>" data-canonical="<%= candidate.left_object_name %>" data-left-plans="<%= candidate.left.plan_count %>" data-right-plans="<%= candidate.right.plan_count %>" onclick="mergeObject(this)">保留 A 并合并</button>
                <button class="btn btn-sm btn-danger text-nowrap" type="button" data-center="<%= candidate.center_name %>" data-left="<%= candidate.left_object_name %>" data-right="<%= candidate.right_object_name %>" data-canonical="<%= candidate.right_object_name %>" data-left-plans="<%= candidate.left.plan_count %>" data-right-plans="<%= candidate.right.plan_count %>" onclick="mergeObject(this)">保留 B 并合并</button>
              </div>
              <div class="d-flex flex-nowrap gap-1">
                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" data-center="<%= candidate.center_name %>" data-left="<%= candidate.left_object_name %>" data-right="<%= candidate.right_object_name %>" onclick="reviewObject(this, 'distinct')">不是重复</button>
                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" data-center="<%= candidate.center_name %>" data-left="<%= candidate.left_object_name %>" data-right="<%= candidate.right_object_name %>" onclick="reviewObject(this, 'uncertain')">暂不确定</button>
              </div>
              <button class="btn btn-sm btn-outline-primary text-nowrap" type="button" data-center="<%= candidate.center_name %>" data-left="<%= candidate.left_object_name %>" data-right="<%= candidate.right_object_name %>" onclick="analyzeObject(this)">可选 AI 分析</button>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (!candidates.length) { %><tr><td colspan="5" class="text-center text-secondary py-5">当前门限和筛选条件下没有对象候选。</td></tr><% } %>
    </tbody>
  </table></div>
</section>
<% } %>

<div class="modal fade" id="objectAiProgressModal" tabindex="-1" aria-labelledby="objectAiProgressTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <div class="modal-header"><h2 class="modal-title fs-5" id="objectAiProgressTitle">AI 语义复核进度</h2></div>
  <div class="modal-body">
    <div class="d-flex align-items-center gap-2 mb-2"><span class="spinner-border spinner-border-sm text-primary" id="objectAiProgressSpinner" aria-hidden="true"></span><strong id="objectAiProgressStatus" aria-live="polite">正在准备提交第一批...</strong></div>
    <div class="progress mb-2" role="progressbar" aria-label="AI 语义复核进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-bar progress-bar-striped progress-bar-animated" id="objectAiProgressBar" style="width:0%"></div></div>
    <div class="d-flex justify-content-between small text-secondary"><span id="objectAiProgressCount">成功 0 / 0 组</span><span id="objectAiProgressBatch">批次 0</span></div>
    <div class="alert alert-danger mt-3 mb-0 d-none" id="objectAiProgressError"></div>
    <div class="form-text mt-2">每批最多 4 组。请保持页面打开，完成前不会自动合并任何对象。</div>
  </div>
  <div class="modal-footer"><button class="btn btn-outline-secondary" id="objectAiProgressClose" type="button" data-bs-dismiss="modal" disabled>关闭</button></div>
</div></div></div>

<div class="modal fade" id="objectAiResultModal" tabindex="-1" aria-labelledby="objectAiResultTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h2 class="modal-title fs-5" id="objectAiResultTitle">AI 对象去重建议</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
  <div class="modal-body"><pre class="mb-0 text-wrap" id="objectAiResultBody"></pre></div>
  <div class="modal-footer"><button class="btn btn-primary" type="button" data-bs-dismiss="modal">关闭</button></div>
</div></div></div>

<script>
  const objectCsrfToken = '<%= csrf %>';
  const currentFilter = '<%= activeFilter %>';
  const currentThreshold = () => {
    const threshold = Number(document.getElementById('objectThreshold').value);
    if (!Number.isFinite(threshold) || threshold < 0 || threshold > 1) {
      throw new Error('名称相似度门限必须是 0 到 1 之间的数字');
    }
    return threshold;
  };
  const reloadUrl = (notice, filterOverride = currentFilter) => {
    const params = new URLSearchParams({
      run: '1',
      threshold: currentThreshold(),
      filter: filterOverride,
    });
    if (notice) params.set('notice', notice);
    return `/supervision-center-objects/dedupe?${params.toString()}`;
  };
  async function objectSend(path, body) {
    const response = await fetch(path, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': objectCsrfToken },
      body: JSON.stringify(body),
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.message || '请求失败');
    return data.data;
  }
  function runRuleScreen(button) {
    button.disabled = true;
    try {
      window.location.assign(reloadUrl());
    } catch (error) {
      button.disabled = false;
      window.showAppNotice(error.message, '规则筛选未完成');
    }
  }
  async function analyzeObject(button) {
    button.disabled = true;
    try {
      const job = await objectSend('/api/supervision-center-objects/ai-review', {
        centerName: button.dataset.center,
        leftObjectName: button.dataset.left,
        rightObjectName: button.dataset.right,
      });
      document.getElementById('objectAiResultBody').textContent = JSON.stringify(job.result || job, null, 2);
      bootstrap.Modal.getOrCreateInstance(document.getElementById('objectAiResultModal')).show();
    } catch (error) {
      window.showAppNotice(error.message, 'AI 分析未完成');
    } finally {
      button.disabled = false;
    }
  }
  function renderObjectAiProgress({ status, bar, success = 0, failed = 0, total, batch, error = '' }) {
    document.getElementById('objectAiProgressStatus').textContent = status;
    document.getElementById('objectAiProgressCount').textContent = `成功 ${success} / ${total} 组${failed ? `，失败 ${failed} 组` : ''}`;
    document.getElementById('objectAiProgressBatch').textContent = `批次 ${batch}`;
    const percentage = total > 0 ? Math.min(100, Math.round(success * 100 / total)) : 0;
    const progressBar = document.getElementById('objectAiProgressBar');
    progressBar.style.width = `${bar ?? percentage}%`;
    progressBar.parentElement.setAttribute('aria-valuenow', String(bar ?? percentage));
    const errorBox = document.getElementById('objectAiProgressError');
    errorBox.textContent = error;
    errorBox.classList.toggle('d-none', !error);
    document.getElementById('objectAiProgressSpinner').classList.toggle('d-none', Boolean(error));
    document.getElementById('objectAiProgressClose').disabled = !error;
  }
  async function runObjectAiScreen(button) {
    button.disabled = true;
    const total = Number(button.dataset.pending) || 0;
    let processed = 0;
    let errors = 0;
    let batchNumber = 0;
    renderObjectAiProgress({
      status: '正在准备提交第一批 AI 语义复核...',
      success: 0,
      total,
      batch: 0,
    });
    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('objectAiProgressModal'));
    modal.show();
    try {
      const threshold = currentThreshold();
      while (true) {
        batchNumber += 1;
        renderObjectAiProgress({
          status: `正在提交第 ${batchNumber} 批（每批最多 4 组）...`,
          success: processed,
          failed: errors,
          total,
          batch: batchNumber,
        });
        const result = await objectSend('/api/supervision-center-objects/ai-screen', {
          batchSize: 4,
          threshold,
        });
        processed += Number(result.processedCount || 0);
        errors += Number(result.errorCount || 0);
        const handled = processed + errors;
        const effectiveTotal = Math.max(total, Number(result.totalCount || 0), handled);
        renderObjectAiProgress({
          status: result.errorCount
            ? `第 ${batchNumber} 批 AI 复核失败`
            : `第 ${batchNumber} 批已完成，继续处理剩余候选...`,
          success: processed,
          failed: errors,
          total: effectiveTotal,
          batch: batchNumber,
        });
        if (result.errorCount) {
          const message = result.errors?.[0]?.message || 'AI 服务请求失败';
          renderObjectAiProgress({
            status: 'AI 语义复核已停止',
            success: processed,
            failed: errors,
            total: effectiveTotal,
            batch: batchNumber,
            error: `${message.replace(/[。；]+$/, '')}。已完成的判断会保留；修复 AI 服务后可继续重试。`,
          });
          window.showAppNotice(message, '可选 AI 复核未完成');
          return;
        }
        if (result.done || Number(result.submittedCount || 0) === 0) {
          renderObjectAiProgress({
            status: 'AI 语义复核完成，正在刷新结果...',
            bar: 100,
            success: Math.max(effectiveTotal, processed),
            total: Math.max(effectiveTotal, processed),
            batch: batchNumber,
          });
          window.setTimeout(() => window.location.assign(reloadUrl(null, 'all')), 700);
          return;
        }
      }
    } catch (error) {
      renderObjectAiProgress({
        status: 'AI 语义复核已停止',
        success: processed,
        failed: errors + 1,
        total,
        batch: batchNumber,
        error: `${String(error.message || 'AI 服务请求失败').replace(/[。；]+$/, '')}。请检查 AI 服务配置和网络后重试。`,
      });
      window.showAppNotice(error.message, '可选 AI 复核未完成');
    }
  }
  async function mergeObject(button) {
    const canonical = button.dataset.canonical;
    const source = canonical === button.dataset.left ? button.dataset.right : button.dataset.left;
    const plans = canonical === button.dataset.left ? button.dataset.rightPlans : button.dataset.leftPlans;
    if (!await window.confirmAppAction(`保留“${canonical}”并合并对象“${source}”？该中心下 ${plans} 个检查方案会更新到保留对象。`, '确认合并中心检查对象')) return;
    try {
      await objectSend('/api/supervision-center-objects/reviews', {
        centerName: button.dataset.center,
        leftObjectName: button.dataset.left,
        rightObjectName: button.dataset.right,
        decision: 'merged',
        canonicalObjectName: canonical,
      });
      window.location.assign(reloadUrl('对象已合并，检查方案已更新'));
    } catch (error) {
      window.showAppNotice(error.message, '对象合并未完成');
    }
  }
  async function reviewObject(button, decision) {
    const label = decision === 'distinct' ? '确认这两个对象不是重复？' : '将这两个对象标记为暂不确定？';
    if (!await window.confirmAppAction(label, '确认对象复核结论')) return;
    try {
      await objectSend('/api/supervision-center-objects/reviews', {
        centerName: button.dataset.center,
        leftObjectName: button.dataset.left,
        rightObjectName: button.dataset.right,
        decision,
      });
      window.location.assign(reloadUrl('对象复核结论已保存'));
    } catch (error) {
      window.showAppNotice(error.message, '对象复核未完成');
    }
  }
</script>
