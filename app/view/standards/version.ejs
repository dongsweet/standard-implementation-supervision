<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
  <div class="text-secondary">规范：<strong><%= version.standard_code %> · <%= version.standard_name %></strong>　版本：<strong><%= version.version %></strong><span class="badge text-bg-light ms-2"><%= ({ national: '国家标准', industry: '行业标准', local: '地方标准', group: '团体标准', enterprise: '企业标准', internal: '企业内部制度/规范', regulatory: '监管要求', other: '其他' })[version.standard_type] || version.standard_type %></span></div>
</div>

<div class="alert alert-info py-2"><strong>维护说明：</strong>推荐直接上传规范PDF。系统会 OCR 识别章节和条款，经人工选择粒度、跳过章节后写入；Excel/TSV 仍可用于结构化补录。标题下、a)/b) 子条款之前的引导语单独保存为条款说明。标准化编号按“规范号-章节号-导入顺序号”生成，原文编号原样保留。</div>

<div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
  <a class="btn btn-outline-secondary" href="/public/standard-import-template.xlsx?v=5" download>下载标准原文模板</a>
  <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#importVersionContentModal">导入Excel/TSV</button>
  <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#pdfImportModal">导入PDF并预览</button>
  <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#newChapterModal">新增章节</button>
  <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#clearVersionContentModal">清空规范内容</button>
</div>

<% if (importJobs && importJobs.length) { %><div class="card mb-3"><div class="card-header d-flex align-items-center"><h2 class="card-title h6 mb-0">PDF导入复核任务</h2><span class="small text-secondary ms-2">可继续打开未完成的复核草稿</span></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>PDF文件</th><th>对照文件</th><th>状态</th><th>更新时间</th><th style="width:13rem"></th></tr></thead><tbody><% importJobs.forEach(job => { const statusLabel = ({ queued: '排队中', processing: '解析中', ready: '待复核/草稿', failed: '解析失败', applying: '写入中', completed: '已写入' })[job.status] || job.status; const statusClass = job.status === 'ready' ? 'text-bg-warning' : job.status === 'failed' ? 'text-bg-danger' : job.status === 'completed' ? 'text-bg-success' : 'text-bg-secondary'; %><tr><td><span class="text-break"><%= job.original_filename %></span></td><td><span class="text-break"><%= job.comparison_filename || '-' %></span></td><td><span class="badge <%= statusClass %>"><%= statusLabel %></span><% if (job.status === 'processing' || job.status === 'queued') { %><span class="small text-secondary ms-1"><%= job.progress || 0 %>%</span><% } %></td><td><%= job.updated_at ? new Date(job.updated_at).toLocaleString('zh-CN') : '-' %></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/standards/versions/<%= version.id %>/pdf-imports/<%= job.id %>"><%= job.status === 'ready' ? '继续复核' : job.status === 'completed' ? '查看结果' : '查看任务' %></a><% if ([ 'queued', 'processing', 'applying' ].includes(job.status)) { %><button class='btn btn-sm btn-outline-secondary ms-1' type='button' disabled title='任务处理中，暂不能清理'>处理中</button><% } else { %><form method="post" action="/standards/versions/<%= version.id %>/pdf-imports/<%= job.id %>/delete" data-confirm="确认清理这个PDF导入任务及其临时文件吗？已写入规范库的标准项不会被删除。" data-confirm-title="清理PDF导入任务" class="d-inline ms-1"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" type="submit">清理</button></form><% } %></td></tr><% }) %></tbody></table></div></div><% } %>

<% if (!chapters.length) { %><div class="card"><div class="card-body text-center text-secondary py-5">暂无章节，请先添加章节。</div></div><% } %>
<% chapters.forEach(chapter => { %>
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center">
      <h3 class="card-title"><%= chapter.code %> · <%= chapter.name %> <span class="badge text-bg-light ms-2"><%= chapter.standard_number || '' %></span><span class="badge text-bg-light ms-1"><%= chapter.item_count %> 项</span></h3>
      <button class="btn btn-sm btn-outline-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#itemModal-<%= chapter.id %>">新增标准项</button>
      <button class="btn btn-sm btn-outline-secondary ms-2" type="button" data-bs-toggle="modal" data-bs-target="#importModal-<%= chapter.id %>">批量导入</button>
    </div>
    <div class="table-responsive"><table class="table table-sm table-striped align-middle mb-0">
      <thead><tr><th>标准化编号</th><th>原文编号</th><th>标准项标题</th><th>条款说明与标准内容</th><th>来源页</th></tr></thead><tbody>
        <% (chapter.items || []).forEach(item => { %><tr><td><span class="font-monospace"><%= item.standardNumber %></span></td><td><strong><%= item.itemCode %></strong></td><td><% if (Array.isArray(item.headingPath) && item.headingPath.length) { %><div class="small text-secondary mb-1"><% item.headingPath.forEach(heading => { %><div style="padding-left:<%= Math.max(0, Number(heading.level || 2) - 2) %>rem"><%= [heading.number, heading.title].filter(Boolean).join(' ') %></div><% }) %></div><% } %><%= item.title || '-' %></td><td><% if (item.explanation) { %><div class="small text-secondary mb-1"><strong>条款说明：</strong><%= item.explanation %></div><% } %><%= item.content %></td><td><%= item.sourcePageFrom ? (item.sourcePageFrom === item.sourcePageTo ? item.sourcePageFrom : item.sourcePageFrom + '-' + item.sourcePageTo) : '-' %></td></tr><% }) %>
        <% if (!chapter.items.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">本章节暂无标准项</td></tr><% } %>
      </tbody></table></div>
  </div>

  <div class="modal fade" id="itemModal-<%= chapter.id %>" tabindex="-1" aria-labelledby="itemModalLabel-<%= chapter.id %>" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <form method="post" action="/standards/chapters/<%= chapter.id %>/items"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="/standards/versions/<%= version.id %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="itemModalLabel-<%= chapter.id %>">新增标准项 · <%= chapter.code %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body row g-3">
        <div class="col-md-3"><label class="form-label">标准项编号</label><input class="form-control" name="itemCode" required></div>
        <div class="col-md-9"><label class="form-label">标准项标题</label><input class="form-control" name="title"></div>
        <div class="col-12"><label class="form-label">标准内容</label><textarea class="form-control" name="content" rows="4" required></textarea></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存标准项</button></div>
    </form>
  </div></div></div>

  <div class="modal fade" id="importModal-<%= chapter.id %>" tabindex="-1" aria-labelledby="importModalLabel-<%= chapter.id %>" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content">
    <form method="post" action="/standards/chapters/<%= chapter.id %>/import" data-confirm="确认导入本批标准项？请先核对每行的字段顺序和标准项编号。" data-confirm-title="批量导入标准项"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="/standards/versions/<%= version.id %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="importModalLabel-<%= chapter.id %>">批量导入 · <%= chapter.code %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body"><label class="form-label" for="importText-<%= chapter.id %>">每行一项，字段顺序：编号[TAB]标题[TAB]标准内容</label><textarea class="form-control font-monospace" id="importText-<%= chapter.id %>" name="text" rows="8" placeholder="3.1.1	账号管理	应建立账号管理制度" required></textarea></div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-outline-primary" type="submit">导入并更新</button></div>
    </form>
  </div></div></div>
<% }) %>

<div class="modal fade" id="pdfImportModal" tabindex="-1" aria-labelledby="pdfImportModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/standards/versions/<%= version.id %>/pdf-imports" enctype="multipart/form-data" data-confirm="将上传PDF并在后台执行OCR，完成后先进入预览，不会自动写入。确认继续？" data-confirm-title="导入规范PDF"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="pdfImportModalLabel">导入规范PDF</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="alert alert-info py-2">系统使用本地中文 OCR 识别PDF并保留页码；如同时上传自有结构化对照表，系统会优先采用可可靠匹配的对照正文，并标出未匹配和需核对项。</div>
      <div class="mb-3"><label class="form-label" for="pdfImportFile">PDF文件</label><input class="form-control" id="pdfImportFile" name="file" type="file" accept=".pdf,application/pdf" required><div class="form-text">最大 50MB、300 页。扫描版可以识别，但低清晰度页面需要人工核对。</div></div>
      <div><label class="form-label" for="comparisonFile">对照文本或Excel（可选）</label><input class="form-control" id="comparisonFile" name="comparisonFile" type="file" accept=".xlsx,.tsv,.csv,.txt"><div class="form-text">列名需包含编号和“标准内容”。内部编号可以是6001等自有序号，系统按章节、行序和正文相似度对齐PDF原文，内部编号不会覆盖原文编号。</div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">上传并开始识别</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="clearVersionContentModal" tabindex="-1" aria-labelledby="clearVersionContentModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/standards/versions/<%= version.id %>/clear-content"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="clearVersionContentModalLabel">清空规范内容</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="alert alert-warning mb-0">将删除当前版本的全部章节和标准项，但保留规范编号、名称、类型和版本标识。若标准项已被项目应答、章节负责人、监督定义或检查记录引用，系统会拒绝清空。</div>
      <p class="mt-3 mb-0">当前版本：<strong><%= version.standard_code %> · <%= version.version %></strong></p>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-danger" type="submit">确认清空内容</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="importVersionContentModal" tabindex="-1" aria-labelledby="importVersionContentModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/standards/versions/<%= version.id %>/import" enctype="multipart/form-data" data-confirm="将向当前版本导入章节和标准项，不修改规范基本信息。同编号章节和标准项会更新，文件中未包含的现有内容会保留。确认继续？" data-confirm-title="导入规范内容"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="importVersionContentModalLabel">仅导入规范内容</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-12"><div class="alert alert-info py-2 mb-0">当前规范：<strong><%= version.standard_code %> · <%= version.standard_name %></strong>，版本：<strong><%= version.version %></strong>。此操作只导入章节和标准项，不修改规范编号、名称、类型、组织或版本标识。</div></div>
      <div class="col-12"><label class="form-label" for="versionContentFile">规范内容文件</label><input class="form-control" id="versionContentFile" name="file" type="file" accept=".xlsx,.tsv" required><div class="form-text">文件最大15MB。建议使用<a href="/public/standard-import-template.xlsx?v=5" download>Excel模板</a>；“标题路径”列支持任意层级，用“ &gt; ”分隔，例如：6.1 资源分配 &gt; 6.1.1 一般要求 &gt; 6.1.1.1 账号策略。标题后的条款说明单独填写在对应列。也支持原始多工作表Excel和<a href="/public/standard-import-template.tsv?v=5" download>TSV格式</a>。应用口径和项目证据在项目页填写。</div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">导入内容</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="newChapterModal" tabindex="-1" aria-labelledby="newChapterModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/standards/versions/<%= version.id %>/chapters"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="newChapterModalLabel">新增章节</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-md-4"><label class="form-label" for="chapterCode">章节编号</label><input class="form-control" id="chapterCode" name="code" placeholder="例如：3.1" required></div>
      <div class="col-md-6"><label class="form-label" for="chapterName">章节名称</label><input class="form-control" id="chapterName" name="name" required></div>
      <div class="col-md-2"><label class="form-label" for="chapterSortOrder">排序</label><input class="form-control" id="chapterSortOrder" name="sortOrder" type="number" value="0"></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">添加章节</button></div>
  </form>
</div></div></div>
