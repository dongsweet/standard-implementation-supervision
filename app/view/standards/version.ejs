<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
  <div class="text-secondary">规范：<strong><%= version.standard_code %> · <%= version.standard_name %></strong>　版本：<strong><%= version.version %></strong></div>
  <% if (version.status === 'published') { %><span class="badge text-bg-success">已发布</span><% } else { %>
    <form method="post" action="/standards/versions/<%= version.id %>/publish" class="ms-auto" data-confirm="确认发布此规范版本？发布后它可被项目用作固定内容，且不能再修改。" data-confirm-title="发布规范版本"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-success btn-sm" type="submit">发布此版本</button></form>
  <% } %>
</div>

<div class="alert alert-info py-2"><strong>接入工作流：</strong>先建立章节，再维护标准项；也可以按“标准项编号、标题、标准内容、层级、是否关键项”的 TSV/CSV 格式批量导入。发布后版本内容作为项目基线候选。</div>

<div class="d-flex justify-content-end mb-3"><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newChapterModal">新增章节</button></div>

<% if (!chapters.length) { %><div class="card"><div class="card-body text-center text-secondary py-5">暂无章节，请先添加章节。</div></div><% } %>
<% chapters.forEach(chapter => { %>
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center">
      <h3 class="card-title"><%= chapter.code %> · <%= chapter.name %> <span class="badge text-bg-light ms-2"><%= chapter.item_count %> 项</span></h3>
      <button class="btn btn-sm btn-outline-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#itemModal-<%= chapter.id %>">新增标准项</button>
      <button class="btn btn-sm btn-outline-secondary ms-2" type="button" data-bs-toggle="modal" data-bs-target="#importModal-<%= chapter.id %>">批量导入</button>
    </div>
    <div class="table-responsive"><table class="table table-sm table-striped align-middle mb-0">
      <thead><tr><th>标准项编号</th><th>标准内容</th><th>云服务商</th><th>统管要求</th><th>实施证据</th><th>层级/关键项</th></tr></thead><tbody>
        <% (chapter.items || []).forEach(item => { %><tr><td><strong><%= item.itemCode %></strong><div class="small text-secondary"><%= item.title || '' %></div></td><td><%= item.content %></td><td><%= (item.providers || []).join('、') || '-' %></td><td><%= (item.requirements || []).map(row => row.requirement).join('；') || '-' %></td><td><%= (item.requirements || []).map(row => row.evidence).filter(Boolean).join('；') || '-' %></td><td><%= item.level || '-' %> / <%= item.isKey ? '关键' : '普通' %></td></tr><% }) %>
        <% if (!chapter.items.length) { %><tr><td colspan="6" class="text-center text-secondary py-3">本章节暂无标准项</td></tr><% } %>
      </tbody></table></div>
  </div>

  <div class="modal fade" id="itemModal-<%= chapter.id %>" tabindex="-1" aria-labelledby="itemModalLabel-<%= chapter.id %>" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <form method="post" action="/standards/chapters/<%= chapter.id %>/items"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="/standards/versions/<%= version.id %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="itemModalLabel-<%= chapter.id %>">新增标准项 · <%= chapter.code %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body row g-3">
        <div class="col-md-3"><label class="form-label">标准项编号</label><input class="form-control" name="itemCode" required></div>
        <div class="col-md-5"><label class="form-label">标准项标题</label><input class="form-control" name="title"></div>
        <div class="col-md-4"><label class="form-label">层级</label><input class="form-control" name="level"></div>
        <div class="col-12"><label class="form-label">标准内容</label><textarea class="form-control" name="content" rows="3" required></textarea></div>
        <div class="col-md-4"><label class="form-label">云服务商</label><input class="form-control" name="providerNames" placeholder="多个用逗号分隔"></div>
        <div class="col-md-4"><label class="form-label">统管制度规范具体要求</label><textarea class="form-control" name="unifiedRequirement" rows="2"></textarea></div>
        <div class="col-md-4"><label class="form-label">统一规范实施证据列表</label><textarea class="form-control" name="implementationEvidence" rows="2"></textarea></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存标准项</button></div>
    </form>
  </div></div></div>

  <div class="modal fade" id="importModal-<%= chapter.id %>" tabindex="-1" aria-labelledby="importModalLabel-<%= chapter.id %>" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content">
    <form method="post" action="/standards/chapters/<%= chapter.id %>/import" data-confirm="确认导入本批标准项？请先核对每行的字段顺序和标准项编号。" data-confirm-title="批量导入标准项"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="/standards/versions/<%= version.id %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="importModalLabel-<%= chapter.id %>">批量导入 · <%= chapter.code %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body"><label class="form-label" for="importText-<%= chapter.id %>">每行一项，字段顺序：编号[TAB]标题[TAB]标准内容[TAB]层级[TAB]关键项[TAB]云服务商（可多个）[TAB]统管要求[TAB]实施证据</label><textarea class="form-control font-monospace" id="importText-<%= chapter.id %>" name="text" rows="8" placeholder="3.1.1	账号管理	应建立账号管理制度	基础	是	云厂商A|云厂商B	应纳入统一账号管理	制度文件、配置截图" required></textarea></div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-outline-primary" type="submit">导入并更新</button></div>
    </form>
  </div></div></div>
<% }) %>

<div class="modal fade" id="newChapterModal" tabindex="-1" aria-labelledby="newChapterModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/standards/versions/<%= version.id %>/chapters"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="newChapterModalLabel">新增章节</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-md-4"><label class="form-label" for="chapterCode">章节编号</label><input class="form-control" id="chapterCode" name="code" placeholder="例如：3.1" required></div>
      <div class="col-md-6"><label class="form-label" for="chapterName">章节名称</label><input class="form-control" id="chapterName" name="name" required></div>
      <div class="col-md-2"><label class="form-label" for="chapterSortOrder">排序</label><input class="form-control" id="chapterSortOrder" name="sortOrder" type="number" value="0"></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">添加章节</button></div>
  </form>
</div></div></div>
