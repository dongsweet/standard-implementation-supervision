<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
  <div class="text-secondary">规范：<strong><%= version.standard_code %> · <%= version.standard_name %></strong>　版本：<strong><%= version.version %></strong></div>
  <% if (version.status === 'published') { %><span class="badge text-bg-success">已发布</span><% } else { %><span class="badge text-bg-secondary">草稿</span><form method="post" action="/standards/versions/<%= version.id %>/publish" class="ms-auto"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-success btn-sm" type="submit">发布此版本</button></form><% } %>
</div>

<div class="alert alert-info py-2"><strong>接入工作流：</strong>先建立章节，再维护标准项；也可以按“标准项编号、标题、标准内容、层级、是否关键项”的 TSV/CSV 格式批量导入。发布后版本内容作为项目基线候选。</div>

<div class="card mb-3">
  <div class="card-header"><h3 class="card-title">新增章节</h3></div>
  <form method="post" action="/standards/versions/<%= version.id %>/chapters">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="card-body row g-2"><div class="col-md-3"><label class="form-label">章节编号</label><input class="form-control" name="code" placeholder="例如：3.1" required></div><div class="col-md-6"><label class="form-label">章节名称</label><input class="form-control" name="name" required></div><div class="col-md-2"><label class="form-label">排序</label><input class="form-control" name="sortOrder" type="number" value="0"></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">添加</button></div></div>
  </form>
</div>

<% if (!chapters.length) { %><div class="card"><div class="card-body text-center text-secondary py-5">暂无章节，请先添加章节。</div></div><% } %>
<% chapters.forEach(chapter => { %>
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center"><h3 class="card-title"><%= chapter.code %> · <%= chapter.name %> <span class="badge text-bg-light ms-2"><%= chapter.item_count %> 项</span></h3><button class="btn btn-sm btn-outline-primary ms-auto" data-bs-toggle="collapse" data-bs-target="#itemForm-<%= chapter.id %>">新增标准项</button><button class="btn btn-sm btn-outline-secondary ms-2" data-bs-toggle="collapse" data-bs-target="#importForm-<%= chapter.id %>">批量导入</button></div>
    <div class="collapse border-bottom" id="itemForm-<%= chapter.id %>"><form method="post" action="/standards/chapters/<%= chapter.id %>/items" class="p-3 row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="/standards/versions/<%= version.id %>"><div class="col-md-2"><input class="form-control" name="itemCode" placeholder="标准项编号" required></div><div class="col-md-3"><input class="form-control" name="title" placeholder="标准项标题"></div><div class="col-md-5"><input class="form-control" name="content" placeholder="标准内容" required></div><div class="col-md-1"><input class="form-control" name="level" placeholder="层级"></div><div class="col-md-1"><button class="btn btn-primary w-100" type="submit">保存</button></div><div class="col-md-4"><input class="form-control" name="providerNames" placeholder="云服务商，多个用逗号分隔"></div><div class="col-md-4"><input class="form-control" name="unifiedRequirement" placeholder="统管制度规范具体要求"></div><div class="col-md-4"><input class="form-control" name="implementationEvidence" placeholder="统一规范实施证据列表"></div></form></div>
    <div class="collapse border-bottom" id="importForm-<%= chapter.id %>"><form method="post" action="/standards/chapters/<%= chapter.id %>/import" class="p-3"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="/standards/versions/<%= version.id %>"><label class="form-label">每行一项，字段顺序：编号[TAB]标题[TAB]标准内容[TAB]层级[TAB]关键项[TAB]云服务商（可多个）[TAB]统管要求[TAB]实施证据</label><textarea class="form-control font-monospace mb-2" name="text" rows="4" placeholder="3.1.1\t账号管理\t应建立账号管理制度\t基础\t是\t云厂商A|云厂商B\t应纳入统一账号管理\t制度文件、配置截图"></textarea><button class="btn btn-outline-primary" type="submit">导入并更新</button></form></div>
    <div class="table-responsive"><table class="table table-sm table-striped align-middle mb-0"><thead><tr><th>标准项编号</th><th>标准内容</th><th>云服务商</th><th>统管要求</th><th>实施证据</th><th>层级/关键项</th></tr></thead><tbody>
      <% (chapter.items || []).forEach(item => { %><tr><td><strong><%= item.itemCode %></strong><div class="small text-secondary"><%= item.title || '' %></div></td><td><%= item.content %></td><td><%= (item.providers || []).join('、') || '-' %></td><td><%= (item.requirements || []).map(row => row.requirement).join('；') || '-' %></td><td><%= (item.requirements || []).map(row => row.evidence).filter(Boolean).join('；') || '-' %></td><td><%= item.level || '-' %> / <%= item.isKey ? '关键' : '普通' %></td></tr><% }) %>
      <% if (!chapter.items.length) { %><tr><td colspan="6" class="text-center text-secondary py-3">本章节暂无标准项</td></tr><% } %>
    </tbody></table></div>
  </div>
<% }) %>
