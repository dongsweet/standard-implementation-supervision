<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="text-secondary">PDF导入：<strong><%= job.standard_code %> · <%= job.standard_name %> · <%= job.version %></strong></div>
  <a class="btn btn-sm btn-outline-secondary ms-auto" href="/standards/versions/<%= versionId %>">返回规范维护</a>
</div>

<% if ([ 'queued', 'processing' ].includes(job.status)) { %>
  <div class="card" id="processingPanel"><div class="card-body py-5 text-center">
    <h2 class="h5">正在识别PDF并构建章节树</h2>
    <p class="text-secondary mb-3" id="processingMessage"><%= job.page_count ? (job.progress < 10 ? '正在将 ' + job.page_count + ' 页PDF转换为图像…' : '正在OCR识别，已完成 ' + job.progress + '%') : '正在读取PDF页数…' %></p>
    <div class="progress mx-auto" style="max-width:560px;height:24px"><div class="progress-bar progress-bar-striped progress-bar-animated" id="progressBar" style="width:<%= job.progress || 0 %>%"><%= job.progress || 0 %>%</div></div>
    <p class="small text-secondary mt-3 mb-0">扫描型PDF需要逐页 OCR；完成后会显示预览树，不会自动写入规范库。</p>
  </div></div>
<% } else if (job.status === 'failed') { %>
  <div class="alert alert-danger"><strong>PDF解析失败：</strong><%= job.error_message || '未知错误' %></div>
  <a class="btn btn-primary" href="/standards/versions/<%= versionId %>">返回并重新上传</a>
<% } else if (job.status === 'completed') { %>
  <div class="alert alert-success">该PDF导入任务已经完成，标准原文已写入规范库。</div>
  <a class="btn btn-primary" href="/standards/versions/<%= versionId %>">返回规范维护</a>
<% } else { %>
  <div class="alert alert-info py-2"><strong>核对说明：</strong>OCR结果不会自动写库。请确认原文编号、章节范围与拆分粒度；默认跳过前言、附录和参考文献。</div>
  <div class="card mb-3">
    <div class="card-body row g-3 align-items-end">
      <div class="col-12 col-xl-4"><label class="form-label" for="granularity">批量拆分粒度</label><select class="form-select" id="granularity">
        <option value="leaf" selected>叶子条款（推荐，如 6.1.1 a）</option>
        <option value="level3">三级要求（如 6.1.1）</option>
        <option value="level2">二级标题（如 6.1）</option>
        <option value="level1">大章（如 6）</option>
      </select><div class="form-text">应用粒度后仍可逐节点改成章节、标准项或跳过。</div></div>
      <div class="col-12 col-xl-3"><div class="border rounded p-2 bg-body-tertiary"><div class="small text-secondary">当前选择</div><strong id="selectedCount">0</strong> 个标准项</div></div>
      <div class="col-12 col-xl-5 d-flex justify-content-end gap-2"><button class="btn btn-outline-secondary" type="button" id="skipFrontMatter">跳过前置内容</button><button class="btn btn-outline-primary" type="button" id="aiReviewButton">AI校验选中项</button><button class="btn btn-primary" type="submit" form="applyPdfImport" id="applyButton">确认并写入规范库</button></div>
    </div>
  </div>

  <% (result.warnings || []).forEach(warning => { %><div class="alert alert-warning py-2"><%= warning %></div><% }) %>

  <div class="card">
    <div class="card-header d-flex align-items-center"><h3 class="card-title">识别结果预览</h3><span class="badge text-bg-secondary ms-auto"><%= result.nodes.length %> 个节点 · <%= result.pages %> 页</span></div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
      <thead><tr><th style="width:7rem">原文编号</th><th>层级内容</th><th style="width:6rem">PDF页码</th><th style="width:6rem">OCR置信度</th><th style="width:10rem">导入角色</th></tr></thead>
      <tbody>
        <% result.nodes.forEach(node => { const depth = Math.max(0, (node.level || 1) - 1); %>
          <tr data-node-id="<%= node.id %>" data-level="<%= node.level %>">
            <td><input class="form-control form-control-sm font-monospace node-number" data-node-id="<%= node.id %>" value="<%= node.originalNumber || '' %>" aria-label="原文编号"></td>
            <td><div class="node-indent" data-node-id="<%= node.id %>" style="padding-left:<%= depth * 1.25 %>rem"><input class="form-control form-control-sm node-title mb-1" data-node-id="<%= node.id %>" value="<%= node.title || '' %>" placeholder="条款标题（列表项可留空）" aria-label="条款标题"><textarea class="form-control form-control-sm node-content" data-node-id="<%= node.id %>" rows="<%= Math.min(6, Math.max(2, Math.ceil((node.content || '').length / 80))) %>" aria-label="标准原文"><%= node.content || '' %></textarea><div class="small text-secondary mt-1">OCR 原文可直接修正；写入时使用修正后的内容。</div></div></td>
            <td><%= node.pageFrom === node.pageTo ? node.pageFrom : node.pageFrom + '-' + node.pageTo %></td>
            <td><span class="badge <%= node.confidence < 60 ? 'text-bg-danger' : node.confidence < 80 ? 'text-bg-warning' : 'text-bg-success' %>"><%= node.confidence %>%</span></td>
            <td><select class="form-select form-select-sm node-role" data-node-id="<%= node.id %>"><option value="container" <%= node.role === 'container' ? 'selected' : '' %>>章节/容器</option><option value="item" <%= node.role === 'item' ? 'selected' : '' %>>标准项</option><option value="skip" <%= node.role === 'skip' ? 'selected' : '' %>>跳过</option></select><button class="btn btn-sm btn-outline-danger mt-1 w-100 skip-subtree" type="button" data-node-id="<%= node.id %>">跳过本节全部</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  </div>

  <div class="modal fade" id="aiCorrectionsModal" tabindex="-1" aria-labelledby="aiCorrectionsModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="aiCorrectionsModalLabel">AI 校验建议</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="alert alert-warning py-2">AI 仅根据 OCR 文本和上下文提供修改建议，可能出错。请逐项核对，勾选后再应用；未勾选的内容不会变化。</div>
      <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th style="width:3rem">应用</th><th>标准项</th><th>修改前</th><th>AI修改建议</th><th>理由/置信度</th></tr></thead><tbody id="aiCorrectionsBody"></tbody></table></div>
      <div class="text-secondary small mt-2" id="aiCorrectionSummary"></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button type="button" class="btn btn-primary" id="applyAiCorrections">应用勾选建议</button></div>
  </div></div></div>

  <form id="applyPdfImport" method="post" action="/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/apply" data-confirm="确认将当前选择写入规范库？标准化编号会自动生成，原文编号保持不变。" data-confirm-title="确认PDF导入"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="selection" id="selectionInput"></form>

  <script>
    (() => {
      let nodes = <%- JSON.stringify(result.nodes).replace(/</g, '\\u003c') %>;
      let aiCorrections = [];
      let byId = new Map(nodes.map(node => [ node.id, node ]));
      const inferLevel = node => {
        const value = String(
          document.querySelector('.node-number[data-node-id="' + node.id + '"]')?.value
          || node.originalNumber
          || ''
        ).trim().normalize('NFKC');
        const numbered = value.match(/^(\d{1,3}(?:\.\d{1,3}){0,3})(?:\s*(?:\(\d{1,3}\)|[A-Za-z][_)）]))?/);
        if (numbered) return numbered[1].split('.').length + (numbered[0].length > numbered[1].length ? 1 : 0);
        return node.kind === 'list' ? 4 : 1;
      };
      const recalculateHierarchy = () => {
        const stack = [];
        nodes = nodes.map(node => {
          const level = inferLevel(node);
          while (stack.length && stack[stack.length - 1].level >= level) stack.pop();
          const recalculated = { ...node, level, parentId: stack.length ? stack[stack.length - 1].id : null };
          stack.push(recalculated);
          return recalculated;
        });
        byId = new Map(nodes.map(node => [ node.id, node ]));
      };
      const descendants = id => {
        const result = [];
        const queue = [ id ];
        while (queue.length) {
          const parentId = queue.shift();
          for (const node of nodes.filter(item => item.parentId === parentId)) {
            result.push(node);
            queue.push(node.id);
          }
        }
        return result;
      };
      const isDescendant = (node, ancestorId) => {
        let parentId = node.parentId;
        const visited = new Set();
        while (parentId && byId.has(parentId) && !visited.has(parentId)) {
          if (parentId === ancestorId) return true;
          visited.add(parentId);
          parentId = byId.get(parentId).parentId;
        }
        return false;
      };
      const hasListDescendant = node => nodes.some(other => other.kind === 'list' && isDescendant(other, node.id));
      const selects = () => Array.from(document.querySelectorAll('.node-role'));
      const updateCount = () => {
        document.getElementById('selectedCount').textContent = selects().filter(select => select.value === 'item').length;
      };
      const setRole = (id, role) => {
        const select = document.querySelector('.node-role[data-node-id="' + id + '"]');
        if (select) select.value = role;
      };
      const refreshLayout = () => {
        for (const node of nodes) {
          const row = document.querySelector('tr[data-node-id="' + node.id + '"]');
          const indent = document.querySelector('.node-indent[data-node-id="' + node.id + '"]');
          const skipButton = document.querySelector('.skip-subtree[data-node-id="' + node.id + '"]');
          if (row) row.dataset.level = String(node.level);
          if (indent) indent.style.paddingLeft = Math.max(0, node.level - 1) * 1.25 + 'rem';
          if (skipButton) skipButton.classList.toggle('d-none', descendants(node.id).length === 0);
        }
      };
      const applyGranularity = value => {
        for (const node of nodes) {
          if (value === 'leaf') setRole(node.id, node.kind === 'list' || (node.kind === 'heading' && !hasListDescendant(node)) ? 'item' : 'container');
          if (value === 'level3') setRole(node.id, node.kind === 'heading' && node.level === 3 ? 'item' : node.kind === 'list' ? 'skip' : 'container');
          if (value === 'level2') setRole(node.id, node.kind === 'heading' && node.level === 2 ? 'item' : 'container');
          if (value === 'level1') setRole(node.id, node.kind === 'heading' && node.level === 1 ? 'item' : 'container');
        }
        updateCount();
      };
      document.getElementById('granularity').addEventListener('change', event => applyGranularity(event.target.value));
      document.getElementById('skipFrontMatter').addEventListener('click', () => {
        for (const node of nodes) {
          if (node.pageFrom <= 7 || /^(前言|引言|目次|目\s*录)$/.test(node.title || '')) setRole(node.id, 'skip');
        }
        updateCount();
      });
      document.querySelectorAll('.node-number').forEach(input => input.addEventListener('input', () => {
        recalculateHierarchy();
        refreshLayout();
      }));
      document.querySelectorAll('.skip-subtree').forEach(button => button.addEventListener('click', () => {
        const id = button.dataset.nodeId;
        setRole(id, 'skip');
        for (const child of descendants(id)) setRole(child.id, 'skip');
        updateCount();
      }));
      const itemPayload = select => {
        const node = byId.get(select.dataset.nodeId);
        return {
          id: select.dataset.nodeId,
          originalNumber: document.querySelector('.node-number[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          title: document.querySelector('.node-title[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          content: document.querySelector('.node-content[data-node-id="' + select.dataset.nodeId + '"]')?.value || node?.content || ''
        };
      };
      const appendText = (cell, text) => {
        const pre = document.createElement('pre');
        pre.className = 'small mb-0 text-wrap';
        pre.style.whiteSpace = 'pre-wrap';
        pre.textContent = text;
        cell.appendChild(pre);
      };
      const renderAiCorrections = corrections => {
        const body = document.getElementById('aiCorrectionsBody');
        body.replaceChildren();
        corrections.forEach((correction, index) => {
          const row = document.createElement('tr');
          const selectCell = document.createElement('td');
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'form-check-input ai-correction-checkbox';
          checkbox.dataset.index = String(index);
          checkbox.checked = true;
          selectCell.appendChild(checkbox);
          row.appendChild(selectCell);
          const itemCell = document.createElement('td');
          const before = correction.before;
          appendText(itemCell, (before.originalNumber || '-') + (before.title ? '\n' + before.title : ''));
          row.appendChild(itemCell);
          const beforeCell = document.createElement('td');
          appendText(beforeCell, before.content || '');
          row.appendChild(beforeCell);
          const afterCell = document.createElement('td');
          appendText(afterCell, [
            correction.originalNumber,
            correction.title,
            correction.content
          ].filter(Boolean).join('\n'));
          row.appendChild(afterCell);
          const reasonCell = document.createElement('td');
          appendText(reasonCell, (correction.reason || '-') + '\n置信度 ' + Math.round(correction.confidence * 100) + '%');
          row.appendChild(reasonCell);
          body.appendChild(row);
        });
        document.getElementById('aiCorrectionSummary').textContent = '共 ' + corrections.length + ' 条建议。';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('aiCorrectionsModal')).show();
      };
      document.getElementById('aiReviewButton').addEventListener('click', async event => {
        const button = event.currentTarget;
        const items = selects().filter(select => select.value === 'item').map(itemPayload);
        if (!items.length) {
          window.showAppNotice('请先选择需要AI校验的标准项。');
          return;
        }
        const chunks = [];
        for (let index = 0; index < items.length; index += 10) chunks.push(items.slice(index, index + 10));
        const corrections = [];
        const originalText = button.textContent;
        button.disabled = true;
        try {
          for (let index = 0; index < chunks.length; index += 1) {
            button.textContent = 'AI校验 ' + (index + 1) + '/' + chunks.length;
            const response = await fetch('/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/ai-review', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': '<%= csrf %>',
                accept: 'application/json'
              },
              body: JSON.stringify({ nodes: chunks[index] })
            });
            const body = await response.json();
            if (!response.ok) throw new Error(body.message || 'AI校验失败');
            corrections.push(...(body.data.corrections || []));
          }
          aiCorrections = corrections;
          if (!corrections.length) {
            window.showAppNotice('AI没有发现足够明确的OCR错误。');
            return;
          }
          renderAiCorrections(corrections);
        } catch (error) {
          window.showAppNotice(error.message, 'AI校验失败');
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
      document.getElementById('applyAiCorrections').addEventListener('click', () => {
        const selectedIndices = Array.from(document.querySelectorAll('.ai-correction-checkbox:checked'))
          .map(checkbox => Number(checkbox.dataset.index));
        for (const index of selectedIndices) {
          const correction = aiCorrections[index];
          const number = document.querySelector('.node-number[data-node-id="' + correction.nodeId + '"]');
          const title = document.querySelector('.node-title[data-node-id="' + correction.nodeId + '"]');
          const content = document.querySelector('.node-content[data-node-id="' + correction.nodeId + '"]');
          if (number) number.value = correction.originalNumber;
          if (title) title.value = correction.title;
          if (content) content.value = correction.content;
          const node = byId.get(correction.nodeId);
          if (node) {
            node.originalNumber = correction.originalNumber;
            node.title = correction.title;
            node.content = correction.content;
          }
        }
        recalculateHierarchy();
        refreshLayout();
        updateCount();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('aiCorrectionsModal')).hide();
        window.showAppNotice('已应用 ' + selectedIndices.length + ' 条AI修改建议。');
      });
      selects().forEach(select => select.addEventListener('change', updateCount));
      recalculateHierarchy();
      refreshLayout();
      document.getElementById('applyPdfImport').addEventListener('submit', event => {
        const items = selects().filter(select => select.value === 'item');
        if (!items.length) {
          event.preventDefault();
          window.showAppNotice('请至少选择一个标准项。');
          return;
        }
        document.getElementById('selectionInput').value = JSON.stringify(selects().map(select => ({
          id: select.dataset.nodeId,
          role: select.value,
          originalNumber: document.querySelector('.node-number[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          title: document.querySelector('.node-title[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          content: document.querySelector('.node-content[data-node-id="' + select.dataset.nodeId + '"]')?.value || ''
        })));
      });
      applyGranularity('leaf');
    })();
  </script>
<% } %>

<% if ([ 'queued', 'processing' ].includes(job.status)) { %>
<script>
  (() => {
    const url = '/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/status';
    const poll = async () => {
      try {
        const response = await fetch(url, { headers: { accept: 'application/json' } });
        if (!response.ok) throw new Error('状态读取失败');
        const status = await response.json();
        document.getElementById('progressBar').style.width = status.progress + '%';
        document.getElementById('progressBar').textContent = status.progress + '%';
        document.getElementById('processingMessage').textContent = !status.pageCount
          ? '正在读取PDF页数…'
          : status.progress < 10
            ? '正在将 ' + status.pageCount + ' 页PDF转换为图像…'
            : '正在OCR识别，已完成 ' + status.progress + '%';
        if (status.status === 'ready' || status.status === 'failed' || status.status === 'completed') {
          window.location.reload();
          return;
        }
      } catch {
        // A transient failure should not stop polling.
      }
      window.setTimeout(poll, 2000);
    };
    window.setTimeout(poll, 1500);
  })();
</script>
<% } %>
