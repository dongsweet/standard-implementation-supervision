<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="text-secondary">PDF导入：<strong><%= job.standard_code %> · <%= job.standard_name %> · <%= job.version %></strong></div>
  <a class="btn btn-sm btn-outline-secondary ms-auto" href="/standards/versions/<%= versionId %>">返回规范维护</a>
</div>

<% if ([ 'queued', 'processing' ].includes(job.status)) { %>
  <div class="card" id="processingPanel"><div class="card-body py-5 text-center">
    <h2 class="h5">正在识别PDF并构建章节树</h2>
    <p class="text-secondary mb-3" id="processingMessage"><%= job.page_count ? (job.progress < 10 ? '正在检查PDF文本层或转换页面图像…' : '正在识别标准内容，已完成 ' + job.progress + '%') : '正在读取PDF页数…' %></p>
    <div class="progress mx-auto" style="max-width:560px;height:24px"><div class="progress-bar progress-bar-striped progress-bar-animated" id="progressBar" style="width:<%= job.progress || 0 %>%"><%= job.progress || 0 %>%</div></div>
    <p class="small text-secondary mt-3 mb-0">扫描型PDF需要逐页 OCR；完成后会显示预览树，不会自动写入规范库。</p>
  </div></div>
<% } else if (job.status === 'failed') { %>
  <div class="alert alert-danger"><strong>PDF解析失败：</strong><%= job.error_message || '未知错误' %></div>
  <a class="btn btn-primary" href="/standards/versions/<%= versionId %>">返回并重新上传</a>
<% } else if (job.status === 'completed') { %>
  <div class="alert alert-success">该PDF导入任务已经完成，标准原文已写入规范库。</div>
  <a class="btn btn-primary" href="/standards/versions/<%= versionId %>">返回规范维护</a>
<% } else { %>
  <div class="alert alert-info py-2"><strong>核对说明：</strong>OCR结果不会自动写库。请确认原文编号、章节范围与拆分粒度；默认跳过前言、附录和参考文献。</div>
  <div class="card mb-3">
    <div class="card-body row g-3 align-items-end">
      <div class="col-12 col-xl-4"><label class="form-label" for="granularity">批量拆分粒度</label><select class="form-select" id="granularity">
        <option value="leaf" selected>叶子条款（推荐，如 6.1.1 a）</option>
        <option value="level3">三级要求（如 6.1.1）</option>
        <option value="level2">二级标题（如 6.1）</option>
        <option value="level1">大章（如 6）</option>
      </select><div class="form-text">应用粒度后仍可逐节点改成章节、标准项或跳过；正文仅3个字以内或类似“默认：无”的节点默认跳过，可手工改回。</div></div>
      <div class="col-12 col-xl-3"><div class="border rounded p-2 bg-body-tertiary"><div class="small text-secondary">当前选择</div><strong id="selectedCount">0</strong> 个标准项<div class="small text-secondary mt-1" id="draftStatus">尚未修改</div><div class="small text-secondary mt-1">草稿允许暂存不完整条款，正式写入前再校验。</div></div></div>
      <div class="col-12 col-xl-5 d-flex justify-content-end gap-2"><button class="btn btn-outline-secondary" type="button" id="skipFrontMatter">跳过前置内容</button><button class="btn btn-outline-secondary" type="button" id="addNodeButton">新增条款</button><button class="btn btn-outline-primary" type="button" id="aiReviewButton">AI校验选中项</button><button class="btn btn-outline-warning" type="button" id="smartReviewButton">智能复核剩余项</button><button class="btn btn-outline-success" type="button" id="saveDraftButton">保存草稿</button><button class="btn btn-primary" type="submit" form="applyPdfImport" id="applyButton">确认并写入规范库</button></div>
    </div>
  </div>

  <% (result.warnings || []).forEach(warning => { %><div class="alert alert-warning py-2"><%= warning %></div><% }) %>
  <% if (result.comparisonSummary) { %><div class="alert alert-info py-2"><strong>对照文本：</strong><%= job.comparison_filename %>，共 <%= result.comparisonSummary.comparisonCount %> 条。系统按章节、顺序和正文相似度对齐，内部编号不会覆盖PDF原文编号：自动采用 <strong><%= result.comparisonSummary.matchedCount %> 条（<%= result.comparisonSummary.autoMatchRate %>%）</strong>，待核对 <strong><%= result.comparisonSummary.reviewCount %> 条</strong>，条款标号冲突 <%= result.comparisonSummary.markerConflictCount %> 条，PDF未匹配 <strong><%= result.comparisonSummary.unmatchedCount %> 条</strong>，对照表未使用 <strong><%= result.comparisonSummary.unusedComparisonCount %> 条</strong>。<% if (result.comparisonSummary.duplicateItemCount) { %>已跳过重复标准项 <%= result.comparisonSummary.duplicateItemCount %> 条（保留首次出现记录）。<% } %><div class="mt-2 d-flex flex-wrap gap-2"><button class="btn btn-sm btn-outline-warning" type="button" id="showReviewOnly">只看待复核项</button><button class="btn btn-sm btn-outline-danger" type="button" id="showUnmatchedOnly">查看PDF未匹配项</button><% if (result.comparisonSummary.unusedComparisonCount) { %><button class="btn btn-sm btn-outline-secondary" type="button" id="showUnusedComparison">查看对照表未使用项</button><% } %></div></div><% } %>

  <div class="card">
    <div class="card-header d-flex align-items-center"><h3 class="card-title">识别结果预览</h3><span class="badge <%= result.extractionMethod === 'text' ? 'text-bg-success' : 'text-bg-warning' %> ms-auto"><%= result.extractionMethod === 'text' ? 'PDF文本层直读' : 'OCR识别' %></span><span class="badge text-bg-secondary ms-2"><%= result.nodes.length %> 个节点 · <%= result.pages %> 页</span></div>
    <div class="card-body border-bottom py-2"><div class="row g-2 align-items-center"><div class="col-12 col-md-4"><label class="form-label small mb-1" for="reviewFilter">查看范围</label><select class="form-select form-select-sm" id="reviewFilter"><option value="all">全部节点</option><option value="review">需要复核</option><option value="unmatched">PDF未匹配</option><option value="matched">已匹配对照</option><option value="items">当前标准项</option></select></div><div class="col-12 col-md-3"><label class="form-label small mb-1" for="pageSize">每页条数</label><select class="form-select form-select-sm" id="pageSize"><option value="20" selected>20</option><option value="50">50</option><option value="100">100</option></select></div><div class="col-12 col-md-5 text-md-end"><span class="small text-secondary" id="filterSummary"></span></div></div></div>
    <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
      <thead><tr><th style="width:7rem">原文编号</th><th>层级内容</th><th style="width:6rem">PDF页码</th><th style="width:6rem">OCR置信度</th><th style="width:10rem">导入角色</th></tr></thead>
      <tbody>
        <% result.nodes.forEach(node => { const depth = Math.max(0, (node.level || 1) - 1); %>
          <tr data-node-id="<%= node.id %>" data-level="<%= node.level %>" data-node-kind="<%= node.kind %>" data-comparison-match="<%= node.comparisonMatch || '' %>" data-comparison-conflict="<%= node.comparisonMarkerConflict ? '1' : '0' %>">
            <td><input class="form-control form-control-sm font-monospace node-number" data-node-id="<%= node.id %>" value="<%= node.originalNumber || '' %>" aria-label="原文编号"></td>
            <td><div class="node-indent" data-node-id="<%= node.id %>" style="padding-left:<%= depth * 1.25 %>rem"><input class="form-control form-control-sm node-title mb-1" data-node-id="<%= node.id %>" value="<%= node.title || '' %>" placeholder="条款标题（列表项可留空）" aria-label="条款标题"><textarea class="form-control form-control-sm node-content" data-node-id="<%= node.id %>" rows="<%= Math.min(6, Math.max(2, Math.ceil((node.content || '').length / 80))) %>" aria-label="标准原文"><%= node.content || '' %></textarea><% if (node.comparisonMatch) { %><div class="d-flex flex-wrap align-items-center gap-2 mt-1"><span class="badge comparison-status-badge <%= node.comparisonMatch === 'matched' ? 'text-bg-success' : node.comparisonMatch === 'review' ? 'text-bg-warning' : 'text-bg-secondary' %>"><%= node.comparisonMatch === 'matched' ? '已采用对照文本' : '对照文本待核对' %></span><span class="small text-secondary">匹配度 <%= Math.round((node.comparisonSimilarity || 0) * 100) %>% · 对照表内部编号 <%= node.comparisonItemCode %></span><% if (node.comparisonMatch !== 'matched') { %><button class="btn btn-sm btn-outline-primary use-comparison" type="button" data-node-id="<%= node.id %>">对比/采用对照正文</button><% } %></div><% } %><div class="small text-secondary mt-1">编号、标题和正文可直接修正；写入时使用当前内容。</div></div></td>
            <td><%= node.pageFrom === node.pageTo ? node.pageFrom : node.pageFrom + '-' + node.pageTo %></td>
            <td><span class="badge <%= node.confidence < 60 ? 'text-bg-danger' : node.confidence < 80 ? 'text-bg-warning' : 'text-bg-success' %>"><%= node.confidence %>%</span></td>
            <td><select class="form-select form-select-sm node-role" data-node-id="<%= node.id %>"><option value="container" <%= node.role === 'container' ? 'selected' : '' %>>章节/容器</option><option value="item" <%= node.role === 'item' ? 'selected' : '' %>>标准项</option><option value="skip" <%= node.role === 'skip' ? 'selected' : '' %>>跳过</option></select><button class="btn btn-sm btn-outline-danger mt-1 w-100 skip-subtree" type="button" data-node-id="<%= node.id %>">跳过本节全部</button><div class="btn-group btn-group-sm mt-1 w-100" role="group"><button class="btn btn-outline-secondary move-up" type="button" data-node-id="<%= node.id %>">上移</button><button class="btn btn-outline-secondary move-down" type="button" data-node-id="<%= node.id %>">下移</button></div><button class="btn btn-sm btn-outline-primary mt-1 w-100 add-after" type="button" data-node-id="<%= node.id %>">此后新增</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <div class="card-footer d-flex flex-wrap gap-2 justify-content-between align-items-center"><span class="small text-secondary" id="pageInfo"></span><nav aria-label="识别结果分页"><ul class="pagination pagination-sm mb-0" id="tablePagination"></ul></nav></div>
  </div>

  <div class="modal fade" id="comparisonPreviewModal" tabindex="-1" aria-labelledby="comparisonPreviewModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="comparisonPreviewModalLabel">对比对照正文</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><div class="alert alert-warning py-2" id="comparisonPreviewMeta"></div><div class="row g-3"><div class="col-12 col-lg-6"><h3 class="h6">当前PDF/OCR正文</h3><pre class="border rounded p-3 bg-body-tertiary small text-wrap" id="comparisonPdfText" style="min-height:12rem;white-space:pre-wrap"></pre></div><div class="col-12 col-lg-6"><h3 class="h6">对照表正文</h3><pre class="border rounded p-3 bg-body-tertiary small text-wrap" id="comparisonSourceText" style="min-height:12rem;white-space:pre-wrap"></pre></div></div><div class="small text-secondary mt-3">采用后会用右侧对照正文替换当前编辑框内容；系统不会自动修改原文编号。</div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">暂不采用</button><button type="button" class="btn btn-primary" id="adoptComparisonText">采用对照正文</button></div>
  </div></div></div>

  <% if (result.comparisonSummary && result.comparisonSummary.unusedComparisonRows && result.comparisonSummary.unusedComparisonRows.length) { %><div class="modal fade" id="unusedComparisonModal" tabindex="-1" aria-labelledby="unusedComparisonModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="unusedComparisonModalLabel">对照表未使用项</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="alert alert-danger py-2">这些对照表条款没有可靠匹配到PDF识别结果，可能是PDF漏识别、章节名称不一致、拆分粒度不同或对照表本身存在额外条款，请逐项确认。</div><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th style="width:8rem">内部编号</th><th style="width:14rem">章节</th><th style="width:14rem">标题</th><th>标准内容</th></tr></thead><tbody id="unusedComparisonBody"></tbody></table></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">关闭</button></div></div></div></div><% } %>

  <div class="modal fade" id="addNodeModal" tabindex="-1" aria-labelledby="addNodeModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="addNodeModalLabel">新增标准项</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3"><div class="col-md-4"><label class="form-label" for="newNodeNumber">原文编号</label><input class="form-control" id="newNodeNumber" required placeholder="例如：6.1.1 a)"></div><div class="col-md-8"><label class="form-label" for="newNodeTitle">条款标题</label><input class="form-control" id="newNodeTitle"></div><div class="col-12"><label class="form-label" for="newNodeContent">标准内容</label><textarea class="form-control" id="newNodeContent" rows="6" required></textarea></div><div class="col-12"><div class="form-text" id="newNodePositionHint">新条款将追加到当前列表末尾；也可以从某一行的“此后新增”进入。</div></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button type="button" class="btn btn-primary" id="createNodeButton">加入复核草稿</button></div>
  </div></div></div>

  <div class="modal fade" id="smartReviewSetupModal" tabindex="-1" aria-labelledby="smartReviewSetupModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="smartReviewSetupModalLabel">智能复核剩余条款</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="alert alert-info py-2">系统先按确定性规则识别章节/容器和“无、默认无、页眉噪声”等跳过项，再把未匹配、待复核和疑似拼接条款交给AI生成建议。建议只会展示在下一步，不会自动写入草稿。</div>
      <label class="form-label" for="smartReviewAfter">已核对到的原文编号（可选）</label>
      <input class="form-control" id="smartReviewAfter" placeholder="例如：6.6.3">
      <div class="form-text">填写后，编号及其之前的节点不会送入本次智能复核，并且默认只处理该编号所在章节的剩余内容；当前页面尚未保存的修改也会随请求一并分析。</div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button type="button" class="btn btn-warning" id="startSmartReview">开始生成建议</button></div>
  </div></div></div>

  <div class="modal fade" id="smartReviewResultModal" tabindex="-1" aria-labelledby="smartReviewResultModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="smartReviewResultModalLabel">智能复核建议</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><div id="smartReviewNotice"></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th style="width:3rem">应用</th><th style="width:8rem">原文编号</th><th style="width:8rem">建议</th><th>当前正文</th><th>建议正文/结果</th><th>理由</th></tr></thead><tbody id="smartReviewBody"></tbody></table></div><div class="text-secondary small mt-2" id="smartReviewSummary"></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">暂不应用</button><button type="button" class="btn btn-warning" id="applySmartReview">应用勾选建议（仍需保存草稿）</button></div>
  </div></div></div>

  <div class="modal fade" id="aiCorrectionsModal" tabindex="-1" aria-labelledby="aiCorrectionsModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><h2 class="modal-title fs-5" id="aiCorrectionsModalLabel">AI 校验建议</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="alert alert-warning py-2">AI 仅根据 OCR 文本和上下文提供修改建议，可能出错。请逐项核对，勾选后再应用；未勾选的内容不会变化。</div>
      <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th style="width:3rem">应用</th><th>标准项</th><th>修改前</th><th>AI修改建议</th><th>理由/置信度</th></tr></thead><tbody id="aiCorrectionsBody"></tbody></table></div>
      <div class="text-secondary small mt-2" id="aiCorrectionSummary"></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button type="button" class="btn btn-primary" id="applyAiCorrections">应用勾选建议</button></div>
  </div></div></div>

  <form id="applyPdfImport" method="post" action="/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/apply" data-confirm="确认将当前选择写入规范库？标准化编号会自动生成，原文编号保持不变。" data-confirm-title="确认PDF导入"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="selection" id="selectionInput"></form>

  <script>
    (() => {
      let nodes = <%- JSON.stringify(result.nodes).replace(/</g, '\\u003c') %>;
      const comparisonSummary = <%- JSON.stringify(result.comparisonSummary || null).replace(/</g, '\\u003c') %>;
      let aiCorrections = [];
      let smartRecommendations = [];
      let byId = new Map(nodes.map(node => [ node.id, node ]));
      let comparisonPreviewNodeId = null;
      let currentPage = 1;
      let pageSize = 20;
      let dirty = false;
      let addAfterNodeId = null;
      const markDirty = () => {
        dirty = true;
        const status = document.getElementById('draftStatus');
        if (status) status.textContent = '有未保存修改';
      };
      const setDraftStatus = text => {
        const status = document.getElementById('draftStatus');
        if (status) status.textContent = text;
      };
      const inferLevel = node => {
        const value = String(
          document.querySelector('.node-number[data-node-id="' + node.id + '"]')?.value
          || node.originalNumber
          || ''
        ).trim().normalize('NFKC');
        const numbered = value.match(/^(\d{1,3}(?:\.\d{1,3}){0,3})(?:\s*(?:\(\d{1,3}\)|[A-Za-z][_)）]))?/);
        if (numbered) return numbered[1].split('.').length + (numbered[0].length > numbered[1].length ? 1 : 0);
        return node.kind === 'list' ? 4 : 1;
      };
      const recalculateHierarchy = () => {
        const stack = [];
        nodes = nodes.map(node => {
          const level = inferLevel(node);
          while (stack.length && stack[stack.length - 1].level >= level) stack.pop();
          const recalculated = { ...node, level, parentId: stack.length ? stack[stack.length - 1].id : null };
          stack.push(recalculated);
          return recalculated;
        });
        byId = new Map(nodes.map(node => [ node.id, node ]));
      };
      const descendants = id => {
        const result = [];
        const queue = [ id ];
        while (queue.length) {
          const parentId = queue.shift();
          for (const node of nodes.filter(item => item.parentId === parentId)) {
            result.push(node);
            queue.push(node.id);
          }
        }
        return result;
      };
      const isDescendant = (node, ancestorId) => {
        let parentId = node.parentId;
        const visited = new Set();
        while (parentId && byId.has(parentId) && !visited.has(parentId)) {
          if (parentId === ancestorId) return true;
          visited.add(parentId);
          parentId = byId.get(parentId).parentId;
        }
        return false;
      };
      const hasListDescendant = node => nodes.some(other => other.kind === 'list' && isDescendant(other, node.id));
      const shouldSkipByDefault = node => {
        const normalized = String(node?.content || '')
          .normalize('NFKC')
          .replace(/[\s\u3000:：，。；、,.!?！？;:'"“”‘’()（）\[\]【】《》<>—_\-\/|\\]/g, '');
        return Boolean(normalized) && normalized.length <= 3;
      };
      const selects = () => Array.from(document.querySelectorAll('.node-role'));
      const updateCount = () => {
        document.getElementById('selectedCount').textContent = selects().filter(select => select.value === 'item').length;
      };
      const tableRows = () => Array.from(document.querySelectorAll('tbody tr[data-node-id]'));
      const getTableBody = () => document.querySelector('table.table tbody');
      const isReviewNode = node => Boolean(node?.comparisonMatch && node.comparisonMatch !== 'matched') || Boolean(node?.comparisonMarkerConflict);
      const isUnmatchedNode = node => Boolean(node && (node.kind === 'list' || node.kind === 'heading')
        && String(node.content || '').trim()
        && (!node.comparisonMatch || node.comparisonMatch === 'unmatched'));
      const matchesFilter = node => {
        const filter = document.getElementById('reviewFilter')?.value || 'all';
        if (filter === 'review') return isReviewNode(node);
        if (filter === 'unmatched') return isUnmatchedNode(node);
        if (filter === 'matched') return node?.comparisonMatch === 'matched';
        if (filter === 'items') return document.querySelector('.node-role[data-node-id="' + node.id + '"]')?.value === 'item';
        return true;
      };
      const renderPagination = (totalPages, current) => {
        const pagination = document.getElementById('tablePagination');
        pagination.replaceChildren();
        const appendButton = (label, page, disabled = false, active = false) => {
          const li = document.createElement('li');
          li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'page-link';
          button.textContent = label;
          button.disabled = disabled;
          if (!disabled) button.addEventListener('click', () => { currentPage = page; renderTablePage(); });
          li.appendChild(button);
          pagination.appendChild(li);
        };
        appendButton('上一页', current - 1, current <= 1);
        const pages = [];
        for (let page = 1; page <= totalPages; page += 1) {
          if (totalPages <= 7 || page === 1 || page === totalPages || Math.abs(page - current) <= 1) pages.push(page);
        }
        let previous = 0;
        for (const page of pages) {
          if (previous && page - previous > 1) {
            const gap = document.createElement('li');
            gap.className = 'page-item disabled';
            gap.innerHTML = '<span class="page-link">…</span>';
            pagination.appendChild(gap);
          }
          appendButton(String(page), page, false, page === current);
          previous = page;
        }
        appendButton('下一页', current + 1, current >= totalPages);
      };
      const renderTablePage = () => {
        const rows = tableRows();
        const filtered = rows.filter(row => matchesFilter(byId.get(row.dataset.nodeId)));
        const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
        currentPage = Math.min(Math.max(1, currentPage), totalPages);
        rows.forEach(row => row.classList.add('d-none'));
        const start = (currentPage - 1) * pageSize;
        const pageRows = filtered.slice(start, start + pageSize);
        pageRows.forEach(row => row.classList.remove('d-none'));
        document.getElementById('filterSummary').textContent = '当前筛选 ' + filtered.length + ' 条，显示第 ' + (filtered.length ? start + 1 : 0) + '-' + Math.min(start + pageSize, filtered.length) + ' 条';
        document.getElementById('pageInfo').textContent = '第 ' + currentPage + ' / ' + totalPages + ' 页';
        renderPagination(totalPages, currentPage);
      };
      const makeControl = (tag, className, text = '') => {
        const control = document.createElement(tag);
        if (className) control.className = className;
        if (text) control.textContent = text;
        return control;
      };
      const createNodeRow = node => {
        const row = document.createElement('tr');
        row.dataset.nodeId = node.id;
        row.dataset.level = String(node.level || 1);
        row.dataset.nodeKind = node.kind || 'list';
        row.dataset.comparisonMatch = node.comparisonMatch || '';
        row.dataset.comparisonConflict = node.comparisonMarkerConflict ? '1' : '0';

        const numberCell = makeControl('td');
        const number = makeControl('input', 'form-control form-control-sm font-monospace node-number');
        number.dataset.nodeId = node.id;
        number.value = node.originalNumber || '';
        number.setAttribute('aria-label', '原文编号');
        numberCell.appendChild(number);

        const contentCell = makeControl('td');
        const indent = makeControl('div', 'node-indent');
        indent.dataset.nodeId = node.id;
        indent.style.paddingLeft = Math.max(0, (node.level || 1) - 1) * 1.25 + 'rem';
        const title = makeControl('input', 'form-control form-control-sm node-title mb-1');
        title.dataset.nodeId = node.id;
        title.value = node.title || '';
        title.placeholder = '条款标题（列表项可留空）';
        title.setAttribute('aria-label', '条款标题');
        const content = makeControl('textarea', 'form-control form-control-sm node-content');
        content.dataset.nodeId = node.id;
        content.rows = Math.min(6, Math.max(2, Math.ceil(String(node.content || '').length / 80)));
        content.setAttribute('aria-label', '标准原文');
        content.value = node.content || '';
        indent.append(title, content);
        const note = makeControl('div', 'small text-secondary mt-1', '编号、标题和正文可直接修正；写入时使用当前内容。');
        indent.appendChild(note);
        contentCell.appendChild(indent);

        const pageCell = makeControl('td', '', node.pageFrom && node.pageTo && node.pageFrom !== node.pageTo ? `${node.pageFrom}-${node.pageTo}` : (node.pageFrom || '-'));
        const confidenceCell = makeControl('td');
        const confidence = makeControl('span', 'badge text-bg-success', `${node.confidence ?? 100}%`);
        confidenceCell.appendChild(confidence);
        const actionCell = makeControl('td');
        const role = makeControl('select', 'form-select form-select-sm node-role');
        role.dataset.nodeId = node.id;
        [ [ 'container', '章节/容器' ], [ 'item', '标准项' ], [ 'skip', '跳过' ] ].forEach(([ value, label ]) => {
          const option = makeControl('option', '', label);
          option.value = value;
          option.selected = (node.role || 'item') === value;
          role.appendChild(option);
        });
        actionCell.appendChild(role);
        const skip = makeControl('button', 'btn btn-sm btn-outline-danger mt-1 w-100', '跳过本节全部');
        skip.type = 'button';
        skip.dataset.nodeId = node.id;
        skip.classList.toggle('d-none', descendants(node.id).length === 0);
        skip.classList.add('skip-subtree');
        actionCell.appendChild(skip);
        const group = makeControl('div', 'btn-group btn-group-sm mt-1 w-100');
        [ [ 'move-up', '上移' ], [ 'move-down', '下移' ] ].forEach(([ cls, label ]) => {
          const button = makeControl('button', `btn btn-outline-secondary ${cls}`, label);
          button.type = 'button';
          button.dataset.nodeId = node.id;
          group.appendChild(button);
        });
        actionCell.appendChild(group);
        const add = makeControl('button', 'btn btn-sm btn-outline-primary mt-1 w-100 add-after', '此后新增');
        add.type = 'button';
        add.dataset.nodeId = node.id;
        actionCell.appendChild(add);
        row.append(numberCell, contentCell, pageCell, confidenceCell, actionCell);
        return row;
      };
      const reorderDomRows = () => {
        const tbody = getTableBody();
        if (!tbody) return;
        for (const node of nodes) {
          const row = document.querySelector('tr[data-node-id="' + node.id + '"]');
          if (row) tbody.appendChild(row);
        }
      };
      const setRole = (id, role) => {
        const select = document.querySelector('.node-role[data-node-id="' + id + '"]');
        if (select) select.value = role;
      };
      const collectNodes = () => nodes.map(node => {
        const id = node.id;
        return {
          ...node,
          id,
          originalNumber: document.querySelector('.node-number[data-node-id="' + id + '"]')?.value || '',
          title: document.querySelector('.node-title[data-node-id="' + id + '"]')?.value || '',
          content: document.querySelector('.node-content[data-node-id="' + id + '"]')?.value || '',
          role: document.querySelector('.node-role[data-node-id="' + id + '"]')?.value || node.role || 'container',
        };
      });
      const saveDraft = async () => {
        const button = document.getElementById('saveDraftButton');
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = '保存中…';
        try {
          nodes = collectNodes();
          recalculateHierarchy();
          const response = await fetch('/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/save-draft', {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrf %>', accept: 'application/json' },
            body: JSON.stringify({ nodes }),
          });
          const body = await response.json();
          if (!response.ok) throw new Error(body.message || '草稿保存失败');
          dirty = false;
          setDraftStatus('已保存 ' + new Date().toLocaleTimeString('zh-CN'));
          window.showAppNotice('复核草稿已保存。');
        } catch (error) {
          window.showAppNotice(error.message, '保存草稿失败');
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      };
      const refreshLayout = () => {
        for (const node of nodes) {
          const row = document.querySelector('tr[data-node-id="' + node.id + '"]');
          const indent = document.querySelector('.node-indent[data-node-id="' + node.id + '"]');
          const skipButton = document.querySelector('.skip-subtree[data-node-id="' + node.id + '"]');
          if (row) row.dataset.level = String(node.level);
          if (indent) indent.style.paddingLeft = Math.max(0, node.level - 1) * 1.25 + 'rem';
          if (skipButton) skipButton.classList.toggle('d-none', descendants(node.id).length === 0);
        }
      };
      const applyGranularity = value => {
        for (const node of nodes) {
          if (shouldSkipByDefault(node)) {
            setRole(node.id, 'skip');
            continue;
          }
          if (value === 'leaf') setRole(node.id, node.kind === 'list' || (node.kind === 'heading' && !hasListDescendant(node)) ? 'item' : 'container');
          if (value === 'level3') setRole(node.id, node.kind === 'heading' && node.level === 3 ? 'item' : node.kind === 'list' ? 'skip' : 'container');
          if (value === 'level2') setRole(node.id, node.kind === 'heading' && node.level === 2 ? 'item' : 'container');
          if (value === 'level1') setRole(node.id, node.kind === 'heading' && node.level === 1 ? 'item' : 'container');
        }
        updateCount();
        renderTablePage();
      };
      document.getElementById('granularity').addEventListener('change', event => { applyGranularity(event.target.value); markDirty(); });
      document.getElementById('reviewFilter').addEventListener('change', () => { currentPage = 1; renderTablePage(); });
      document.getElementById('pageSize').addEventListener('change', event => { pageSize = Number(event.target.value) || 20; currentPage = 1; renderTablePage(); });
      document.getElementById('showReviewOnly')?.addEventListener('click', () => { document.getElementById('reviewFilter').value = 'review'; currentPage = 1; renderTablePage(); });
      document.getElementById('showUnmatchedOnly')?.addEventListener('click', () => { document.getElementById('reviewFilter').value = 'unmatched'; currentPage = 1; renderTablePage(); });
      const addModal = document.getElementById('addNodeModal');
      const openAddNodeModal = anchorId => {
        addAfterNodeId = anchorId || null;
        document.getElementById('newNodeNumber').value = '';
        document.getElementById('newNodeTitle').value = '';
        document.getElementById('newNodeContent').value = '';
        document.getElementById('newNodePositionHint').textContent = anchorId
          ? '新条款将插入到所选条款之后，保存草稿后仍可继续上移或下移。'
          : '新条款将追加到当前列表末尾，保存草稿后仍可继续上移或下移。';
        bootstrap.Modal.getOrCreateInstance(addModal).show();
      };
      document.getElementById('addNodeButton').addEventListener('click', () => openAddNodeModal(null));
      document.getElementById('createNodeButton').addEventListener('click', () => {
        const originalNumber = document.getElementById('newNodeNumber').value.trim();
        const title = document.getElementById('newNodeTitle').value.trim();
        const content = document.getElementById('newNodeContent').value.trim();
        if (!originalNumber || !content) {
          window.showAppNotice('新增条款必须填写原文编号和标准内容。');
          return;
        }
        const id = 'draft-' + (window.crypto?.randomUUID?.() || Date.now() + '-' + Math.random().toString(16).slice(2));
        const node = { id, kind: 'list', role: 'item', originalNumber, title, content, pageFrom: null, pageTo: null, confidence: 100 };
        const anchorIndex = addAfterNodeId ? nodes.findIndex(item => item.id === addAfterNodeId) : -1;
        nodes.splice(anchorIndex >= 0 ? anchorIndex + 1 : nodes.length, 0, node);
        byId = new Map(nodes.map(item => [ item.id, item ]));
        const tbody = getTableBody();
        const row = createNodeRow(node);
        if (tbody && anchorIndex >= 0) {
          const anchorRow = document.querySelector('tr[data-node-id="' + addAfterNodeId + '"]');
          if (anchorRow?.nextSibling) tbody.insertBefore(row, anchorRow.nextSibling); else tbody.appendChild(row);
        } else if (tbody) tbody.appendChild(row);
        recalculateHierarchy();
        refreshLayout();
        updateCount();
        currentPage = 1;
        renderTablePage();
        markDirty();
        bootstrap.Modal.getOrCreateInstance(addModal).hide();
        window.showAppNotice('条款已加入复核草稿，请保存草稿。');
      });
      const tableBody = getTableBody();
      tableBody?.addEventListener('input', event => {
        if (event.target.matches('.node-number, .node-title, .node-content')) {
          markDirty();
          if (event.target.matches('.node-number')) {
            recalculateHierarchy();
            refreshLayout();
            renderTablePage();
          }
        }
      });
      tableBody?.addEventListener('change', event => {
        if (event.target.matches('.node-role')) {
          markDirty();
          updateCount();
          renderTablePage();
        }
      });
      tableBody?.addEventListener('click', event => {
        const button = event.target.closest('button');
        if (!button) return;
        const id = button.dataset.nodeId;
        if (button.classList.contains('add-after')) {
          openAddNodeModal(id);
          return;
        }
        if (button.classList.contains('skip-subtree')) {
          setRole(id, 'skip');
          for (const child of descendants(id)) setRole(child.id, 'skip');
          markDirty();
          updateCount();
          renderTablePage();
          return;
        }
        if (button.classList.contains('move-up') || button.classList.contains('move-down')) {
          const index = nodes.findIndex(item => item.id === id);
          const direction = button.classList.contains('move-up') ? -1 : 1;
          const target = index + direction;
          if (index < 0 || target < 0 || target >= nodes.length) return;
          [ nodes[index], nodes[target] ] = [ nodes[target], nodes[index] ];
          recalculateHierarchy();
          reorderDomRows();
          refreshLayout();
          markDirty();
          renderTablePage();
        }
      });
      document.getElementById('saveDraftButton').addEventListener('click', saveDraft);
      window.addEventListener('beforeunload', event => {
        if (!dirty) return;
        event.preventDefault();
        event.returnValue = '';
      });
      document.getElementById('skipFrontMatter').addEventListener('click', () => {
        for (const node of nodes) {
          if (node.pageFrom <= 7 || /^(前言|引言|目次|目\s*录)$/.test(node.title || '')) setRole(node.id, 'skip');
        }
        markDirty();
        updateCount();
        renderTablePage();
      });
      document.querySelectorAll('.node-number').forEach(input => input.addEventListener('input', () => {
        recalculateHierarchy();
        refreshLayout();
      }));
      const comparisonModal = document.getElementById('comparisonPreviewModal');
      const showComparisonPreview = node => {
        if (!node?.comparisonContent || !comparisonModal) return;
        comparisonPreviewNodeId = node.id;
        document.getElementById('comparisonPreviewMeta').textContent = 'PDF编号 ' + (node.originalNumber || '-')
          + ' · 对照表内部编号 ' + (node.comparisonItemCode || '-')
          + ' · 匹配度 ' + Math.round((node.comparisonSimilarity || 0) * 100) + '%';
        document.getElementById('comparisonPdfText').textContent = node.ocrContent || node.content || '';
        document.getElementById('comparisonSourceText').textContent = node.comparisonContent;
        bootstrap.Modal.getOrCreateInstance(comparisonModal).show();
      };
      const adoptComparisonText = () => {
        const node = byId.get(comparisonPreviewNodeId);
        if (!node?.comparisonContent) return;
        const textarea = document.querySelector('.node-content[data-node-id="' + node.id + '"]');
        if (textarea) textarea.value = node.comparisonContent;
        node.content = node.comparisonContent;
        node.comparisonMatch = 'matched';
        node.comparisonMarkerConflict = false;
        const row = document.querySelector('tr[data-node-id="' + node.id + '"]');
        const badge = row?.querySelector('.comparison-status-badge');
        if (badge) {
          badge.classList.remove('text-bg-warning', 'text-bg-secondary');
          badge.classList.add('text-bg-success');
          badge.replaceChildren('已采用对照文本');
        }
        const button = row?.querySelector('.use-comparison');
        button?.remove();
        bootstrap.Modal.getOrCreateInstance(comparisonModal).hide();
        renderTablePage();
        window.showAppNotice('已采用对照正文，请继续确认其他条款。');
      };
      document.querySelectorAll('.use-comparison').forEach(button => button.addEventListener('click', () => showComparisonPreview(byId.get(button.dataset.nodeId))));
      document.getElementById('adoptComparisonText')?.addEventListener('click', adoptComparisonText);
      const showUnusedComparison = () => {
        const modal = document.getElementById('unusedComparisonModal');
        const body = document.getElementById('unusedComparisonBody');
        if (!modal || !body) return;
        body.replaceChildren();
        for (const rowData of comparisonSummary?.unusedComparisonRows || []) {
          const row = document.createElement('tr');
          [ rowData.itemCode, (rowData.chapterCode || '') + ' ' + (rowData.chapterName || ''), rowData.title || '-', rowData.content || '' ].forEach(value => {
            const cell = document.createElement('td');
            cell.textContent = value;
            row.appendChild(cell);
          });
          body.appendChild(row);
        }
        bootstrap.Modal.getOrCreateInstance(modal).show();
      };
      document.getElementById('showUnusedComparison')?.addEventListener('click', showUnusedComparison);
      const itemPayload = select => {
        const node = byId.get(select.dataset.nodeId);
        return {
          id: select.dataset.nodeId,
          originalNumber: document.querySelector('.node-number[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          title: document.querySelector('.node-title[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          content: document.querySelector('.node-content[data-node-id="' + select.dataset.nodeId + '"]')?.value || node?.content || ''
        };
      };
      const appendText = (cell, text) => {
        const pre = document.createElement('pre');
        pre.className = 'small mb-0 text-wrap';
        pre.style.whiteSpace = 'pre-wrap';
        pre.textContent = text;
        cell.appendChild(pre);
      };
      const renderAiCorrections = corrections => {
        const body = document.getElementById('aiCorrectionsBody');
        body.replaceChildren();
        corrections.forEach((correction, index) => {
          const row = document.createElement('tr');
          const selectCell = document.createElement('td');
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'form-check-input ai-correction-checkbox';
          checkbox.dataset.index = String(index);
          checkbox.checked = true;
          selectCell.appendChild(checkbox);
          row.appendChild(selectCell);
          const itemCell = document.createElement('td');
          const before = correction.before;
          appendText(itemCell, (before.originalNumber || '-') + (before.title ? '\n' + before.title : ''));
          row.appendChild(itemCell);
          const beforeCell = document.createElement('td');
          appendText(beforeCell, before.content || '');
          row.appendChild(beforeCell);
          const afterCell = document.createElement('td');
          appendText(afterCell, [
            correction.originalNumber,
            correction.title,
            correction.content
          ].filter(Boolean).join('\n'));
          row.appendChild(afterCell);
          const reasonCell = document.createElement('td');
          appendText(reasonCell, (correction.reason || '-') + '\n置信度 ' + Math.round(correction.confidence * 100) + '%');
          row.appendChild(reasonCell);
          body.appendChild(row);
        });
        document.getElementById('aiCorrectionSummary').textContent = '共 ' + corrections.length + ' 条建议。';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('aiCorrectionsModal')).show();
      };
      const smartActionLabel = action => ({
        container: '章节/容器',
        skip: '跳过',
        adopt_comparison: '采用对照正文',
        correct_ocr: '修正OCR正文',
        keep_ocr: '保留当前正文',
        split_required: '疑似拼接，人工拆分',
        uncertain: '待人工确认',
      }[action] || action);
      const smartRecommendationNode = recommendation => recommendation.source || byId.get(recommendation.nodeId);
      const renderSmartReview = data => {
        const body = document.getElementById('smartReviewBody');
        const notice = document.getElementById('smartReviewNotice');
        body.replaceChildren();
        notice.replaceChildren();
        if (data.aiUnavailable) {
          const warning = document.createElement('div');
          warning.className = 'alert alert-warning py-2';
          warning.textContent = data.aiUnavailable;
          notice.appendChild(warning);
        }
        const recommendations = [
          ...(data.rules || []).map(item => ({ ...item, nodeId: item.nodeId, source: item.source })),
          ...(data.ai || []).map(item => ({ ...item, nodeId: item.nodeId, source: item.source })),
        ];
        smartRecommendations = recommendations;
        recommendations.forEach((recommendation, index) => {
          const node = smartRecommendationNode(recommendation) || {};
          const row = document.createElement('tr');
          const selectCell = document.createElement('td');
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'form-check-input smart-review-checkbox';
          checkbox.dataset.index = String(index);
          checkbox.checked = recommendation.action === 'container'
            || recommendation.action === 'skip'
            || (recommendation.confidence >= 0.85 && ![ 'split_required', 'uncertain', 'keep_ocr' ].includes(recommendation.action));
          selectCell.appendChild(checkbox);
          row.appendChild(selectCell);
          const numberCell = document.createElement('td');
          numberCell.textContent = node.originalNumber || '-';
          row.appendChild(numberCell);
          const actionCell = document.createElement('td');
          actionCell.textContent = smartActionLabel(recommendation.action);
          row.appendChild(actionCell);
          const beforeCell = document.createElement('td');
          appendText(beforeCell, node.content || '');
          row.appendChild(beforeCell);
          const afterCell = document.createElement('td');
          appendText(afterCell, recommendation.content || (recommendation.action === 'container' ? '将此节点设为章节/容器' : '将此节点跳过'));
          row.appendChild(afterCell);
          const reasonCell = document.createElement('td');
          appendText(reasonCell, (recommendation.reason || '-') + '\n置信度 ' + Math.round((recommendation.confidence || 0) * 100) + '%'
            + (recommendation.issues?.length ? '\n问题：' + recommendation.issues.join('；') : ''));
          row.appendChild(reasonCell);
          body.appendChild(row);
        });
        document.getElementById('smartReviewSummary').textContent = recommendations.length
          ? '共 ' + recommendations.length + ' 条建议；规则处理 ' + (data.rules || []).length + ' 条，AI返回 ' + (data.ai || []).length + ' 条。未勾选的建议不会改变当前草稿。'
          : '没有生成新的建议。';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('smartReviewResultModal')).show();
      };
      document.getElementById('smartReviewButton').addEventListener('click', () => {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('smartReviewSetupModal')).show();
      });
      document.getElementById('startSmartReview').addEventListener('click', async event => {
        const button = event.currentTarget;
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = '分析中…';
        try {
          const currentNodes = collectNodes().map(node => ({
            id: node.id,
            originalNumber: node.originalNumber,
            title: node.title,
            content: node.content,
            role: node.role,
          }));
          const response = await fetch('/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/smart-review', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              'x-csrf-token': '<%= csrf %>',
              accept: 'application/json',
            },
            body: JSON.stringify({
              afterOriginalNumber: document.getElementById('smartReviewAfter').value.trim(),
              nodes: currentNodes,
            }),
          });
          const body = await response.json();
          if (!response.ok) throw new Error(body.message || '智能复核失败');
          bootstrap.Modal.getOrCreateInstance(document.getElementById('smartReviewSetupModal')).hide();
          renderSmartReview(body.data || {});
        } catch (error) {
          window.showAppNotice(error.message, '智能复核失败');
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
      document.getElementById('applySmartReview').addEventListener('click', () => {
        const selectedIndices = Array.from(document.querySelectorAll('.smart-review-checkbox:checked'))
          .map(checkbox => Number(checkbox.dataset.index));
        for (const index of selectedIndices) {
          const recommendation = smartRecommendations[index];
          const node = byId.get(recommendation.nodeId);
          if (!node) continue;
          const roleSelect = document.querySelector('.node-role[data-node-id="' + node.id + '"]');
          const content = document.querySelector('.node-content[data-node-id="' + node.id + '"]');
          if (recommendation.action === 'container' || recommendation.action === 'skip') {
            if (roleSelect) roleSelect.value = recommendation.action;
            node.role = recommendation.action;
          }
          if ([ 'adopt_comparison', 'correct_ocr' ].includes(recommendation.action) && recommendation.content) {
            if (content) content.value = recommendation.content;
            node.content = recommendation.content;
          }
        }
        recalculateHierarchy();
        refreshLayout();
        updateCount();
        renderTablePage();
        markDirty();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('smartReviewResultModal')).hide();
        window.showAppNotice('已应用 ' + selectedIndices.length + ' 条智能复核建议，请保存草稿并继续人工核对。');
      });
      document.getElementById('aiReviewButton').addEventListener('click', async event => {
        const button = event.currentTarget;
        const items = selects().filter(select => select.value === 'item').map(itemPayload);
        if (!items.length) {
          window.showAppNotice('请先选择需要AI校验的标准项。');
          return;
        }
        const chunks = [];
        for (let index = 0; index < items.length; index += 10) chunks.push(items.slice(index, index + 10));
        const corrections = [];
        const originalText = button.textContent;
        button.disabled = true;
        try {
          for (let index = 0; index < chunks.length; index += 1) {
            button.textContent = 'AI校验 ' + (index + 1) + '/' + chunks.length;
            const response = await fetch('/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/ai-review', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': '<%= csrf %>',
                accept: 'application/json'
              },
              body: JSON.stringify({ nodes: chunks[index] })
            });
            const body = await response.json();
            if (!response.ok) throw new Error(body.message || 'AI校验失败');
            corrections.push(...(body.data.corrections || []));
          }
          aiCorrections = corrections;
          if (!corrections.length) {
            window.showAppNotice('AI没有发现足够明确的OCR错误。');
            return;
          }
          renderAiCorrections(corrections);
        } catch (error) {
          window.showAppNotice(error.message, 'AI校验失败');
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
      document.getElementById('applyAiCorrections').addEventListener('click', () => {
        const selectedIndices = Array.from(document.querySelectorAll('.ai-correction-checkbox:checked'))
          .map(checkbox => Number(checkbox.dataset.index));
        for (const index of selectedIndices) {
          const correction = aiCorrections[index];
          const number = document.querySelector('.node-number[data-node-id="' + correction.nodeId + '"]');
          const title = document.querySelector('.node-title[data-node-id="' + correction.nodeId + '"]');
          const content = document.querySelector('.node-content[data-node-id="' + correction.nodeId + '"]');
          if (number) number.value = correction.originalNumber;
          if (title) title.value = correction.title;
          if (content) content.value = correction.content;
          const node = byId.get(correction.nodeId);
          if (node) {
            node.originalNumber = correction.originalNumber;
            node.title = correction.title;
            node.content = correction.content;
          }
        }
        recalculateHierarchy();
        refreshLayout();
        updateCount();
        renderTablePage();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('aiCorrectionsModal')).hide();
        window.showAppNotice('已应用 ' + selectedIndices.length + ' 条AI修改建议。');
      });
      recalculateHierarchy();
      refreshLayout();
      document.getElementById('applyPdfImport').addEventListener('submit', event => {
        const items = selects().filter(select => select.value === 'item');
        if (!items.length) {
          event.preventDefault();
          window.showAppNotice('请至少选择一个标准项。');
          return;
        }
        document.getElementById('selectionInput').value = JSON.stringify(selects().map(select => ({
          id: select.dataset.nodeId,
          role: select.value,
          originalNumber: document.querySelector('.node-number[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          title: document.querySelector('.node-title[data-node-id="' + select.dataset.nodeId + '"]')?.value || '',
          content: document.querySelector('.node-content[data-node-id="' + select.dataset.nodeId + '"]')?.value || ''
        })));
      });
      applyGranularity('leaf');
    })();
  </script>
<% } %>

<% if ([ 'queued', 'processing' ].includes(job.status)) { %>
<script>
  (() => {
    const url = '/standards/versions/<%= versionId %>/pdf-imports/<%= job.id %>/status';
    const poll = async () => {
      try {
        const response = await fetch(url, { headers: { accept: 'application/json' } });
        if (!response.ok) throw new Error('状态读取失败');
        const status = await response.json();
        document.getElementById('progressBar').style.width = status.progress + '%';
        document.getElementById('progressBar').textContent = status.progress + '%';
        document.getElementById('processingMessage').textContent = !status.pageCount
          ? '正在读取PDF页数…'
          : status.progress < 10
            ? '正在检查PDF文本层或转换页面图像…'
            : '正在识别标准内容，已完成 ' + status.progress + '%';
        if (status.status === 'ready' || status.status === 'failed' || status.status === 'completed') {
          window.location.reload();
          return;
        }
      } catch {
        // A transient failure should not stop polling.
      }
      window.setTimeout(poll, 2000);
    };
    window.setTimeout(poll, 1500);
  })();
</script>
<% } %>
