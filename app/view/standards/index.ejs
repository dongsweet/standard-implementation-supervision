<%
  const buildPageUrl = targetPage => {
    const params = [];
    if (search) params.push('search=' + encodeURIComponent(search));
    if (standardType) params.push('standardType=' + encodeURIComponent(standardType));
    params.push('page=' + targetPage);
    return '?' + params.join('&');
  };
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <p class="text-secondary mb-0">规范库按“规范发布版”管理，每行是一套可被项目采用的规范内容。</p>
  <button class="btn btn-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#newStandardModal">新建规范</button>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="get" action="/standards" class="row g-2 align-items-end">
      <div class="col-12 col-md-6 col-xl-5"><label class="form-label" for="standardSearch">查找</label><input class="form-control" id="standardSearch" name="search" value="<%= search %>" placeholder="规范编号、名称或发布/制定组织"></div>
      <div class="col-12 col-md-4 col-xl-3"><label class="form-label" for="standardTypeFilter">规范类型</label><select class="form-select" id="standardTypeFilter" name="standardType"><option value="">全部类型</option><% standardTypes.forEach(type => { %><option value="<%= type.value %>" <%= standardType === type.value ? 'selected' : '' %>><%= type.label %></option><% }) %></select></div>
      <div class="col-12 col-md-2 col-xl-2 d-flex gap-2"><button class="btn btn-outline-primary flex-fill" type="submit">查找</button><a class="btn btn-outline-secondary" href="/standards">重置</a></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex align-items-center"><h3 class="card-title">规范发布版</h3><span class="badge text-bg-secondary ms-auto"><%= total %> 条</span></div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>规范类型</th><th>规范编号</th><th>规范名称</th><th>发布/制定组织</th><th>发布版</th><th>状态</th><th>章节数</th><th>标准项数</th><th>发布时间</th><th>操作</th></tr></thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr>
            <td><span class="badge text-bg-light"><%= typeLabels[row.standard_type] || row.standard_type %></span></td>
            <td><strong><%= row.code %></strong></td>
            <td><div><%= row.name %></div><% if (row.description) { %><div class="small text-secondary text-truncate" style="max-width:260px" title="<%= row.description %>"><%= row.description %></div><% } %></td>
            <td><%= row.issuing_organization || '-' %></td>
            <td><strong><%= row.version %></strong></td>
            <td><span class="badge <%= row.status === 'published' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= row.status === 'published' ? '已发布' : '草稿' %></span></td>
            <td><%= row.chapter_count %></td>
            <td><%= row.item_count %></td>
            <td><%= row.published_at ? new Date(row.published_at).toLocaleDateString('zh-CN') : '-' %></td>
            <td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="/standards/versions/<%= row.version_id %>">维护内容</a> <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#newVersionModal" data-standard-id="<%= row.standard_id %>" data-standard-label="<%= row.code %> · <%= row.name %>">新增发布版</button></td>
          </tr>
        <% }) %>
        <% if (!rows.length) { %><tr><td colspan="10" class="text-center text-secondary py-5">没有找到匹配的规范发布版。</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <% if (pageCount > 1) { %>
    <div class="card-footer d-flex flex-wrap align-items-center gap-2">
      <span class="small text-secondary">第 <%= page %> / <%= pageCount %> 页</span>
      <nav class="ms-auto" aria-label="规范库分页"><ul class="pagination pagination-sm mb-0">
        <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= page <= 1 ? '#' : buildPageUrl(page - 1) %>">上一页</a></li>
        <% for (let number = 1; number <= pageCount; number += 1) { %><li class="page-item <%= number === page ? 'active' : '' %>"><a class="page-link" href="<%= buildPageUrl(number) %>"><%= number %></a></li><% } %>
        <li class="page-item <%= page >= pageCount ? 'disabled' : '' %>"><a class="page-link" href="<%= page >= pageCount ? '#' : buildPageUrl(page + 1) %>">下一页</a></li>
      </ul></nav>
    </div>
  <% } %>
</div>

<div class="modal fade" id="newStandardModal" tabindex="-1" aria-labelledby="newStandardModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/standards"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="newStandardModalLabel">新建规范及首个发布版</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-md-4"><label class="form-label" for="standardType">规范类型</label><select class="form-select" id="standardType" name="standardType" required><% standardTypes.forEach(type => { %><option value="<%= type.value %>" <%= type.value === 'national' ? 'selected' : '' %>><%= type.label %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label" for="standardCode">规范编号</label><input class="form-control" id="standardCode" name="code" placeholder="例如：GB/T 31168" required></div>
      <div class="col-md-4"><label class="form-label" for="standardVersion">发布版</label><input class="form-control" id="standardVersion" name="version" placeholder="例如：2023年发布版" required></div>
      <div class="col-md-8"><label class="form-label" for="standardName">规范名称</label><input class="form-control" id="standardName" name="name" required></div>
      <div class="col-md-4"><label class="form-label" for="issuingOrganization">发布/制定组织</label><input class="form-control" id="issuingOrganization" name="issuingOrganization" placeholder="例如：国家标准化管理委员会"></div>
      <div class="col-12"><label class="form-label" for="standardDescription">规范说明</label><textarea class="form-control" id="standardDescription" name="description" rows="2"></textarea></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存规范</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="newVersionModal" tabindex="-1" aria-labelledby="newVersionModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form id="newVersionForm" method="post" action="/standards"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="newVersionModalLabel">新增规范发布版</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><p id="newVersionStandardLabel" class="mb-3"></p><label class="form-label" for="newVersionNumber">发布版</label><input class="form-control" id="newVersionNumber" name="version" placeholder="例如：2026年修订版" required><div class="form-text">发布版用于区分同一规范在不同时间发布的内容。</div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">创建草稿发布版</button></div>
  </form>
</div></div></div>
<script>
  document.getElementById('newVersionModal').addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    document.getElementById('newVersionForm').action = '/standards/' + button.dataset.standardId + '/versions';
    document.getElementById('newVersionStandardLabel').textContent = button.dataset.standardLabel;
    document.getElementById('newVersionNumber').value = '';
  });
</script>
