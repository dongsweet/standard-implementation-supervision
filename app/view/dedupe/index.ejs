<p class="text-secondary mb-3">规则筛选 → AI 判断 → 人工确认；AI 不会自动归并定义。</p>
<div class="card">
  <div class="card-header"><h3 class="card-title">待复核候选</h3></div>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead><tr><th>定义 A</th><th>定义 B</th><th>候选类型</th><th>关联标准项</th><th>历史执行</th><th>人工复核操作</th></tr></thead>
      <tbody>
        <% candidates.forEach(item => { %>
          <tr>
            <td><strong><%= item.object_name %></strong><div class="small text-secondary"><%= item.object_category || '-' %> · <%= item.check_layer || '-' %></div><div class="mt-1"><b>方法：</b><%= item.check_method %></div><div><b>描述：</b><%= item.description %></div><div><b>步骤：</b><%= item.steps || '-' %></div><div><b>频率/方式：</b><%= item.frequency || '-' %> / <%= item.access_mode || '-' %></div></td>
            <td><strong><%= item.candidate_object_name %></strong><div class="small text-secondary"><%= item.candidate_object_category || '-' %> · <%= item.candidate_check_layer || '-' %></div><div class="mt-1"><b>方法：</b><%= item.candidate_check_method %></div><div><b>描述：</b><%= item.candidate_description %></div><div><b>步骤：</b><%= item.candidate_steps || '-' %></div><div><b>频率/方式：</b><%= item.candidate_frequency || '-' %> / <%= item.candidate_access_mode || '-' %></div></td>
            <td><span class="badge <%= item.candidate_type === 'exact_duplicate_candidate' ? 'text-bg-danger' : 'text-bg-warning' %>"><%= item.candidate_type === 'exact_duplicate_candidate' ? '完全重复候选' : '相似候选' %></span><div class="small mt-1">相似度 <%= Number(item.similarity_score || 0).toFixed(3) %></div></td>
            <td><div>A：<%= (item.standard_item_codes || []).join(', ') || '无' %></div><div>B：<%= (item.candidate_standard_item_codes || []).join(', ') || '无' %></div></td>
            <td><div>A：<%= item.execution_count || 0 %></div><div>B：<%= item.candidate_execution_count || 0 %></div></td>
            <td class="text-nowrap"><button class="btn btn-sm btn-outline-primary mb-1" data-left="<%= item.id %>" data-right="<%= item.candidate_id %>" onclick="aiReview(this)">AI 分析</button><br>
              <button class="btn btn-sm btn-danger mb-1" onclick="humanReview('<%= item.id %>','<%= item.candidate_id %>','duplicate','<%= item.id %>')">确认重复，保留 A</button><br>
              <button class="btn btn-sm btn-outline-secondary mb-1" onclick="humanReview('<%= item.id %>','<%= item.candidate_id %>','similar_but_distinct')">相似但不归并</button><br>
              <button class="btn btn-sm btn-outline-secondary" onclick="humanReview('<%= item.id %>','<%= item.candidate_id %>','unrelated')">判定无关</button><br>
              <button class="btn btn-sm btn-outline-secondary mt-1" onclick="humanReview('<%= item.id %>','<%= item.candidate_id %>','uncertain')">待进一步确认</button></td>
          </tr>
        <% }) %>
        <% if (!candidates.length) { %><tr><td colspan="6" class="text-center text-secondary p-4">暂无候选。维护监督定义后，规则层会生成去重候选。</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<div class="modal fade" id="dedupeResultModal" tabindex="-1" aria-labelledby="dedupeResultModalTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h2 class="modal-title fs-5" id="dedupeResultModalTitle">AI 分析结果</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
  <div class="modal-body"><pre class="mb-0 text-wrap" id="dedupeResultModalBody"></pre></div>
  <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">关闭</button></div>
</div></div></div>
<script>
  const csrfToken = '<%= csrf %>';
  async function send(path, body) {
    const response = await fetch(path, { method: 'POST', headers: { 'content-type': 'application/json', 'x-csrf-token': csrfToken }, body: JSON.stringify(body) });
    const data = await response.json();
    if (!response.ok) throw new Error(data.message || '请求失败');
    return data.data;
  }
  async function aiReview(button) {
    button.disabled = true;
    try {
      const job = await send('/api/dedupe/ai-review', { leftId: button.dataset.left, rightId: button.dataset.right });
      document.getElementById('dedupeResultModalBody').textContent = JSON.stringify(job.result || job, null, 2);
      bootstrap.Modal.getOrCreateInstance(document.getElementById('dedupeResultModal')).show();
    }
    catch (error) { window.showAppNotice(error.message, 'AI 分析未完成'); }
    finally { button.disabled = false; }
  }
  async function humanReview(leftId, rightId, decision, canonicalId) {
    const labels = { duplicate: '确认这两条定义重复并归并', similar_but_distinct: '标记为相似但不归并', unrelated: '标记为无关', uncertain: '标记为待进一步确认' };
    if (!await window.confirmAppAction(`${labels[decision]}？`, '确认人工复核结论')) return;
    const body = { leftId, rightId, decision, canonicalId, confirmConflicts: false };
    try { await send('/api/dedupe/reviews', body); window.location.assign('/dedupe?notice=' + encodeURIComponent('人工复核结论已保存')); }
    catch (error) {
      if (decision === 'duplicate' && error.message.includes('字段冲突')) {
        const confirmed = await window.confirmAppAction(`${error.message}。仍要归并并保留所选主定义吗？`, '归并字段冲突');
        if (!confirmed) return;
        try { body.confirmConflicts = true; await send('/api/dedupe/reviews', body); window.location.assign('/dedupe?notice=' + encodeURIComponent('定义已按确认归并')); }
        catch (retryError) { window.showAppNotice(retryError.message, '归并失败'); }
        return;
      }
      window.showAppNotice(error.message, '复核未完成');
    }
  }
</script>
