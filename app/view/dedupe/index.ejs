<%
  const thresholdValue = typeof queryThreshold === 'number' && Number.isFinite(queryThreshold) ? queryThreshold : 0.6;
  const hasResults = typeof scanned !== 'undefined' && scanned;
  const activeFilter = [ 'all', 'ai_duplicate', 'ai_excluded', 'ai_pending' ].includes(filter) ? filter : 'all';
  const filterLabels = {
    all: '规则候选',
    ai_duplicate: 'AI 判重',
    ai_excluded: 'AI 排除',
    ai_pending: '待 AI 判断',
  };
  const filterUrl = value => `/dedupe?run=1&threshold=${encodeURIComponent(thresholdValue)}&filter=${value}`;
  const numberLabel = value => value ? String(value).padStart(3, '0') : '未编号';
  const booleanLabel = value => value === true ? '是' : value === false ? '否' : '未指定';
  const comparisonValue = value => {
    if (Array.isArray(value)) return value.map(item => String(item || '').normalize('NFKC').trim()).sort().join('|');
    if (typeof value === 'boolean') return value ? 'yes' : 'no';
    return String(value ?? '').normalize('NFKC').replace(/\s+/g, ' ').trim();
  };
  const definitionComparisonFields = item => [
    { key: 'object_name', label: '检查对象', left: item.object_name, right: item.candidate_object_name },
    { key: 'object_category', label: '对象分类', left: item.object_category, right: item.candidate_object_category },
    { key: 'check_layer', label: '检查层面', left: item.check_layer, right: item.candidate_check_layer },
    { key: 'centers', label: '适用机构', left: item.centers, right: item.candidate_centers },
    { key: 'check_method', label: '检查方法', left: item.check_method, right: item.candidate_check_method },
    { key: 'description', label: '检查描述', left: item.description, right: item.candidate_description },
    { key: 'scope', label: '检查范围', left: item.scope, right: item.candidate_scope },
    { key: 'recognized_object', label: '是否公认对象', left: item.recognized_object, right: item.candidate_recognized_object },
    { key: 'priority', label: '重点项', left: item.priority, right: item.candidate_priority },
    { key: 'steps', label: '检查步骤', left: item.steps, right: item.candidate_steps },
    { key: 'frequency', label: '执行频率', left: item.frequency, right: item.candidate_frequency },
    { key: 'access_mode', label: '执行方式', left: item.access_mode, right: item.candidate_access_mode },
    { key: 'standard_items', label: '关联标准项', left: item.standard_item_codes, right: item.candidate_standard_item_codes },
    { key: 'reference_result', label: '参考判定描述', left: item.reference_result, right: item.candidate_reference_result },
    { key: 'reference_materials', label: '参考材料', left: item.reference_materials, right: item.candidate_reference_materials },
  ];
  const definitionDifferences = item => definitionComparisonFields(item)
    .filter(field => comparisonValue(field.left) !== comparisonValue(field.right));
  const comparisonDisplay = (value, key) => {
    if (key === 'recognized_object') return booleanLabel(value);
    if (Array.isArray(value)) return value.join('、') || (key === 'standard_items' ? '无' : '未指定');
    return String(value ?? '').trim() || '-';
  };
  const escapeDiffHtml = value => String(value ?? '').replace(/[&<>"']/g, character => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  })[character]);
  const renderComparisonMarkup = (left, right, side, key) => {
    const leftText = comparisonDisplay(left, key);
    const rightText = comparisonDisplay(right, key);
    if (comparisonValue(left) === comparisonValue(right)) return escapeDiffHtml(leftText);
    const leftCharacters = Array.from(leftText);
    const rightCharacters = Array.from(rightText);
    let prefixLength = 0;
    while (prefixLength < leftCharacters.length
      && prefixLength < rightCharacters.length
      && leftCharacters[prefixLength] === rightCharacters[prefixLength]) {
      prefixLength += 1;
    }
    let leftEnd = leftCharacters.length;
    let rightEnd = rightCharacters.length;
    while (leftEnd > prefixLength
      && rightEnd > prefixLength
      && leftCharacters[leftEnd - 1] === rightCharacters[rightEnd - 1]) {
      leftEnd -= 1;
      rightEnd -= 1;
    }
    const characters = side === 'left' ? leftCharacters : rightCharacters;
    const end = side === 'left' ? leftEnd : rightEnd;
    const prefix = characters.slice(0, prefixLength).join('');
    const changed = characters.slice(prefixLength, end).join('');
    const suffix = characters.slice(end).join('');
    return escapeDiffHtml(prefix)
      + (changed ? `<mark class="definition-diff-fragment">${escapeDiffHtml(changed)}</mark>` : '')
      + escapeDiffHtml(suffix);
  };
%>
<style>
  .definition-filter-cards a.card { transition: border-color 120ms ease, box-shadow 120ms ease; }
  .definition-filter-cards a.card:hover { border-color: var(--bs-primary); box-shadow: 0 .25rem .75rem rgba(13, 110, 253, .12); }
  .definition-filter-cards a.card:focus-visible { outline: 2px solid var(--bs-primary); outline-offset: 2px; }
  .definition-diff-fragment { color: #b42318 !important; background: #fff1f0; border-radius: .15rem; padding: 0 .08rem; box-decoration-break: clone; -webkit-box-decoration-break: clone; font-weight: 600; }
  .definition-diff-summary { line-height: 1.7; }
  details.definition-details-different { border-left: 3px solid #dc3545; padding-left: .5rem; }
  .definition-merge-template .btn-check:checked + .btn { color: #fff; background: #0d6efd; border-color: #0d6efd; }
  .definition-merge-picker { position: relative; }
  .definition-merge-results { position: relative; z-index: 1080; width: 100%; max-height: 14rem; overflow-y: auto; }
  .definition-merge-chip { max-width: 100%; white-space: normal; text-align: left; }
  #definitionMergeForm { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0; max-height: 100%; }
  #definitionMergeForm > .modal-body { min-height: 0; overflow-y: auto; }
  #definitionMergeForm > .modal-footer { flex: 0 0 auto; background: #fff; }
</style>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div>
    <h2 class="h4 mb-1">检查方案去重复核</h2>
    <p class="text-secondary mb-0">按门限筛选同一检查对象下的方案候选，再直接人工确认；AI 语义复核仅作可选辅助，不会自动归并。</p>
  </div>
  <div class="ms-auto d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/dedupe/history">查看复核历史</a>
    <a class="btn btn-outline-secondary" href="/supervision-definitions">返回检查方案</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <div class="row g-3 align-items-end">
      <div class="col-12 col-md-5">
        <label class="form-label" for="definitionThreshold">规则预筛门限</label>
        <div class="input-group">
          <span class="input-group-text">内容相似度 ≥</span>
          <input class="form-control" id="definitionThreshold" type="number" min="0" max="1" step="0.01" value="<%= thresholdValue %>">
        </div>
      </div>
      <div class="col-12 col-md-7 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" type="button" id="runDefinitionRuleScreen" onclick="runDefinitionRuleScreen(this)">运行规则筛选</button>
        <% if (hasResults && summary.aiPendingCount) { %><button class="btn btn-outline-primary" type="button" id="runDefinitionAiScreen" data-pending="<%= summary.aiPendingCount %>" onclick="runDefinitionAiScreen(this)">可选 AI 语义复核（<%= summary.aiPendingCount %>）</button><% } %>
      </div>
    </div>
    <div class="form-text mt-2">门限可填写 0～1。只比较同一检查对象、同对象分类、同检查层面的方案；进入页面不会自动扫描，也不会自动调用 AI。</div>
  </div>
</div>

<% if (!hasResults) { %>
<div class="card mb-3"><div class="card-body text-center text-secondary py-5">
  <div class="fs-5 mb-2">尚未运行规则筛选</div>
  <div>填写门限后点击“运行规则筛选”。检查方案候选和历史记录不会在进入页面时自动加载。</div>
</div></div>
<% } else { %>
<div class="row g-3 mb-3 definition-filter-cards">
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'all' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('all') %>" <%= activeFilter === 'all' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">规则候选</div><% if (activeFilter === 'all') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold"><%= summary.candidateCount %></div><div class="small text-secondary">内容相似度 ≥ <%= thresholdValue %></div></div></a></div>
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'ai_duplicate' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('ai_duplicate') %>" <%= activeFilter === 'ai_duplicate' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">AI 判重</div><% if (activeFilter === 'ai_duplicate') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold text-danger"><%= summary.aiDuplicateCount %></div><div class="small text-secondary">可选复核结果</div></div></a></div>
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'ai_excluded' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('ai_excluded') %>" <%= activeFilter === 'ai_excluded' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">AI 排除</div><% if (activeFilter === 'ai_excluded') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold text-success"><%= summary.aiExcludedCount %></div><div class="small text-secondary">相似但不同或无关</div></div></a></div>
  <div class="col-6 col-lg-3"><a class="card h-100 text-reset text-decoration-none <%= activeFilter === 'ai_pending' ? 'border-primary shadow-sm' : '' %>" href="<%= filterUrl('ai_pending') %>" <%= activeFilter === 'ai_pending' ? 'aria-current="page"' : '' %>><div class="card-body"><div class="d-flex align-items-center justify-content-between"><div class="small text-secondary">待 AI 判断</div><% if (activeFilter === 'ai_pending') { %><span class="badge text-bg-primary">当前</span><% } %></div><div class="fs-3 fw-semibold text-warning"><%= summary.aiPendingCount %></div><div class="small text-secondary">不影响人工判断</div></div></a></div>
</div>

<section class="card mb-3">
  <div class="card-header d-flex align-items-center gap-2"><h3 class="card-title">检查方案筛选结果</h3><span class="badge text-bg-primary">当前：<%= filterLabels[activeFilter] %></span><span class="badge text-bg-secondary ms-auto"><%= candidates.length %> 组</span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th style="width:10rem">方案编号</th><th>检查内容 A</th><th>检查内容 B</th><th style="width:14rem">筛选结论</th><th style="width:25rem">人工复核</th></tr></thead>
    <tbody>
      <% candidates.forEach(item => {
        const differences = definitionDifferences(item);
        const comparisonFields = new Map(definitionComparisonFields(item).map(field => [ field.key, field ]));
        const diffValue = (key, side) => {
          const field = comparisonFields.get(key) || { left: '', right: '' };
          return renderComparisonMarkup(field.left, field.right, side, key);
        };
        const hiddenDifference = [ 'scope', 'recognized_object', 'priority', 'steps', 'frequency', 'access_mode', 'standard_items', 'reference_result', 'reference_materials' ].some(key => differences.some(field => field.key === key));
      %>
        <tr>
          <td>
            <div class="d-flex align-items-center gap-2 mb-1"><span class="badge text-bg-light border">A · <%= numberLabel(item.plan_number) %></span><span class="small text-secondary">执行 <%= item.execution_count || 0 %> 次</span></div>
            <div class="d-flex align-items-center gap-2"><span class="badge text-bg-light border">B · <%= numberLabel(item.candidate_plan_number) %></span><span class="small text-secondary">执行 <%= item.candidate_execution_count || 0 %> 次</span></div>
          </td>
          <td>
            <strong><%- diffValue('object_name', 'left') %></strong>
            <div class="small text-secondary mt-1"><%- diffValue('object_category', 'left') %> · <%- diffValue('check_layer', 'left') %> · 适用机构：<%- diffValue('centers', 'left') %></div>
            <div class="small mt-1"><b>方法：</b><%- diffValue('check_method', 'left') %></div>
            <div class="small"><b>描述：</b><%- diffValue('description', 'left') %></div>
            <details class="small mt-1 <%= hiddenDifference ? 'definition-details-different' : '' %>" <%= hiddenDifference ? 'open' : '' %>><summary>查看步骤、频率和标准项<%= hiddenDifference ? '（差异已展开）' : '' %></summary><div class="mt-1"><b>步骤：</b><%- diffValue('steps', 'left') %></div><div><b>频率/方式：</b><%- diffValue('frequency', 'left') %> / <%- diffValue('access_mode', 'left') %></div><div><b>标准项：</b><%- diffValue('standard_items', 'left') %></div><div><b>检查范围：</b><%- diffValue('scope', 'left') %></div><div><b>方案属性：</b>公认对象：<%- diffValue('recognized_object', 'left') %> · 重点项：<%- diffValue('priority', 'left') %></div><div><b>参考判定：</b><%- diffValue('reference_result', 'left') %></div><div><b>参考材料：</b><%- diffValue('reference_materials', 'left') %></div></details>
          </td>
          <td>
            <strong><%- diffValue('object_name', 'right') %></strong>
            <div class="small text-secondary mt-1"><%- diffValue('object_category', 'right') %> · <%- diffValue('check_layer', 'right') %> · 适用机构：<%- diffValue('centers', 'right') %></div>
            <div class="small mt-1"><b>方法：</b><%- diffValue('check_method', 'right') %></div>
            <div class="small"><b>描述：</b><%- diffValue('description', 'right') %></div>
            <details class="small mt-1 <%= hiddenDifference ? 'definition-details-different' : '' %>" <%= hiddenDifference ? 'open' : '' %>><summary>查看步骤、频率和标准项<%= hiddenDifference ? '（差异已展开）' : '' %></summary><div class="mt-1"><b>步骤：</b><%- diffValue('steps', 'right') %></div><div><b>频率/方式：</b><%- diffValue('frequency', 'right') %> / <%- diffValue('access_mode', 'right') %></div><div><b>标准项：</b><%- diffValue('standard_items', 'right') %></div><div><b>检查范围：</b><%- diffValue('scope', 'right') %></div><div><b>方案属性：</b>公认对象：<%- diffValue('recognized_object', 'right') %> · 重点项：<%- diffValue('priority', 'right') %></div><div><b>参考判定：</b><%- diffValue('reference_result', 'right') %></div><div><b>参考材料：</b><%- diffValue('reference_materials', 'right') %></div></details>
          </td>
          <td>
            <div class="definition-diff-summary mb-2">
              <% if (differences.length) { %>
                <div class="small text-danger fw-semibold mb-1">发现 <%= differences.length %> 项差异</div>
                <div class="d-flex flex-wrap gap-1"><% differences.forEach(field => { %><span class="badge text-bg-danger"><%= field.label %></span><% }) %></div>
              <% } else { %>
                <span class="badge text-bg-success">比对字段一致</span>
              <% } %>
            </div>
            <span class="badge <%= item.candidate_type === 'exact_duplicate_candidate' ? 'text-bg-danger' : 'text-bg-warning' %>"><%= item.candidate_type === 'exact_duplicate_candidate' ? '规范化内容相同' : '内容相似' %></span>
            <div class="small mt-1">相似度 <%= Number(item.similarity_score || 0).toFixed(3) %></div>
            <% if (item.ai) { %><div class="mt-1"><span class="badge <%= item.ai.relation === 'duplicate' ? 'text-bg-danger' : 'text-bg-success' %>"><%= item.ai.relation === 'duplicate' ? 'AI 判重' : item.ai.relation === 'unrelated' ? 'AI 判无关' : item.ai.relation === 'similar_but_distinct' ? 'AI 判不同' : 'AI 不确定' %></span></div><div class="small text-secondary mt-1">置信度 <%= Number(item.ai.confidence || 0).toFixed(3) %></div><div class="small text-secondary"><%= item.ai.reason || '-' %></div><% } %><% if (item.ai_status === 'failed') { %><div class="small text-danger mt-1">上次 AI 分析失败，不影响人工判断</div><% } %>
          </td>
          <td>
            <div class="d-flex flex-column align-items-start gap-1">
              <button class="btn btn-sm btn-primary text-nowrap" type="button" data-left="<%= item.id %>" data-right="<%= item.candidate_id %>" onclick="openDefinitionMergeEditor(this)">合并并编辑</button>
              <div class="d-flex flex-nowrap gap-1">
                <button class="btn btn-sm btn-danger text-nowrap" type="button" onclick="definitionReview('<%= item.id %>','<%= item.candidate_id %>','duplicate','<%= item.id %>')">保留 A 并合并</button>
                <button class="btn btn-sm btn-danger text-nowrap" type="button" onclick="definitionReview('<%= item.id %>','<%= item.candidate_id %>','duplicate','<%= item.candidate_id %>')">保留 B 并合并</button>
              </div>
              <div class="d-flex flex-nowrap gap-1">
                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" onclick="definitionReview('<%= item.id %>','<%= item.candidate_id %>','similar_but_distinct')">相似但不归并</button>
                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" onclick="definitionReview('<%= item.id %>','<%= item.candidate_id %>','unrelated')">判定无关</button>
              </div>
              <div class="d-flex flex-nowrap gap-1">
                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" onclick="definitionReview('<%= item.id %>','<%= item.candidate_id %>','uncertain')">待进一步确认</button>
                <button class="btn btn-sm btn-outline-primary text-nowrap" type="button" data-left="<%= item.id %>" data-right="<%= item.candidate_id %>" onclick="definitionAiReview(this)">可选 AI 分析</button>
              </div>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (!candidates.length) { %><tr><td colspan="5" class="text-center text-secondary py-5">当前门限和筛选条件下没有检查方案候选。</td></tr><% } %>
    </tbody>
  </table></div>
</section>
<% } %>

<div class="modal fade" id="definitionMergeModal" tabindex="-1" aria-labelledby="definitionMergeModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form id="definitionMergeForm" class="definition-merge-form">
    <div class="modal-header"><div><h2 class="modal-title fs-5" id="definitionMergeModalLabel">合并并编辑检查方案</h2><div class="small text-secondary mt-1">选择一个模板并修改最终内容；所选模板对应的检查方案将被保留，另一条标记为已合并。</div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="mb-3"><label class="form-label d-block">以哪个方案为模板</label><div class="d-flex flex-wrap gap-2 definition-merge-template" id="definitionMergeTemplates"></div><div class="form-text">切换模板会用该方案当前内容覆盖下方表单，请先完成模板选择。</div></div>
      <div class="row g-3">
        <div class="col-md-8"><label class="form-label" for="definitionMergeObjectName">检查对象</label><input class="form-control" id="definitionMergeObjectName" maxlength="500" required list="definitionMergeObjectNames"><datalist id="definitionMergeObjectNames"></datalist></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergeObjectCategory">对象分类</label><input class="form-control" id="definitionMergeObjectCategory" maxlength="200" list="definitionMergeCategoryNames"><datalist id="definitionMergeCategoryNames"></datalist></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergeCheckLayer">检查层面</label><input class="form-control" id="definitionMergeCheckLayer" maxlength="200"></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergeFrequency">执行频率</label><input class="form-control" id="definitionMergeFrequency" maxlength="100"></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergeAccessMode">远程/现场查看</label><select class="form-select" id="definitionMergeAccessMode"><option value="">未指定</option><option value="远程">远程</option><option value="现场">现场</option><option value="远程+现场">远程+现场</option></select></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergeRecognizedObject">是否公认对象</label><select class="form-select" id="definitionMergeRecognizedObject"><option value="">未指定</option><option value="true">是</option><option value="false">否</option></select></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergePriority">重点项</label><select class="form-select" id="definitionMergePriority"><option value="">未指定</option><option value="重点项">重点项</option><option value="非重点项">非重点项</option></select></div>
        <div class="col-md-4"><label class="form-label" for="definitionMergeScope">检查范围</label><input class="form-control" id="definitionMergeScope" maxlength="200"></div>
        <div class="col-12"><label class="form-label d-block">适用机构</label><div class="d-flex flex-wrap gap-2" id="definitionMergeCenters"></div></div>
        <div class="col-12"><label class="form-label d-block">检查方法</label><div class="d-flex flex-wrap gap-2" id="definitionMergeMethods"></div></div>
        <div class="col-md-6"><label class="form-label" for="definitionMergeAdditionalMethods">其他检查方法</label><input class="form-control" id="definitionMergeAdditionalMethods" placeholder="多个方法用逗号分隔"></div>
        <div class="col-12"><label class="form-label" for="definitionMergeDescription">检查项描述</label><textarea class="form-control" id="definitionMergeDescription" rows="3" maxlength="5000" required></textarea></div>
        <div class="col-12"><label class="form-label" for="definitionMergeSteps">检查步骤</label><textarea class="form-control" id="definitionMergeSteps" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label" for="definitionMergeReferenceResult">参考判定描述</label><textarea class="form-control" id="definitionMergeReferenceResult" rows="2"></textarea></div>
        <div class="col-md-6"><label class="form-label" for="definitionMergeReferenceMaterials">参考材料</label><textarea class="form-control" id="definitionMergeReferenceMaterials" rows="2"></textarea></div>
        <div class="col-12">
          <label class="form-label" for="definitionMergeStandardSearch">关联标准项</label>
          <div class="definition-merge-picker">
            <div class="d-flex flex-wrap gap-2 mb-2" id="definitionMergeStandardChips"></div>
            <input class="form-control" id="definitionMergeStandardSearch" type="search" autocomplete="off" placeholder="输入标准编号、条款编号或内容搜索添加">
            <div class="definition-merge-results list-group shadow-sm mt-1 d-none" id="definitionMergeStandardResults"></div>
          </div>
        </div>
      </div>
      <div class="alert alert-danger mt-3 mb-0 d-none" id="definitionMergeError"></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit" id="definitionMergeSubmit">保存编辑并合并</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="definitionAiProgressModal" tabindex="-1" aria-labelledby="definitionAiProgressTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <div class="modal-header"><h2 class="modal-title fs-5" id="definitionAiProgressTitle">检查方案 AI 复核进度</h2></div>
  <div class="modal-body">
    <div class="d-flex align-items-center gap-2 mb-2"><span class="spinner-border spinner-border-sm text-primary" id="definitionAiProgressSpinner" aria-hidden="true"></span><strong id="definitionAiProgressStatus" aria-live="polite">正在准备提交第一批...</strong></div>
    <div class="progress mb-2" role="progressbar" aria-label="检查方案 AI 复核进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-bar progress-bar-striped progress-bar-animated" id="definitionAiProgressBar" style="width:0%"></div></div>
    <div class="d-flex justify-content-between small text-secondary"><span id="definitionAiProgressCount">成功 0 / 0 组</span><span id="definitionAiProgressBatch">批次 0</span></div>
    <div class="alert alert-danger mt-3 mb-0 d-none" id="definitionAiProgressError"></div>
    <div class="form-text mt-2">每批最多 4 组。AI 只提供判断，完成前不会自动归并任何检查方案。</div>
  </div>
  <div class="modal-footer"><button class="btn btn-outline-secondary" id="definitionAiProgressClose" type="button" data-bs-dismiss="modal" disabled>关闭</button></div>
</div></div></div>

<div class="modal fade" id="definitionAiResultModal" tabindex="-1" aria-labelledby="definitionAiResultTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h2 class="modal-title fs-5" id="definitionAiResultTitle">检查方案 AI 建议</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
  <div class="modal-body"><pre class="mb-0 text-wrap" id="definitionAiResultBody"></pre></div>
  <div class="modal-footer"><button class="btn btn-primary" type="button" data-bs-dismiss="modal">关闭</button></div>
</div></div></div>

<script>
  const dedupeCsrfToken = '<%= csrf %>';
  const currentDefinitionFilter = '<%= activeFilter %>';
  const mergeNumberLabel = value => value ? String(value).padStart(3, '0') : '未编号';
  const currentDefinitionThreshold = () => {
    const threshold = Number(document.getElementById('definitionThreshold').value);
    if (!Number.isFinite(threshold) || threshold < 0 || threshold > 1) {
      throw new Error('检查方案相似度门限必须是 0 到 1 之间的数字');
    }
    return threshold;
  };
  const dedupeReloadUrl = (notice, filterOverride = currentDefinitionFilter) => {
    const params = new URLSearchParams({ run: '1', threshold: currentDefinitionThreshold(), filter: filterOverride });
    if (notice) params.set('notice', notice);
    return `/dedupe?${params.toString()}`;
  };
  async function dedupeSend(path, body, method = 'POST') {
    const options = { method, headers: { 'x-csrf-token': dedupeCsrfToken } };
    if (method !== 'GET') {
      options.headers['content-type'] = 'application/json';
      options.body = JSON.stringify(body);
    }
    const response = await fetch(path, options);
    const data = await response.json();
    if (!response.ok) throw new Error(data.message || '请求失败');
    return data.data;
  }
  function runDefinitionRuleScreen(button) {
    button.disabled = true;
    try {
      window.location.assign(dedupeReloadUrl(null, 'all'));
    } catch (error) {
      button.disabled = false;
      window.showAppNotice(error.message, '规则筛选未完成');
    }
  }
  async function definitionAiReview(button) {
    button.disabled = true;
    try {
      const job = await dedupeSend('/api/dedupe/ai-review', { leftId: button.dataset.left, rightId: button.dataset.right });
      document.getElementById('definitionAiResultBody').textContent = JSON.stringify(job.result || job, null, 2);
      bootstrap.Modal.getOrCreateInstance(document.getElementById('definitionAiResultModal')).show();
    } catch (error) {
      window.showAppNotice(error.message, 'AI 分析未完成');
    } finally {
      button.disabled = false;
    }
  }
  function renderDefinitionAiProgress({ status, bar, success = 0, failed = 0, total, batch, error = '' }) {
    document.getElementById('definitionAiProgressStatus').textContent = status;
    document.getElementById('definitionAiProgressCount').textContent = `成功 ${success} / ${total} 组${failed ? `，失败 ${failed} 组` : ''}`;
    document.getElementById('definitionAiProgressBatch').textContent = `批次 ${batch}`;
    const percentage = total > 0 ? Math.min(100, Math.round(success * 100 / total)) : 0;
    const progressBar = document.getElementById('definitionAiProgressBar');
    progressBar.style.width = `${bar ?? percentage}%`;
    progressBar.parentElement.setAttribute('aria-valuenow', String(bar ?? percentage));
    const errorBox = document.getElementById('definitionAiProgressError');
    errorBox.textContent = error;
    errorBox.classList.toggle('d-none', !error);
    document.getElementById('definitionAiProgressSpinner').classList.toggle('d-none', Boolean(error));
    document.getElementById('definitionAiProgressClose').disabled = !error;
  }
  async function runDefinitionAiScreen(button) {
    button.disabled = true;
    const total = Number(button.dataset.pending) || 0;
    let processed = 0;
    let errors = 0;
    let batchNumber = 0;
    renderDefinitionAiProgress({ status: '正在准备提交第一批 AI 语义复核...', success: 0, total, batch: 0 });
    bootstrap.Modal.getOrCreateInstance(document.getElementById('definitionAiProgressModal')).show();
    try {
      const threshold = currentDefinitionThreshold();
      while (true) {
        batchNumber += 1;
        renderDefinitionAiProgress({ status: `正在提交第 ${batchNumber} 批（每批最多 4 组）...`, success: processed, failed: errors, total, batch: batchNumber });
        const result = await dedupeSend('/api/dedupe/ai-screen', { batchSize: 4, threshold });
        processed += Number(result.processedCount || 0);
        errors += Number(result.errorCount || 0);
        const handled = processed + errors;
        const effectiveTotal = Math.max(total, Number(result.totalCount || 0), handled);
        renderDefinitionAiProgress({
          status: result.errorCount ? `第 ${batchNumber} 批 AI 复核失败` : `第 ${batchNumber} 批已完成，继续处理剩余候选...`,
          success: processed,
          failed: errors,
          total: effectiveTotal,
          batch: batchNumber,
        });
        if (result.errorCount) {
          const message = result.errors?.[0]?.message || 'AI 服务请求失败';
          renderDefinitionAiProgress({
            status: '检查方案 AI 复核已停止',
            success: processed,
            failed: errors,
            total: effectiveTotal,
            batch: batchNumber,
            error: `${String(message).replace(/[。；]+$/, '')}。已完成判断会保留；修复 AI 服务后可继续重试。`,
          });
          window.showAppNotice(message, '可选 AI 复核未完成');
          return;
        }
        if (result.done || Number(result.submittedCount || 0) === 0) {
          renderDefinitionAiProgress({ status: 'AI 语义复核完成，正在刷新结果...', bar: 100, success: Math.max(effectiveTotal, processed), total: Math.max(effectiveTotal, processed), batch: batchNumber });
          window.setTimeout(() => window.location.assign(dedupeReloadUrl(null, 'all')), 700);
          return;
        }
      }
    } catch (error) {
      renderDefinitionAiProgress({ status: '检查方案 AI 复核已停止', success: processed, failed: errors + 1, total, batch: batchNumber, error: `${String(error.message || 'AI 服务请求失败').replace(/[。；]+$/, '')}。请检查 AI 服务配置和网络后重试。` });
      window.showAppNotice(error.message, '可选 AI 复核未完成');
    }
  }
  const definitionMergeState = {
    leftId: '',
    rightId: '',
    templateId: '',
    definitions: [],
    centerOptions: [],
    checkMethodOptions: [],
    standards: new Map(),
    searchTimer: null,
  };
  const mergeField = id => document.getElementById(id);
  const mergeNormalize = value => String(value || '').normalize('NFKC').trim().toLowerCase();
  function mergeSetError(message = '') {
    const box = mergeField('definitionMergeError');
    box.textContent = message;
    box.classList.toggle('d-none', !message);
  }
  function mergeTemplateDefinition() {
    return definitionMergeState.definitions.find(item => item.id === definitionMergeState.templateId);
  }
  function renderMergeStandardChips() {
    const chips = [ ...definitionMergeState.standards.values() ].map(item => {
      const chip = document.createElement('span');
      chip.className = 'badge text-bg-light border d-inline-flex align-items-start gap-2 definition-merge-chip';
      const text = document.createElement('span');
      text.textContent = [ item.standardNumber || item.code, item.title || '' ].filter(Boolean).join(' · ');
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn-close btn-close-sm';
      remove.setAttribute('aria-label', '移除该标准项');
      remove.addEventListener('click', () => {
        definitionMergeState.standards.delete(String(item.id));
        renderMergeStandardChips();
      });
      chip.append(text, remove);
      return chip;
    });
    if (!chips.length) {
      const empty = document.createElement('span');
      empty.className = 'small text-secondary';
      empty.textContent = '尚未关联标准项';
      chips.push(empty);
    }
    mergeField('definitionMergeStandardChips').replaceChildren(...chips);
  }
  function renderMergeChoices(definition) {
    const centers = new Set(definition.centers || []);
    mergeField('definitionMergeCenters').replaceChildren(...definitionMergeState.centerOptions.map((center, index) => {
      const wrapper = document.createElement('div');
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'btn-check';
      input.id = `definitionMergeCenter${index}`;
      input.value = center;
      input.checked = centers.has(center);
      const label = document.createElement('label');
      label.className = 'btn btn-outline-secondary';
      label.htmlFor = input.id;
      label.textContent = center;
      wrapper.append(input, label);
      return wrapper;
    }));
    const knownMethods = new Set(definitionMergeState.checkMethodOptions);
    const selectedMethods = new Set(splitMethods(definition.check_method));
    mergeField('definitionMergeMethods').replaceChildren(...definitionMergeState.checkMethodOptions.map((method, index) => {
      const wrapper = document.createElement('div');
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'btn-check';
      input.id = `definitionMergeMethod${index}`;
      input.value = method;
      input.checked = selectedMethods.has(method);
      const label = document.createElement('label');
      label.className = 'btn btn-outline-secondary';
      label.htmlFor = input.id;
      label.textContent = method;
      wrapper.append(input, label);
      return wrapper;
    }));
    mergeField('definitionMergeAdditionalMethods').value = [ ...selectedMethods ].filter(method => !knownMethods.has(method)).join(',');
  }
  function splitMethods(value) {
    return String(value || '').split(/[,，、;；\/|\r\n]+/).map(item => item.trim()).filter(Boolean);
  }
  function applyMergeTemplate(definition) {
    definitionMergeState.templateId = definition.id;
    mergeField('definitionMergeObjectName').value = definition.object_name || '';
    mergeField('definitionMergeObjectCategory').value = definition.object_category || '';
    mergeField('definitionMergeCheckLayer').value = definition.check_layer || '';
    mergeField('definitionMergeFrequency').value = definition.frequency || '';
    mergeField('definitionMergeAccessMode').value = definition.access_mode || '';
    mergeField('definitionMergeRecognizedObject').value = definition.recognized_object === null || definition.recognized_object === undefined ? '' : String(definition.recognized_object);
    mergeField('definitionMergePriority').value = definition.priority || '';
    mergeField('definitionMergeScope').value = definition.scope || '';
    mergeField('definitionMergeDescription').value = definition.description || '';
    mergeField('definitionMergeSteps').value = definition.steps || '';
    mergeField('definitionMergeReferenceResult').value = definition.reference_result || '';
    mergeField('definitionMergeReferenceMaterials').value = definition.reference_materials || '';
    renderMergeChoices(definition);
    definitionMergeState.standards = new Map((definition.standard_items || []).filter(item => item?.id).map(item => [ String(item.id), item ]));
    renderMergeStandardChips();
    mergeSetError('');
  }
  function renderMergeTemplates() {
    mergeField('definitionMergeTemplates').replaceChildren(...definitionMergeState.definitions.map((definition, index) => {
      const wrapper = document.createElement('div');
      const input = document.createElement('input');
      input.type = 'radio';
      input.className = 'btn-check';
      input.name = 'definitionMergeTemplate';
      input.id = `definitionMergeTemplate${index}`;
      input.value = definition.id;
      input.checked = definition.id === definitionMergeState.templateId;
      input.addEventListener('change', () => applyMergeTemplate(definition));
      const label = document.createElement('label');
      label.className = 'btn btn-outline-primary';
      label.htmlFor = input.id;
      label.textContent = `${index === 0 ? 'A' : 'B'} · ${mergeNumberLabel(definition.plan_number)} · ${definition.object_name}`;
      wrapper.append(input, label);
      return wrapper;
    }));
  }
  async function openDefinitionMergeEditor(button) {
    definitionMergeState.leftId = button.dataset.left;
    definitionMergeState.rightId = button.dataset.right;
    definitionMergeState.templateId = '';
    mergeSetError('');
    const modal = bootstrap.Modal.getOrCreateInstance(mergeField('definitionMergeModal'));
    modal.show();
    try {
      const result = await dedupeSend(`/api/dedupe/merge-options?leftId=${encodeURIComponent(definitionMergeState.leftId)}&rightId=${encodeURIComponent(definitionMergeState.rightId)}`, null, 'GET');
      definitionMergeState.definitions = result.definitions || [];
      definitionMergeState.centerOptions = result.centerOptions || [];
      definitionMergeState.checkMethodOptions = result.checkMethodOptions || [];
      const objectNames = [ ...new Set(definitionMergeState.definitions.map(item => item.object_name).filter(Boolean)) ];
      mergeField('definitionMergeObjectNames').replaceChildren(...objectNames.map(value => new Option(value, value)));
      const categories = [ ...new Set(definitionMergeState.definitions.map(item => item.object_category).filter(Boolean)) ];
      mergeField('definitionMergeCategoryNames').replaceChildren(...categories.map(value => new Option(value, value)));
      if (!definitionMergeState.definitions.length) throw new Error('未找到可编辑的候选检查方案');
      renderMergeTemplates();
      applyMergeTemplate(definitionMergeState.definitions[0]);
    } catch (error) {
      mergeSetError(error.message);
    }
  }
  function searchDefinitionMergeStandards() {
    window.clearTimeout(definitionMergeState.searchTimer);
    const query = mergeField('definitionMergeStandardSearch').value.trim();
    const results = mergeField('definitionMergeStandardResults');
    if (!query) {
      results.classList.add('d-none');
      results.replaceChildren();
      return;
    }
    definitionMergeState.searchTimer = window.setTimeout(async () => {
      results.classList.remove('d-none');
      results.replaceChildren(Object.assign(document.createElement('div'), {
        className: 'list-group-item text-secondary',
        textContent: '正在搜索...',
      }));
      try {
        const response = await fetch('/api/supervision-definition-options/standard-items?q=' + encodeURIComponent(query));
        if (!response.ok) throw new Error('标准项搜索失败');
        const body = await response.json();
        if (mergeField('definitionMergeStandardSearch').value.trim() !== query) return;
        const items = body.data || [];
        if (!items.length) {
          results.replaceChildren(Object.assign(document.createElement('div'), {
            className: 'list-group-item text-secondary',
            textContent: '没有匹配的标准项',
          }));
          return;
        }
        results.replaceChildren(...items.map(item => {
          const option = document.createElement('button');
          option.type = 'button';
          option.className = 'list-group-item list-group-item-action';
          option.textContent = [ item.standardNumber || item.code, item.title ].filter(Boolean).join(' · ');
          option.addEventListener('mousedown', event => event.preventDefault());
          option.addEventListener('click', () => {
            definitionMergeState.standards.set(String(item.id), item);
            mergeField('definitionMergeStandardSearch').value = '';
            results.classList.add('d-none');
            renderMergeStandardChips();
          });
          return option;
        }));
      } catch (error) {
        results.replaceChildren(Object.assign(document.createElement('div'), {
          className: 'list-group-item text-danger',
          textContent: error.message,
        }));
      }
    }, 220);
  }
  mergeField('definitionMergeStandardSearch').addEventListener('input', searchDefinitionMergeStandards);
  mergeField('definitionMergeStandardSearch').addEventListener('blur', () => {
    window.setTimeout(() => mergeField('definitionMergeStandardResults').classList.add('d-none'), 160);
  });
  mergeField('definitionMergeForm').addEventListener('submit', async event => {
    event.preventDefault();
    mergeSetError('');
    const template = mergeTemplateDefinition();
    if (!template) return mergeSetError('请先选择 A 或 B 作为模板');
    const centerValues = [ ...document.querySelectorAll('#definitionMergeCenters input:checked') ].map(input => input.value);
    const methods = [
      ...[ ...document.querySelectorAll('#definitionMergeMethods input:checked') ].map(input => input.value),
      mergeField('definitionMergeAdditionalMethods').value,
    ];
    const standardItemIds = [ ...definitionMergeState.standards.keys() ];
    if (!centerValues.length) return mergeSetError('请至少选择一个适用机构');
    if (!standardItemIds.length) return mergeSetError('请至少关联一个标准项');
    const submit = mergeField('definitionMergeSubmit');
    submit.disabled = true;
    try {
      await dedupeSend('/api/dedupe/reviews', {
        leftId: definitionMergeState.leftId,
        rightId: definitionMergeState.rightId,
        decision: 'duplicate',
        canonicalId: template.id,
        confirmConflicts: true,
        editedDefinition: {
          objectName: mergeField('definitionMergeObjectName').value,
          objectCategory: mergeField('definitionMergeObjectCategory').value,
          checkLayer: mergeField('definitionMergeCheckLayer').value,
          frequency: mergeField('definitionMergeFrequency').value,
          accessMode: mergeField('definitionMergeAccessMode').value,
          recognizedObject: mergeField('definitionMergeRecognizedObject').value,
          priority: mergeField('definitionMergePriority').value,
          scope: mergeField('definitionMergeScope').value,
          centers: centerValues,
          checkMethods: methods,
          description: mergeField('definitionMergeDescription').value,
          steps: mergeField('definitionMergeSteps').value,
          referenceResult: mergeField('definitionMergeReferenceResult').value,
          referenceMaterials: mergeField('definitionMergeReferenceMaterials').value,
          standardItemIds,
        },
      });
      window.location.assign(dedupeReloadUrl('检查方案已编辑并合并'));
    } catch (error) {
      mergeSetError(error.message);
      submit.disabled = false;
    }
  });
  async function definitionReview(leftId, rightId, decision, canonicalId) {
    const labels = {
      duplicate: `确认这两条检查方案重复，并保留${canonicalId === leftId ? '方案 A' : '方案 B'}？`,
      similar_but_distinct: '标记为相似但不归并？',
      unrelated: '标记为无关？',
      uncertain: '标记为待进一步确认？',
    };
    if (!await window.confirmAppAction(labels[decision], '确认人工复核结论')) return;
    const body = { leftId, rightId, decision, canonicalId, confirmConflicts: false };
    try {
      await dedupeSend('/api/dedupe/reviews', body);
      window.location.assign(dedupeReloadUrl('人工复核结论已保存'));
    } catch (error) {
      if (decision === 'duplicate' && error.message.includes('字段冲突')) {
        const confirmed = await window.confirmAppAction(`${error.message}。仍要归并并保留所选主定义吗？`, '归并字段冲突');
        if (!confirmed) return;
        try {
          body.confirmConflicts = true;
          await dedupeSend('/api/dedupe/reviews', body);
          window.location.assign(dedupeReloadUrl('定义已按确认归并'));
        } catch (retryError) {
          window.showAppNotice(retryError.message, '归并失败');
        }
        return;
      }
      window.showAppNotice(error.message, '复核未完成');
    }
  }
</script>
