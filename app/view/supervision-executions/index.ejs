<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <p class="text-secondary mb-0">当前项目：<strong><%= project.name %></strong>。一次检查执行可覆盖多个标准项，并分别保存检查结论。</p>
  <% if (user && (user.roles || []).some(role => role.projectId === project.id || !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %><button class="btn btn-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#createExecutionModal">新建检查记录</button><% } %>
</div>

<div class="card">
  <div class="card-header d-flex align-items-center"><h3 class="card-title">检查记录</h3><span class="badge text-bg-secondary ms-auto"><%= executions.length %> 条</span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>检查时间</th><th>检查方案</th><th>适用中心/云中心</th><th>总体结论</th><th>标准项结果</th><th>检查人</th><th>备注</th></tr></thead>
    <tbody>
      <% executions.forEach(execution => { %>
        <tr><td><%= new Date(execution.checked_at).toLocaleString('zh-CN') %></td><td><strong><%= execution.object_name %></strong><div class="small text-secondary">方案编号 <%= String(execution.plan_number || '').padStart(3, '0') %> · <%= execution.check_method %></div></td><td><%= execution.supervision_center || '未指定中心' %><% if (execution.cloud_center_name) { %><div class="small text-secondary"><%= execution.cloud_center_name %></div><% } %></td><td><span class="badge <%= execution.overall_result === 'satisfied' ? 'text-bg-success' : execution.overall_result === 'not_satisfied' ? 'text-bg-danger' : 'text-bg-warning' %>"><%= execution.overall_result === 'satisfied' ? '满足' : execution.overall_result === 'partially_satisfied' ? '部分满足' : execution.overall_result === 'not_satisfied' ? '不满足' : '未填写' %></span></td><td><%= execution.satisfied_count %> / <%= execution.item_result_count %> 项满足</td><td><%= execution.checked_by_name || '-' %></td><td><%= execution.notes || '-' %></td></tr>
      <% }) %>
      <% if (!executions.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">暂无检查记录，请先新建一次检查执行。</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<div class="modal fade" id="createExecutionModal" tabindex="-1" aria-labelledby="createExecutionModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form id="createExecutionForm" method="post" action="/projects/<%= project.id %>/supervision-executions"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="itemResults" id="itemResults">
    <div class="modal-header"><h2 class="modal-title fs-5" id="createExecutionModalLabel">新建检查记录</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="executionDefinition">检查方案</label><select class="form-select" id="executionDefinition" name="definitionId" required><option value="">请选择检查方案</option><% definitions.forEach(definition => { %><option value="<%= definition.id %>"><%= String(definition.plan_number || '').padStart(3, '0') %> · <%= definition.object_name %> · <%= definition.check_method %>（<%= (definition.standard_items || []).length %> 项）</option><% }) %></select></div>
        <div class="col-md-3"><label class="form-label" for="executionSupervisionCenter">本次检查中心</label><select class="form-select" id="executionSupervisionCenter" name="supervisionCenter" required><option value="">先选择检查方案</option></select></div>
        <div class="col-md-3"><label class="form-label" for="executionCloudCenter">具体云中心（如适用）</label><select class="form-select" id="executionCloudCenter" name="cloudCenterId" disabled><option value="">不指定</option><% cloudCenters.forEach(center => { %><option value="<%= center.id %>"><%= center.name %></option><% }) %></select></div>
        <div class="col-md-3"><label class="form-label" for="executionCheckedAt">检查时间</label><input class="form-control" id="executionCheckedAt" type="datetime-local" required><input type="hidden" id="executionCheckedAtIso" name="checkedAt"></div>
        <div class="col-md-4"><label class="form-label" for="executionOverallResult">总体结论</label><select class="form-select" id="executionOverallResult" name="overallResult"><option value="">未填写</option><option value="satisfied">满足</option><option value="partially_satisfied">部分满足</option><option value="not_satisfied">不满足</option></select></div>
        <div class="col-md-8"><label class="form-label" for="executionNotes">总体备注</label><input class="form-control" id="executionNotes" name="notes" maxlength="2000"></div>
      </div>
      <hr>
      <div id="executionItems"><div class="text-secondary py-3">选择监督定义后，这里会显示关联的标准项结果。</div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存检查记录</button></div>
  </form>
</div></div></div>
<script>
  const executionDefinitions = <%- JSON.stringify(definitions).replace(/</g, '\\u003c') %>;
  const executionItems = document.getElementById('executionItems');
  const executionCenter = document.getElementById('executionSupervisionCenter');
  const executionCloudCenter = document.getElementById('executionCloudCenter');

  function createResultSelect(itemId) {
    const select = document.createElement('select');
    select.className = 'form-select form-select-sm execution-item-result';
    select.dataset.id = String(itemId);
    [
      ['unassessed', '未评估'],
      ['satisfied', '满足'],
      ['partially_satisfied', '部分满足'],
      ['not_satisfied', '不满足'],
      ['not_applicable', '不适用'],
    ].forEach(([value, labelText]) => {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = labelText;
      select.appendChild(option);
    });
    return select;
  }

  function createItemField(labelText, className, itemId) {
    const field = document.createElement('div');
    const label = document.createElement('label');
    const textarea = document.createElement('textarea');
    field.className = className;
    label.className = 'form-label small';
    label.textContent = labelText;
    textarea.className = labelText === '说明' ? 'form-control form-control-sm execution-item-description' : 'form-control form-control-sm execution-item-problem';
    textarea.dataset.id = String(itemId);
    textarea.rows = 2;
    field.append(label, textarea);
    return field;
  }

  function createExecutionItem(item) {
    const card = document.createElement('div');
    const heading = document.createElement('div');
    const row = document.createElement('div');
    const resultColumn = document.createElement('div');
    const resultLabel = document.createElement('label');
    const resultSelect = createResultSelect(item.id);
    card.className = 'border rounded p-3 mb-2';
    heading.className = 'fw-semibold mb-2';
    heading.textContent = [item.code, item.title].filter(Boolean).join(' · ');
    row.className = 'row g-2';
    resultColumn.className = 'col-md-3';
    resultLabel.className = 'form-label small';
    resultLabel.textContent = '结果';
    resultColumn.append(resultLabel, resultSelect);
    row.append(resultColumn, createItemField('说明', 'col-md-9', item.id));
    card.append(heading, row, createItemField('问题与整改', 'mt-2', item.id));
    return card;
  }

  document.getElementById('executionDefinition').addEventListener('change', event => {
    const definition = executionDefinitions.find(item => item.id === event.target.value);
    executionCenter.replaceChildren(new Option('请选择本次检查中心', ''));
    (definition?.supervision_centers || []).forEach(center => executionCenter.add(new Option(center, center)));
    if (definition?.supervision_centers?.length === 1) executionCenter.value = definition.supervision_centers[0];
    executionCloudCenter.disabled = executionCenter.value !== '云中心';
    if (executionCloudCenter.disabled) executionCloudCenter.value = '';
    if (!definition) {
      const empty = document.createElement('div');
      empty.className = 'text-secondary py-3';
      empty.textContent = '选择监督定义后，这里会显示关联的标准项结果。';
      executionItems.replaceChildren(empty);
      return;
    }
    executionItems.replaceChildren(...(definition.standard_items || []).map(createExecutionItem));
  });
  executionCenter.addEventListener('change', () => {
    executionCloudCenter.disabled = executionCenter.value !== '云中心';
    if (executionCloudCenter.disabled) executionCloudCenter.value = '';
  });
  document.getElementById('createExecutionForm').addEventListener('submit', () => {
    const localCheckedAt = document.getElementById('executionCheckedAt').value;
    document.getElementById('executionCheckedAtIso').value = new Date(localCheckedAt).toISOString();
    const result = {};
    document.querySelectorAll('.execution-item-result').forEach(select => {
      const id = select.dataset.id;
      result[id] = {
        result: select.value,
        description: document.querySelector('.execution-item-description[data-id="' + id + '"]').value,
        problemDescription: document.querySelector('.execution-item-problem[data-id="' + id + '"]').value,
      };
    });
    document.getElementById('itemResults').value = JSON.stringify(result);
  });
</script>
