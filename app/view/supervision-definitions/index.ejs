            <div class="col-md-6"><label class="form-label" for="editAdditionalCheckMethods">其他检查方法</label><input class="form-control" id="editAdditionalCheckMethods" name="additionalCheckMethods" placeholder="多个方法用逗号分隔"></div>
            <div class="col-md-3"><label class="form-label" for="editFrequency">执行频率</label><input class="form-control" id="editFrequency" name="frequency" list="editFrequencyOptions" autocomplete="off"></div>
            <div class="col-md-3"><label class="form-label" for="editAccessMode">远程/现场查看</label><select class="form-select" id="editAccessMode" name="accessMode"><option value="">未指定</option><option value="远程">远程</option><option value="现场">现场</option><option value="远程+现场">远程+现场</option></select></div>
            <div class="col-12"><label class="form-label" for="editDescription">检查项描述</label><textarea class="form-control" id="editDescription" name="description" rows="4" required maxlength="5000"></textarea></div>
            <div class="col-12"><label class="form-label" for="editSteps">检查步骤</label><textarea class="form-control" id="editSteps" name="steps" rows="4"></textarea></div>
            <div class="col-12"><details class="border-top pt-3"><summary class="text-secondary">其他参考信息（可选）</summary><div class="row g-3 mt-1"><div class="col-md-6"><label class="form-label" for="editReferenceResult">检查结果参考描述</label><textarea class="form-control" id="editReferenceResult" name="referenceResult" rows="2"></textarea></div><div class="col-md-6"><label class="form-label" for="editReferenceMaterials">参考材料</label><textarea class="form-control" id="editReferenceMaterials" name="referenceMaterials" rows="2"></textarea></div></div></details></div>
          </div>
        </section>
        <section class="tab-pane fade" id="editStandardsPane" role="tabpanel" aria-labelledby="editStandardsTab" tabindex="0">
          <label class="form-label" for="editStandardSearch">关联标准项</label>
          <select class="d-none" id="editStandardItems" name="standardItemIds" multiple></select>
          <div class="standard-picker" data-picker="editStandardPicker">
            <div class="standard-picker-selected d-flex flex-wrap gap-2 mb-2" id="editStandardChips"></div>
            <input class="form-control" id="editStandardSearch" type="search" autocomplete="off" placeholder="输入标准编号、条款编号或内容搜索">
            <div class="standard-picker-results list-group shadow-sm mt-1 d-none" id="editStandardResults"></div>
          </div>
          <div class="form-text">支持标准编号、内部编号、标题和正文内容搜索；修改关联不会删除既有执行记录。</div>
        </section>
      </div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存修改</button></div>
  </form>
</div></div></div>
<style>
  .standard-picker { position: relative; }
  .standard-picker-results { position: relative; z-index: 1085; width: 100%; max-height: 13rem; overflow-y: auto; }
  .standard-picker-result { text-align: left; }
  .standard-picker-result code { color: #475569; }
  .standard-chip { max-width: 100%; white-space: normal; text-align: left; }
  @media (max-width: 767.98px) {
    #createDefinitionModal .modal-dialog,
    #editDefinitionModal .modal-dialog {
      width: auto;
      max-width: none;
      margin: .5rem;
    }
    #createDefinitionModal .modal-content,
    #editDefinitionModal .modal-content {
      width: 100%;
      max-height: calc(100dvh - 1rem);
    }
    #createDefinitionModal .modal-body,
    #editDefinitionModal .modal-body {
      overflow-x: hidden;
    }
    #createDefinitionModal .nav-tabs,
    #editDefinitionModal .nav-tabs {
      padding-inline: 0.5rem !important;
      flex-wrap: nowrap;
      overflow: hidden;
    }
    #createDefinitionModal .nav-item,
    #editDefinitionModal .nav-item {
      flex: 1 1 0;
      text-align: center;
    }
    #createDefinitionModal .nav-link,
    #editDefinitionModal .nav-link {
      width: 100%;
      padding-inline: 0.35rem;
      white-space: nowrap;
      font-size: 0.875rem;
    }
  }
</style>
<script>
  const planObjectCatalog = <%- JSON.stringify(objectOptionsValue).replace(/</g, '\\u003c') %>;

  function normalizedPickerText(value) {
    return String(value || '').normalize('NFKC').trim().toLowerCase();
  }
  function objectInputMatches(inputValue) {
    const term = normalizedPickerText(inputValue);
    return planObjectCatalog.find(item =>
      normalizedPickerText(item.canonical_name) === term
      || (item.aliases || []).some(alias => normalizedPickerText(alias) === term)
    ) || null;
  }
  function populateObjectOptions(prefix, categoryInputValue = '') {
    const input = document.getElementById(prefix + 'ObjectName');
    const datalist = document.getElementById(prefix + 'ObjectOptions');
    if (!input || !datalist) return;
    const categoryTerm = normalizedPickerText(categoryInputValue);
    const matchingCategory = Array.from(document.getElementById(prefix + 'CategoryOptions')?.options || [])
      .find(option => normalizedPickerText(option.value) === categoryTerm)?.value || '';
    const options = [];
    for (const object of planObjectCatalog) {
      if (matchingCategory && object.object_category !== matchingCategory) continue;
      const canonical = document.createElement('option');
      canonical.value = object.canonical_name;
      canonical.label = object.object_category || '未分类';
      options.push(canonical);
      for (const alias of object.aliases || []) {
        if (normalizedPickerText(alias) === normalizedPickerText(object.canonical_name)) continue;
        const aliasOption = document.createElement('option');
        aliasOption.value = alias;
        aliasOption.label = `别名 · ${object.canonical_name} · ${object.object_category || '未分类'}`;
        options.push(aliasOption);
      }
    }
    datalist.replaceChildren(...options);
  }
  function resolvePlanObject(prefix, apply = false) {
    const input = document.getElementById(prefix + 'ObjectName');
    const categoryInput = document.getElementById(prefix + 'ObjectCategory');
    const object = objectInputMatches(input.value);
    if (object && apply) {
      input.value = object.canonical_name;
      categoryInput.value = object.object_category || '';
    }
    return object;
  }
  function initializeObjectPicker(prefix) {
    const objectInput = document.getElementById(prefix + 'ObjectName');
    const categoryInput = document.getElementById(prefix + 'ObjectCategory');
    populateObjectOptions(prefix);
    categoryInput.addEventListener('input', () => {
      input.value = '';
      populateObjectOptions(prefix, categoryInput.value);
    });
    objectInput.addEventListener('input', () => {
      if (!objectInput.value.trim()) categoryInput.value = '';
    });
    objectInput.addEventListener('change', () => resolvePlanObject(prefix, true));
  }
  initializeObjectPicker('create');
  initializeObjectPicker('edit');

  class StandardItemPicker {
    constructor(kind) {
      this.kind = kind;
      this.select = document.getElementById(kind + 'StandardItems');
      this.search = document.getElementById(kind + 'StandardSearch');
      this.results = document.getElementById(kind + 'StandardResults');
      this.chips = document.getElementById(kind + 'StandardChips');
      this.countBadge = document.getElementById(kind + 'StandardItemCount');
      this.items = new Map();
      this.timer = null;
      this.search.addEventListener('input', () => this.scheduleSearch());
      this.search.addEventListener('focus', () => { if (this.search.value.trim()) this.searchItems(); });
      this.search.addEventListener('blur', () => window.setTimeout(() => this.hideResults(), 160));
    }
    setItems(items) {
      this.items = new Map((items || []).filter(item => item?.id).map(item => [ String(item.id), item ]));
      this.render();
    }
    ids() {
      return Array.from(this.items.keys());
    }
    size() {
      return this.items.size;
    }
    add(item) {
      this.items.set(String(item.id), item);
      this.search.value = '';
      this.hideResults();
      this.render();
    }
    remove(id) {
      this.items.delete(String(id));
      this.render();
    }
    render() {
      const chips = [];
      for (const item of this.items.values()) {
        const chip = document.createElement('span');
        chip.className = 'badge text-bg-light border d-inline-flex align-items-start gap-2 standard-chip';
        const text = document.createElement('span');
        text.textContent = [ item.standardNumber || item.code, item.title || item.preview || '' ].filter(Boolean).join(' · ');
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'btn-close btn-close-sm';
        remove.setAttribute('aria-label', '移除该标准项');
        remove.addEventListener('click', () => this.remove(item.id));
        chip.append(text, remove);
        chips.push(chip);
      }
      if (!chips.length) {
        const empty = document.createElement('span');
        empty.className = 'text-secondary small';
        empty.textContent = '尚未关联标准项';
        chips.push(empty);
      }
      this.chips.replaceChildren(...chips);
      const options = Array.from(this.items.values()).map(item => {
        const option = document.createElement('option');
        option.value = item.id;
        option.selected = true;
        return option;
      });
      this.select.replaceChildren(...options);
      this.countBadge.textContent = String(this.items.size);
    }
    scheduleSearch() {
      window.clearTimeout(this.timer);
      if (!this.search.value.trim()) {
        this.hideResults();
        return;
      }
      this.timer = window.setTimeout(() => this.searchItems(), 220);
    }
    async searchItems() {
      const query = this.search.value.trim();
      if (!query) return;
      this.results.classList.remove('d-none');
      this.results.replaceChildren(Object.assign(document.createElement('div'), {
        className: 'list-group-item text-secondary',
        textContent: '正在搜索...',
      }));
      try {
        const response = await fetch('/api/supervision-definition-options/standard-items?q=' + encodeURIComponent(query));
        if (!response.ok) throw new Error('标准项搜索失败');
        const body = await response.json();
        if (this.search.value.trim() !== query) return;
        this.renderResults(body.data || []);
      } catch (error) {
        this.results.replaceChildren(Object.assign(document.createElement('div'), {
          className: 'list-group-item text-danger',
          textContent: error.message,
        }));
      }
    }
    renderResults(items) {
      if (!items.length) {
        this.results.replaceChildren(Object.assign(document.createElement('div'), {
          className: 'list-group-item text-secondary',
          textContent: '没有匹配的标准项，请尝试编号或正文关键词。',
        }));
        return;
      }
      const rows = items.map(item => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'list-group-item list-group-item-action standard-picker-result';
        if (this.items.has(String(item.id))) {
          button.disabled = true;
          button.textContent = `${item.standardNumber || item.code} · 已关联`;
          return button;
        }
        const title = document.createElement('div');
        title.className = 'fw-semibold';
        title.textContent = [ item.standardNumber || item.code, item.title ].filter(Boolean).join(' · ');
        const meta = document.createElement('div');
        meta.className = 'small text-secondary mt-1';
        meta.textContent = [ item.standardCode, item.version, item.chapterCode, item.preview ].filter(Boolean).join(' · ');
        button.append(title, meta);
        button.addEventListener('mousedown', event => event.preventDefault());
        button.addEventListener('click', () => this.add(item));
        return button;
      });
      this.results.replaceChildren(...rows);
    }
    hideResults() {
      this.results.classList.add('d-none');
      this.results.replaceChildren();
    }
  }
  const planPickers = {
    create: new StandardItemPicker('create'),
    edit: new StandardItemPicker('edit'),
  };
  planPickers.create.setItems([]);
  planPickers.edit.setItems([]);

  function showPlanFormTab(element) {
    const pane = element.closest('.tab-pane');
    if (!pane) return;
    const trigger = document.querySelector(`[data-bs-target="#${pane.id}"]`);
    if (trigger) bootstrap.Tab.getOrCreateInstance(trigger).show();
  }
  document.getElementById('definitionDetailModal').addEventListener('show.bs.modal', event => {
    const definition = JSON.parse(event.relatedTarget.dataset.definition);
    const body = document.getElementById('definitionDetailBody');
    const rows = [
      ['方案编号', String(definition.plan_number || '').padStart(3, '0')],
      ['检查对象', definition.object_name],
      ['适用检查中心', (definition.centers || []).join('、') || '未指定'],
      ...(definition.scope ? [ [ '检查范围', definition.scope ] ] : []),
      ['对象分类', definition.object_category || '未指定'],
      ['检查层面', definition.check_layer || '未指定'],
      ['检查方法', definition.check_method],
      ['检查频率 / 执行方式', [definition.frequency, definition.access_mode].filter(Boolean).join(' / ') || '未指定'],
      ['检查描述', definition.description],
      ['检查步骤', definition.steps || '未填写'],
      ['参考判定', definition.reference_result || '未填写'],
      ['参考材料', definition.reference_materials || '未填写'],
      ['关联标准项', (definition.standard_items || []).map(item => [item.standardCode, item.version, item.standardNumber || item.code].filter(Boolean).join(' · ')).join('；') || '未关联'],
    ];
    body.replaceChildren(...rows.map(([label, value]) => {
      const row = document.createElement('div');
      row.className = 'row g-2 border-bottom py-2';
      const labelElement = document.createElement('div');
      labelElement.className = 'col-sm-3 text-secondary';
      labelElement.textContent = label;
      const valueElement = document.createElement('div');
      valueElement.className = 'col-sm-9 text-break';
      valueElement.textContent = value || '未填写';
      row.append(labelElement, valueElement);
      return row;
    }));
  });
  document.getElementById('editDefinitionModal').addEventListener('show.bs.modal', event => {
    const definition = JSON.parse(event.relatedTarget.dataset.definition);
    const form = document.getElementById('editDefinitionForm');
    form.action = '/supervision-definitions/' + definition.id;
    bootstrap.Tab.getOrCreateInstance(document.getElementById('editBasicTab')).show();
    const fields = {
      editObjectName: definition.object_name,
      editScope: definition.scope || '',
      editObjectCategory: definition.object_category || '',
      editCheckLayer: definition.check_layer || '',
      editFrequency: definition.frequency || '',
      editDescription: definition.description,
      editSteps: definition.steps || '',
      editReferenceResult: definition.reference_result || '',
      editReferenceMaterials: definition.reference_materials || '',
    };
    Object.entries(fields).forEach(([id, value]) => { document.getElementById(id).value = value; });
    populateObjectOptions('edit', definition.object_category || '');
    const centers = new Set(definition.centers || []);
    form.querySelectorAll('input[name="centers"]').forEach(input => { input.checked = centers.has(input.value); });
    const methods = new Set((definition.check_method || '').split(/[,，、;；\/|\r\n]+/).map(method => method.trim()).filter(Boolean));
    const methodInputs = Array.from(form.querySelectorAll('input[name="checkMethods"]'));
    const knownMethods = new Set(methodInputs.map(input => input.value));
    methodInputs.forEach(input => { input.checked = methods.has(input.value); });
    document.getElementById('editAdditionalCheckMethods').value = Array.from(methods).filter(method => !knownMethods.has(method)).join(',');
    document.getElementById('editAccessMode').value = definition.access_mode || '';
    document.getElementById('editRecognizedObject').value = definition.recognized_object === null ? '' : String(definition.recognized_object);
    document.getElementById('editPriority').value = definition.priority || '';
    planPickers.edit.setItems(definition.standard_items || []);
    document.getElementById('editStandardSearch').value = '';
  });
  [
    { formId: 'createDefinitionForm', prefix: 'create', picker: planPickers.create },
    { formId: 'editDefinitionForm', prefix: 'edit', picker: planPickers.edit },
  ].forEach(({ formId, prefix, picker }) => {
    const form = document.getElementById(formId);
    form.addEventListener('invalid', event => showPlanFormTab(event.target), true);
    form.addEventListener('submit', event => {
      const selectedObject = resolvePlanObject(prefix, true);
      if (!selectedObject) {
        event.preventDefault();
        showPlanFormTab(document.getElementById(prefix + 'ObjectName'));
        window.showAppNotice('检查对象必须从“中心检查对象”主数据中选择。', '检查方案未保存');
        return;
      }
      const categoryInput = document.getElementById(prefix + 'ObjectCategory');
      if (normalizedPickerText(categoryInput.value)
        && normalizedPickerText(categoryInput.value) !== normalizedPickerText(selectedObject.object_category)) {
        event.preventDefault();
        showPlanFormTab(categoryInput);
        window.showAppNotice('对象分类必须与所选检查对象关联，请重新选择对象。', '检查方案未保存');
        return;
      }
      categoryInput.value = selectedObject.object_category || '';
      const centerCount = form.querySelectorAll('input[name="centers"]:checked').length;
      if (!centerCount) {
        event.preventDefault();
        showPlanFormTab(form.querySelector('input[name="centers"]'));
        window.showAppNotice('请至少选择一个适用检查中心。', '检查方案未保存');
        return;
      }
      const methodCount = form.querySelectorAll('input[name="checkMethods"]:checked').length;
      if (!methodCount && !document.getElementById(prefix + 'AdditionalCheckMethods').value.trim()) {
        event.preventDefault();
        showPlanFormTab(form.querySelector('input[name="checkMethods"]'));
        window.showAppNotice('请选择或填写至少一种检查方法。', '检查方案未保存');
        return;
      }
      if (!picker.size()) {
        event.preventDefault();
        showPlanFormTab(document.getElementById(prefix + 'StandardSearch'));
        window.showAppNotice('请至少关联一个标准项。', '检查方案未保存');
      }
    });
  });
</script>
