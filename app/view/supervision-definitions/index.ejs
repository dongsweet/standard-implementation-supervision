<%
  const searchValue = typeof search === 'undefined' ? '' : search;
  const statusValue = typeof status === 'undefined' ? '' : status;
  const priorityValue = typeof priority === 'undefined' ? '' : priority;
  const checkMethodValue = typeof checkMethod === 'undefined' ? '' : checkMethod;
  const centerValue = typeof center === 'undefined' ? '' : center;
  const centerOptionsValue = typeof centerOptions === 'undefined' ? [] : centerOptions;
  const objectOptionsValue = typeof objectOptions === 'undefined' ? [] : objectOptions;
  const objectCategoriesValue = typeof objectCategories === 'undefined' ? [] : objectCategories;
  const checkLayerOptionsValue = typeof checkLayerOptions === 'undefined' ? [] : checkLayerOptions;
  const frequencyOptionsValue = typeof frequencyOptions === 'undefined' ? [] : frequencyOptions;
  const totalValue = typeof total === 'undefined' ? definitions.length : total;
  const pageValue = typeof page === 'undefined' ? 1 : page;
  const pageCountValue = typeof pageCount === 'undefined' ? 1 : pageCount;
  const buildPageUrl = targetPage => {
    const params = [];
    if (searchValue) params.push('search=' + encodeURIComponent(searchValue));
    if (statusValue) params.push('status=' + encodeURIComponent(statusValue));
    if (priorityValue) params.push('priority=' + encodeURIComponent(priorityValue));
    if (checkMethodValue) params.push('checkMethod=' + encodeURIComponent(checkMethodValue));
    if (centerValue) params.push('center=' + encodeURIComponent(centerValue));
    params.push('page=' + targetPage);
    return '?' + params.join('&');
  };
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <p class="text-secondary mb-0">检查方案是系统级可复用定义；选择具体项目后，在“检查记录”中按该项目纳入的标准项执行并记录结果。</p>
  <div class="ms-auto d-flex gap-2"><a class="btn btn-outline-primary" href="/dedupe">检查方案去重复核</a><% if (user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %><a class="btn btn-outline-secondary" href="/supervision-definitions/import-template">下载导入模板</a><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#planImportModal">导入检查方案</button><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createDefinitionModal">新增检查方案</button><% } %></div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="get" action="/supervision-definitions" class="row g-2 align-items-end">
      <div class="col-12 col-md-6 col-xl-4"><label class="form-label" for="definitionSearch">查找</label><input class="form-control" id="definitionSearch" name="search" value="<%= searchValue %>" placeholder="方案编号、检查对象、描述或标准编号"></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionPriority">重点项</label><select class="form-select" id="definitionPriority" name="priority"><option value="">全部</option><option value="重点项" <%= priorityValue === '重点项' ? 'selected' : '' %>>重点项</option><option value="非重点项" <%= priorityValue === '非重点项' ? 'selected' : '' %>>非重点项</option><option value="未指定" <%= priorityValue === '未指定' ? 'selected' : '' %>>未指定</option></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionMethod">检查方法</label><select class="form-select" id="definitionMethod" name="checkMethod"><option value="">全部方法</option><% checkMethodOptions.forEach(method => { %><option value="<%= method %>" <%= checkMethodValue === method ? 'selected' : '' %>><%= method %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionCenter">适用检查中心</label><select class="form-select" id="definitionCenter" name="center"><option value="">全部中心</option><% centerOptionsValue.forEach(centerOption => { %><option value="<%= centerOption %>" <%= centerValue === centerOption ? 'selected' : '' %>><%= centerOption %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionStatus">状态</label><select class="form-select" id="definitionStatus" name="status"><option value="">全部状态</option><option value="active" <%= statusValue === 'active' ? 'selected' : '' %>>有效</option><option value="merged" <%= statusValue === 'merged' ? 'selected' : '' %>>已归并</option></select></div>
      <div class="col-12 d-flex justify-content-end gap-2"><button class="btn btn-outline-primary" type="submit">查找</button><a class="btn btn-outline-secondary" href="/supervision-definitions">重置</a></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex align-items-center"><h3 class="card-title">检查方案列表</h3><span class="badge text-bg-secondary ms-auto"><%= totalValue %> 条</span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>方案编号</th><th>检查中心</th><th>检查对象</th><th>检查方法</th><th>检查描述</th><th>频率/方式</th><th>关联标准项</th><th>方案属性</th><th class="text-end">操作</th></tr></thead>
    <tbody>
      <% definitions.forEach(definition => { %>
        <tr>
          <td><span class="badge text-bg-primary"><%= String(definition.plan_number || '').padStart(3, '0') %></span></td>
          <td><% (definition.centers || []).forEach(centerName => { %><span class="badge text-bg-light border me-1 mb-1"><%= centerName %></span><% }) %><% if (!(definition.centers || []).length) { %><span class="text-secondary">未指定</span><% } %></td>
          <td><strong><%= definition.object_name %></strong><div class="small text-secondary mt-1"><%= definition.scope || '-' %></div></td>
          <td><% (definition.check_method || '').split(/[,，、;；\/|\r\n]+/).map(method => method.trim()).filter(Boolean).forEach(method => { %><span class="badge text-bg-light border me-1 mb-1"><%= method %></span><% }) %></td>
          <td><div class="text-truncate" style="max-width:300px" title="<%= definition.description %>"><%= definition.description %></div></td>
          <td><%= definition.frequency || '-' %><div class="small text-secondary"><%= definition.access_mode || '-' %></div></td>
          <td><span class="badge text-bg-light border"><%= (definition.standard_items || []).length %> 项</span><div class="small text-secondary text-truncate" style="max-width:170px"><%= (definition.standard_items || []).map(item => item.standardNumber || item.code).join('、') || '未关联' %></div></td>
          <td><span class="badge <%= definition.priority === '重点项' ? 'text-bg-warning' : 'text-bg-light border' %>"><%= definition.priority || '未指定重点级别' %></span><div class="small text-secondary mt-1"><%= definition.recognized_object === true ? '公认对象' : definition.recognized_object === false ? '非公认对象' : '公认对象未指定' %></div><span class="badge mt-1 <%= definition.status === 'active' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= definition.status === 'active' ? '有效' : '已归并' %></span></td>
          <td class="text-end text-nowrap"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#definitionDetailModal" data-definition="<%= JSON.stringify(definition) %>">详情</button><% if (definition.status === 'active' && user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %> <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editDefinitionModal" data-definition="<%= JSON.stringify(definition) %>">编辑</button><% } %></td>
        </tr>
      <% }) %>
      <% if (!definitions.length) { %><tr><td colspan="9" class="text-center text-secondary py-5">没有找到匹配的检查方案。</td></tr><% } %>
    </tbody>
  </table></div>
  <% if (pageCountValue > 1) { %><div class="card-footer d-flex flex-wrap align-items-center gap-2"><span class="small text-secondary">第 <%= pageValue %> / <%= pageCountValue %> 页</span><nav class="ms-auto" aria-label="检查方案分页"><ul class="pagination pagination-sm mb-0"><li class="page-item <%= pageValue <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= pageValue <= 1 ? '#' : buildPageUrl(pageValue - 1) %>">上一页</a></li><% for (let number = 1; number <= pageCountValue; number += 1) { %><li class="page-item <%= number === pageValue ? 'active' : '' %>"><a class="page-link" href="<%= buildPageUrl(number) %>"><%= number %></a></li><% } %><li class="page-item <%= pageValue >= pageCountValue ? 'disabled' : '' %>"><a class="page-link" href="<%= pageValue >= pageCountValue ? '#' : buildPageUrl(pageValue + 1) %>">下一页</a></li></ul></nav></div><% } %>
</div>

<div class="modal fade" id="definitionDetailModal" tabindex="-1" aria-labelledby="definitionDetailModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="definitionDetailModalLabel">检查方案详情</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body" id="definitionDetailBody"></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">关闭</button></div></div></div></div>

<div class="modal fade" id="planImportModal" tabindex="-1" aria-labelledby="planImportModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/supervision-plan-imports" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="planImportModalLabel">导入检查方案</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><p class="small text-secondary">上传后先校验标准化编号和方案字段，确认预览无误后才写入。X编号行会忽略；混合编号只保留有效系统标准化编号。执行结果、检查人、时间和证据不在此导入。</p><input class="form-control" type="file" name="file" accept=".xlsx" required><div class="form-text mt-2"><a href="/supervision-definitions/import-template">先下载检查方案导入模板</a></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">上传并预览</button></div>
  </form>
</div></div></div>

<datalist id="createCategoryOptions"><% objectCategoriesValue.forEach(category => { %><option value="<%= category.name %>"></option><% }) %></datalist>
<datalist id="editCategoryOptions"><% objectCategoriesValue.forEach(category => { %><option value="<%= category.name %>"></option><% }) %></datalist>
<datalist id="createObjectOptions"></datalist>
<datalist id="editObjectOptions"></datalist>
<datalist id="createCheckLayerOptions"><% checkLayerOptionsValue.forEach(value => { %><option value="<%= value %>"></option><% }) %></datalist>
<datalist id="editCheckLayerOptions"><% checkLayerOptionsValue.forEach(value => { %><option value="<%= value %>"></option><% }) %></datalist>
<datalist id="createFrequencyOptions"><% frequencyOptionsValue.forEach(value => { %><option value="<%= value %>"></option><% }) %></datalist>
<datalist id="editFrequencyOptions"><% frequencyOptionsValue.forEach(value => { %><option value="<%= value %>"></option><% }) %></datalist>

<div class="modal fade" id="createDefinitionModal" tabindex="-1" aria-labelledby="createDefinitionModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form id="createDefinitionForm" method="post" action="/supervision-definitions"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="scope" value="">
    <div class="modal-header"><h2 class="modal-title fs-5" id="createDefinitionModalLabel">新增检查方案</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body p-0">
      <ul class="nav nav-tabs px-4 pt-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="createBasicTab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#createBasicPane" aria-controls="createBasicPane" aria-selected="true">基本信息</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="createRequirementTab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#createRequirementPane" aria-controls="createRequirementPane" aria-selected="false">检查要求</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="createStandardsTab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#createStandardsPane" aria-controls="createStandardsPane" aria-selected="false">关联标准项 <span class="badge text-bg-light border ms-1" id="createStandardItemCount">0</span></button></li>
      </ul>
      <div class="tab-content px-4 py-3">
        <section class="tab-pane fade show active" id="createBasicPane" role="tabpanel" aria-labelledby="createBasicTab" tabindex="0">
          <div class="row g-3">
            <div class="col-md-8"><label class="form-label" for="createObjectName">检查对象</label><input class="form-control" id="createObjectName" name="objectName" list="createObjectOptions" autocomplete="off" required maxlength="500" placeholder="输入名称、别名或先选择分类"><div class="form-text">来自“中心检查对象”规范对象主数据；必须选择一个已有对象。</div></div>
            <div class="col-md-4"><label class="form-label" for="createObjectCategory">对象分类</label><input class="form-control" id="createObjectCategory" name="objectCategory" list="createCategoryOptions" autocomplete="off" placeholder="可先选分类筛选对象"><div class="form-text">分类来自对象工作台，选择对象后自动关联。</div></div>
            <div class="col-md-4"><label class="form-label" for="createCheckLayer">检查层面</label><input class="form-control" id="createCheckLayer" name="checkLayer" list="createCheckLayerOptions" autocomplete="off" placeholder="选择现有值或输入新值"></div>
            <div class="col-md-4"><label class="form-label" for="createRecognizedObject">是否公认对象</label><select class="form-select" id="createRecognizedObject" name="recognizedObject"><option value="">未指定</option><option value="true">是</option><option value="false">否</option></select></div>
            <div class="col-md-4"><label class="form-label" for="createPriority">重点项</label><select class="form-select" id="createPriority" name="priority"><option value="">未指定</option><option>重点项</option><option>非重点项</option></select></div>
            <div class="col-12"><label class="form-label d-block">适用检查中心</label><div class="d-flex flex-wrap gap-2" id="createCenters"><% centerOptionsValue.forEach((centerOption, index) => { %><input class="btn-check" type="checkbox" name="centers" id="createCenter<%= index %>" value="<%= centerOption %>" autocomplete="off"><label class="btn btn-outline-secondary" for="createCenter<%= index %>"><%= centerOption %></label><% }) %></div><div class="form-text">来自原表“检查项位于”；可多选，执行时按中心分别记录。</div></div>
          </div>
        </section>
        <section class="tab-pane fade" id="createRequirementPane" role="tabpanel" aria-labelledby="createRequirementTab" tabindex="0">
          <div class="row g-3">
            <div class="col-12"><label class="form-label d-block">检查方法</label><div class="d-flex flex-wrap gap-2" id="createCheckMethods"><% checkMethodOptions.forEach((method, index) => { %><input class="btn-check" type="checkbox" name="checkMethods" id="createMethod<%= index %>" value="<%= method %>" autocomplete="off"><label class="btn btn-outline-secondary" for="createMethod<%= index %>"><%= method %></label><% }) %></div></div>
            <div class="col-md-6"><label class="form-label" for="createAdditionalCheckMethods">其他检查方法</label><input class="form-control" id="createAdditionalCheckMethods" name="additionalCheckMethods" placeholder="多个方法用逗号分隔"></div>
            <div class="col-md-3"><label class="form-label" for="createFrequency">执行频率</label><input class="form-control" id="createFrequency" name="frequency" list="createFrequencyOptions" autocomplete="off" placeholder="选择现有值或输入新值"></div>
            <div class="col-md-3"><label class="form-label" for="createAccessMode">远程/现场查看</label><select class="form-select" id="createAccessMode" name="accessMode"><option value="">未指定</option><option value="远程">远程</option><option value="现场">现场</option><option value="远程+现场">远程+现场</option></select></div>
            <div class="col-12"><label class="form-label" for="createDescription">检查项描述</label><textarea class="form-control" id="createDescription" name="description" rows="4" required maxlength="5000"></textarea></div>
            <div class="col-12"><label class="form-label" for="createSteps">检查步骤</label><textarea class="form-control" id="createSteps" name="steps" rows="4"></textarea></div>
            <div class="col-12"><details class="border-top pt-3"><summary class="text-secondary">其他参考信息（可选）</summary><div class="row g-3 mt-1"><div class="col-md-6"><label class="form-label" for="createReferenceResult">检查结果参考描述</label><textarea class="form-control" id="createReferenceResult" name="referenceResult" rows="2"></textarea></div><div class="col-md-6"><label class="form-label" for="createReferenceMaterials">参考材料</label><textarea class="form-control" id="createReferenceMaterials" name="referenceMaterials" rows="2"></textarea></div></div></details></div>
          </div>
        </section>
        <section class="tab-pane fade" id="createStandardsPane" role="tabpanel" aria-labelledby="createStandardsTab" tabindex="0">
          <label class="form-label" for="createStandardSearch">关联标准项</label>
          <select class="d-none" id="createStandardItems" name="standardItemIds" multiple></select>
          <div class="standard-picker" data-picker="createStandardPicker">
            <div class="standard-picker-selected d-flex flex-wrap gap-2 mb-2" id="createStandardChips"></div>
            <input class="form-control" id="createStandardSearch" type="search" autocomplete="off" placeholder="输入标准编号、条款编号或内容搜索">
            <div class="standard-picker-results list-group shadow-sm mt-1 d-none" id="createStandardResults"></div>
          </div>
          <div class="form-text">支持标准编号、内部编号、标题和正文内容搜索；已选项会显示在上方。</div>
        </section>
      </div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存检查方案</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="editDefinitionModal" tabindex="-1" aria-labelledby="editDefinitionModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form id="editDefinitionForm" method="post" action=""><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" id="editScope" name="scope">
    <div class="modal-header"><h2 class="modal-title fs-5" id="editDefinitionModalLabel">编辑检查方案</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body p-0">
      <ul class="nav nav-tabs px-4 pt-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="editBasicTab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#editBasicPane" aria-controls="editBasicPane" aria-selected="true">基本信息</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="editRequirementTab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#editRequirementPane" aria-controls="editRequirementPane" aria-selected="false">检查要求</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="editStandardsTab" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#editStandardsPane" aria-controls="editStandardsPane" aria-selected="false">关联标准项 <span class="badge text-bg-light border ms-1" id="editStandardItemCount">0</span></button></li>
      </ul>
      <div class="tab-content px-4 py-3">
        <section class="tab-pane fade show active" id="editBasicPane" role="tabpanel" aria-labelledby="editBasicTab" tabindex="0">
          <div class="row g-3">
            <div class="col-md-8"><label class="form-label" for="editObjectName">检查对象</label><input class="form-control" id="editObjectName" name="objectName" list="editObjectOptions" autocomplete="off" required maxlength="500"><div class="form-text">来自“中心检查对象”规范对象主数据；必须选择一个已有对象。</div></div>
            <div class="col-md-4"><label class="form-label" for="editObjectCategory">对象分类</label><input class="form-control" id="editObjectCategory" name="objectCategory" list="editCategoryOptions" autocomplete="off"><div class="form-text">选择对象后自动关联。</div></div>
            <div class="col-md-4"><label class="form-label" for="editCheckLayer">检查层面</label><input class="form-control" id="editCheckLayer" name="checkLayer" list="editCheckLayerOptions" autocomplete="off"></div>
            <div class="col-md-4"><label class="form-label" for="editRecognizedObject">是否公认对象</label><select class="form-select" id="editRecognizedObject" name="recognizedObject"><option value="">未指定</option><option value="true">是</option><option value="false">否</option></select></div>
            <div class="col-md-4"><label class="form-label" for="editPriority">重点项</label><select class="form-select" id="editPriority" name="priority"><option value="">未指定</option><option>重点项</option><option>非重点项</option></select></div>
            <div class="col-12"><label class="form-label d-block">适用检查中心</label><div class="d-flex flex-wrap gap-2" id="editCenters"><% centerOptionsValue.forEach((centerOption, index) => { %><input class="btn-check" type="checkbox" name="centers" id="editCenter<%= index %>" value="<%= centerOption %>" autocomplete="off"><label class="btn btn-outline-secondary" for="editCenter<%= index %>"><%= centerOption %></label><% }) %></div><div class="form-text">来自原表“检查项位于”；执行时按中心分别记录。</div></div>
          </div>
        </section>
        <section class="tab-pane fade" id="editRequirementPane" role="tabpanel" aria-labelledby="editRequirementTab" tabindex="0">
          <div class="row g-3">
