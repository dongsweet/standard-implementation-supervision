<%
  const searchValue = typeof search === 'undefined' ? '' : search;
  const statusValue = typeof status === 'undefined' ? '' : status;
  const priorityValue = typeof priority === 'undefined' ? '' : priority;
  const checkMethodValue = typeof checkMethod === 'undefined' ? '' : checkMethod;
  const scopeValue = typeof scope === 'undefined' ? '' : scope;
  const scopesValue = typeof scopes === 'undefined' ? [] : scopes;
  const totalValue = typeof total === 'undefined' ? definitions.length : total;
  const pageValue = typeof page === 'undefined' ? 1 : page;
  const pageCountValue = typeof pageCount === 'undefined' ? 1 : pageCount;
  const buildPageUrl = targetPage => {
    const params = [];
    if (searchValue) params.push('search=' + encodeURIComponent(searchValue));
    if (statusValue) params.push('status=' + encodeURIComponent(statusValue));
    if (priorityValue) params.push('priority=' + encodeURIComponent(priorityValue));
    if (checkMethodValue) params.push('checkMethod=' + encodeURIComponent(checkMethodValue));
    if (scopeValue) params.push('scope=' + encodeURIComponent(scopeValue));
    params.push('page=' + targetPage);
    return '?' + params.join('&');
  };
%>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <p class="text-secondary mb-0">检查方案是系统级可复用定义；选择具体项目后，在“检查记录”中按该项目纳入的标准项执行并记录结果。</p>
  <% if (user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %><div class="ms-auto d-flex gap-2"><a class="btn btn-outline-secondary" href="/supervision-definitions/import-template">下载导入模板</a><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#planImportModal">导入检查方案</button><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createDefinitionModal">新增检查方案</button></div><% } %>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="get" action="/supervision-definitions" class="row g-2 align-items-end">
      <div class="col-12 col-md-6 col-xl-4"><label class="form-label" for="definitionSearch">查找</label><input class="form-control" id="definitionSearch" name="search" value="<%= searchValue %>" placeholder="方案编号、检查对象、描述或标准编号"></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionPriority">重点项</label><select class="form-select" id="definitionPriority" name="priority"><option value="">全部</option><option value="重点项" <%= priorityValue === '重点项' ? 'selected' : '' %>>重点项</option><option value="非重点项" <%= priorityValue === '非重点项' ? 'selected' : '' %>>非重点项</option><option value="未指定" <%= priorityValue === '未指定' ? 'selected' : '' %>>未指定</option></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionMethod">检查方法</label><select class="form-select" id="definitionMethod" name="checkMethod"><option value="">全部方法</option><% checkMethodOptions.forEach(method => { %><option value="<%= method %>" <%= checkMethodValue === method ? 'selected' : '' %>><%= method %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionScope">检查范围</label><select class="form-select" id="definitionScope" name="scope"><option value="">全部范围</option><% scopesValue.forEach(scopeOption => { %><option value="<%= scopeOption %>" <%= scopeValue === scopeOption ? 'selected' : '' %>><%= scopeOption %></option><% }) %></select></div>
      <div class="col-6 col-md-3 col-xl-2"><label class="form-label" for="definitionStatus">状态</label><select class="form-select" id="definitionStatus" name="status"><option value="">全部状态</option><option value="active" <%= statusValue === 'active' ? 'selected' : '' %>>有效</option><option value="merged" <%= statusValue === 'merged' ? 'selected' : '' %>>已归并</option></select></div>
      <div class="col-12 d-flex justify-content-end gap-2"><button class="btn btn-outline-primary" type="submit">查找</button><a class="btn btn-outline-secondary" href="/supervision-definitions">重置</a></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex align-items-center"><h3 class="card-title">检查方案列表</h3><span class="badge text-bg-secondary ms-auto"><%= totalValue %> 条</span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>检查方案</th><th>检查方法</th><th>检查描述</th><th>频率/方式</th><th>关联标准项</th><th>方案属性</th><th class="text-end">操作</th></tr></thead>
    <tbody>
      <% definitions.forEach(definition => { %>
        <tr>
          <td><span class="badge text-bg-primary me-1"><%= String(definition.plan_number || '').padStart(3, '0') %></span><strong><%= definition.object_name %></strong><div class="small text-secondary mt-1"><%= definition.scope || '未指定范围' %></div></td>
          <td><% (definition.check_method || '').split(/[,，、;；\/|\r\n]+/).map(method => method.trim()).filter(Boolean).forEach(method => { %><span class="badge text-bg-light border me-1 mb-1"><%= method %></span><% }) %></td>
          <td><div class="text-truncate" style="max-width:300px" title="<%= definition.description %>"><%= definition.description %></div></td>
          <td><%= definition.frequency || '-' %><div class="small text-secondary"><%= definition.access_mode || '-' %></div></td>
          <td><span class="badge text-bg-light border"><%= (definition.standard_items || []).length %> 项</span><div class="small text-secondary text-truncate" style="max-width:170px"><%= (definition.standard_items || []).map(item => item.standardNumber || item.code).join('、') || '未关联' %></div></td>
          <td><span class="badge <%= definition.priority === '重点项' ? 'text-bg-warning' : 'text-bg-light border' %>"><%= definition.priority || '未指定重点级别' %></span><div class="small text-secondary mt-1"><%= definition.recognized_object === true ? '公认对象' : definition.recognized_object === false ? '非公认对象' : '公认对象未指定' %></div><span class="badge mt-1 <%= definition.status === 'active' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= definition.status === 'active' ? '有效' : '已归并' %></span></td>
          <td class="text-end text-nowrap"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#definitionDetailModal" data-definition="<%= JSON.stringify(definition) %>">详情</button><% if (definition.status === 'active' && user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %> <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editDefinitionModal" data-definition="<%= JSON.stringify(definition) %>">编辑</button><% } %></td>
        </tr>
      <% }) %>
      <% if (!definitions.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">没有找到匹配的检查方案。</td></tr><% } %>
    </tbody>
  </table></div>
  <% if (pageCountValue > 1) { %><div class="card-footer d-flex flex-wrap align-items-center gap-2"><span class="small text-secondary">第 <%= pageValue %> / <%= pageCountValue %> 页</span><nav class="ms-auto" aria-label="检查方案分页"><ul class="pagination pagination-sm mb-0"><li class="page-item <%= pageValue <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= pageValue <= 1 ? '#' : buildPageUrl(pageValue - 1) %>">上一页</a></li><% for (let number = 1; number <= pageCountValue; number += 1) { %><li class="page-item <%= number === pageValue ? 'active' : '' %>"><a class="page-link" href="<%= buildPageUrl(number) %>"><%= number %></a></li><% } %><li class="page-item <%= pageValue >= pageCountValue ? 'disabled' : '' %>"><a class="page-link" href="<%= pageValue >= pageCountValue ? '#' : buildPageUrl(pageValue + 1) %>">下一页</a></li></ul></nav></div><% } %>
</div>

<div class="modal fade" id="definitionDetailModal" tabindex="-1" aria-labelledby="definitionDetailModalLabel" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="definitionDetailModalLabel">检查方案详情</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body" id="definitionDetailBody"></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">关闭</button></div></div></div></div>

<div class="modal fade" id="planImportModal" tabindex="-1" aria-labelledby="planImportModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/supervision-plan-imports" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="planImportModalLabel">导入检查方案</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><p class="small text-secondary">上传后先校验标准化编号和方案字段，确认预览无误后才写入。X编号行会忽略；混合编号只保留有效系统标准化编号。执行结果、检查人、时间和证据不在此导入。</p><input class="form-control" type="file" name="file" accept=".xlsx" required><div class="form-text mt-2"><a href="/supervision-definitions/import-template">先下载检查方案导入模板</a></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">上传并预览</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="createDefinitionModal" tabindex="-1" aria-labelledby="createDefinitionModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form id="createDefinitionForm" method="post" action="/supervision-definitions"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="createDefinitionModalLabel">新增检查方案</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-md-4"><label class="form-label" for="createObjectName">检查对象</label><input class="form-control" id="createObjectName" name="objectName" required maxlength="500" placeholder="例如：云平台账号管理"></div>
      <div class="col-md-4"><label class="form-label" for="createScope">检查范围</label><input class="form-control" id="createScope" name="scope" placeholder="例如：云中心"></div>
      <div class="col-md-2"><label class="form-label" for="createRecognizedObject">公认对象</label><select class="form-select" id="createRecognizedObject" name="recognizedObject"><option value="">未指定</option><option value="true">是</option><option value="false">否</option></select></div>
      <div class="col-md-2"><label class="form-label" for="createPriority">重点项</label><select class="form-select" id="createPriority" name="priority"><option value="">未指定</option><option>重点项</option><option>非重点项</option></select></div>
      <div class="col-md-4"><label class="form-label" for="createObjectCategory">对象分类</label><input class="form-control" id="createObjectCategory" name="objectCategory" placeholder="例如：制度、技术、现场"></div>
      <div class="col-md-4"><label class="form-label" for="createCheckLayer">检查层面</label><input class="form-control" id="createCheckLayer" name="checkLayer" placeholder="例如：管理、配置、运行"></div>
      <div class="col-md-6"><label class="form-label" for="createCheckMethods">检查方法（可多选）</label><select class="form-select" id="createCheckMethods" name="checkMethods" multiple size="6"><% checkMethodOptions.forEach(method => { %><option value="<%= method %>"><%= method %></option><% }) %></select><div class="form-text">按住 Ctrl/⌘ 可多选；也可在右侧填写其他方法。</div></div>
      <div class="col-md-6"><label class="form-label" for="createAdditionalCheckMethods">其他检查方法</label><input class="form-control" id="createAdditionalCheckMethods" name="additionalCheckMethods" placeholder="如有多个，用逗号分隔"></div>
      <div class="col-md-3"><label class="form-label" for="createFrequency">频率</label><input class="form-control" id="createFrequency" name="frequency" placeholder="例如：每季度"></div>
      <div class="col-md-3"><label class="form-label" for="createAccessMode">远程/现场方式</label><select class="form-select" id="createAccessMode" name="accessMode"><option value="">未指定</option><option value="远程">远程</option><option value="现场">现场</option><option value="远程+现场">远程+现场</option></select></div>
      <div class="col-12"><label class="form-label" for="createDescription">检查描述</label><textarea class="form-control" id="createDescription" name="description" rows="3" required maxlength="5000"></textarea></div>
      <div class="col-12"><label class="form-label" for="createSteps">检查步骤</label><textarea class="form-control" id="createSteps" name="steps" rows="3" placeholder="按顺序填写检查步骤"></textarea></div>
      <div class="col-md-6"><label class="form-label" for="createReferenceResult">参考判定描述</label><textarea class="form-control" id="createReferenceResult" name="referenceResult" rows="3"></textarea></div>
      <div class="col-md-6"><label class="form-label" for="createReferenceMaterials">参考材料</label><textarea class="form-control" id="createReferenceMaterials" name="referenceMaterials" rows="3"></textarea></div>
      <div class="col-12"><label class="form-label" for="createStandardItems">关联标准项（可多选）</label><select class="form-select" id="createStandardItems" name="standardItemIds" multiple size="8" required><% standardItems.forEach(item => { %><option value="<%= item.id %>"><%= item.standard_code %> / <%= item.version %> · <%= item.item_code %> <%= item.title ? '· ' + item.title : '' %></option><% }) %></select><div class="form-text">一条监督定义可以覆盖多个标准项；按住 Ctrl/⌘ 可多选。</div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存检查方案</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="editDefinitionModal" tabindex="-1" aria-labelledby="editDefinitionModalLabel" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form id="editDefinitionForm" method="post" action=""><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="editDefinitionModalLabel">编辑检查方案</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body row g-3">
      <div class="col-md-4"><label class="form-label" for="editObjectName">检查对象</label><input class="form-control" id="editObjectName" name="objectName" required maxlength="500"></div>
      <div class="col-md-4"><label class="form-label" for="editScope">检查范围</label><input class="form-control" id="editScope" name="scope"></div>
      <div class="col-md-2"><label class="form-label" for="editRecognizedObject">公认对象</label><select class="form-select" id="editRecognizedObject" name="recognizedObject"><option value="">未指定</option><option value="true">是</option><option value="false">否</option></select></div>
      <div class="col-md-2"><label class="form-label" for="editPriority">重点项</label><select class="form-select" id="editPriority" name="priority"><option value="">未指定</option><option>重点项</option><option>非重点项</option></select></div>
      <div class="col-md-4"><label class="form-label" for="editObjectCategory">对象分类</label><input class="form-control" id="editObjectCategory" name="objectCategory"></div>
      <div class="col-md-4"><label class="form-label" for="editCheckLayer">检查层面</label><input class="form-control" id="editCheckLayer" name="checkLayer"></div>
      <div class="col-md-6"><label class="form-label" for="editCheckMethods">检查方法（可多选）</label><select class="form-select" id="editCheckMethods" name="checkMethods" multiple size="6"><% checkMethodOptions.forEach(method => { %><option value="<%= method %>"><%= method %></option><% }) %></select><div class="form-text">按住 Ctrl/⌘ 可多选；也可在右侧填写其他方法。</div></div>
      <div class="col-md-6"><label class="form-label" for="editAdditionalCheckMethods">其他检查方法</label><input class="form-control" id="editAdditionalCheckMethods" name="additionalCheckMethods" placeholder="如有多个，用逗号分隔"></div>
      <div class="col-md-3"><label class="form-label" for="editFrequency">频率</label><input class="form-control" id="editFrequency" name="frequency"></div>
      <div class="col-md-3"><label class="form-label" for="editAccessMode">远程/现场方式</label><select class="form-select" id="editAccessMode" name="accessMode"><option value="">未指定</option><option value="远程">远程</option><option value="现场">现场</option><option value="远程+现场">远程+现场</option></select></div>
      <div class="col-12"><label class="form-label" for="editDescription">检查描述</label><textarea class="form-control" id="editDescription" name="description" rows="3" required maxlength="5000"></textarea></div>
      <div class="col-12"><label class="form-label" for="editSteps">检查步骤</label><textarea class="form-control" id="editSteps" name="steps" rows="3"></textarea></div>
      <div class="col-md-6"><label class="form-label" for="editReferenceResult">参考判定描述</label><textarea class="form-control" id="editReferenceResult" name="referenceResult" rows="3"></textarea></div>
      <div class="col-md-6"><label class="form-label" for="editReferenceMaterials">参考材料</label><textarea class="form-control" id="editReferenceMaterials" name="referenceMaterials" rows="3"></textarea></div>
      <div class="col-12"><label class="form-label" for="editStandardItems">关联标准项（可多选）</label><select class="form-select" id="editStandardItems" name="standardItemIds" multiple size="8" required><% standardItems.forEach(item => { %><option value="<%= item.id %>"><%= item.standard_code %> / <%= item.version %> · <%= item.item_code %> <%= item.title ? '· ' + item.title : '' %></option><% }) %></select></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存修改</button></div>
  </form>
</div></div></div>
<script>
  document.getElementById('definitionDetailModal').addEventListener('show.bs.modal', event => {
    const definition = JSON.parse(event.relatedTarget.dataset.definition);
    const body = document.getElementById('definitionDetailBody');
    const rows = [
      ['方案编号', String(definition.plan_number || '').padStart(3, '0')],
      ['检查对象', definition.object_name],
      ['范围 / 分类 / 层面', [definition.scope, definition.object_category, definition.check_layer].filter(Boolean).join(' / ') || '未指定'],
      ['检查方法', definition.check_method],
      ['检查频率 / 执行方式', [definition.frequency, definition.access_mode].filter(Boolean).join(' / ') || '未指定'],
      ['检查描述', definition.description],
      ['检查步骤', definition.steps || '未填写'],
      ['参考判定', definition.reference_result || '未填写'],
      ['参考材料', definition.reference_materials || '未填写'],
      ['关联标准项', (definition.standard_items || []).map(item => [item.standardCode, item.version, item.standardNumber || item.code].filter(Boolean).join(' · ')).join('；') || '未关联'],
    ];
    body.replaceChildren(...rows.map(([label, value]) => {
      const row = document.createElement('div');
      row.className = 'row g-2 border-bottom py-2';
      const labelElement = document.createElement('div');
      labelElement.className = 'col-sm-3 text-secondary';
      labelElement.textContent = label;
      const valueElement = document.createElement('div');
      valueElement.className = 'col-sm-9 text-break';
      valueElement.textContent = value || '未填写';
      row.append(labelElement, valueElement);
      return row;
    }));
  });
  document.getElementById('editDefinitionModal').addEventListener('show.bs.modal', event => {
    const definition = JSON.parse(event.relatedTarget.dataset.definition);
    const form = document.getElementById('editDefinitionForm');
    form.action = '/supervision-definitions/' + definition.id;
    const fields = {
      editObjectName: definition.object_name,
      editScope: definition.scope || '',
      editObjectCategory: definition.object_category || '',
      editCheckLayer: definition.check_layer || '',
      editFrequency: definition.frequency || '',
      editDescription: definition.description,
      editSteps: definition.steps || '',
      editReferenceResult: definition.reference_result || '',
      editReferenceMaterials: definition.reference_materials || '',
    };
    Object.entries(fields).forEach(([id, value]) => { document.getElementById(id).value = value; });
    const methods = new Set((definition.check_method || '').split(/[,，、;；\/|\r\n]+/).map(method => method.trim()).filter(Boolean));
    const methodSelect = document.getElementById('editCheckMethods');
    const knownMethods = new Set(Array.from(methodSelect.options).map(option => option.value));
    Array.from(methodSelect.options).forEach(option => { option.selected = methods.has(option.value); });
    document.getElementById('editAdditionalCheckMethods').value = Array.from(methods).filter(method => !knownMethods.has(method)).join(',');
    document.getElementById('editAccessMode').value = definition.access_mode || '';
    document.getElementById('editRecognizedObject').value = definition.recognized_object === null ? '' : String(definition.recognized_object);
    document.getElementById('editPriority').value = definition.priority || '';
    const selected = new Set((definition.standard_items || []).map(item => item.id));
    Array.from(document.getElementById('editStandardItems').options).forEach(option => { option.selected = selected.has(option.value); });
  });
  [
    ['createDefinitionForm', 'createCheckMethods', 'createAdditionalCheckMethods'],
    ['editDefinitionForm', 'editCheckMethods', 'editAdditionalCheckMethods'],
  ].forEach(([formId, selectId, otherId]) => {
    const form = document.getElementById(formId);
    const select = document.getElementById(selectId);
    const other = document.getElementById(otherId);
    const clearError = () => select.setCustomValidity('');
    select.addEventListener('change', clearError);
    other.addEventListener('input', clearError);
    form.addEventListener('submit', event => {
      if (select.selectedOptions.length || other.value.trim()) return;
      event.preventDefault();
      select.setCustomValidity('请选择或填写至少一种检查方法。');
      select.reportValidity();
    });
  });
</script>
