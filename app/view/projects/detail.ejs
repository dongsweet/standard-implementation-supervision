<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><span class="text-secondary">项目状态：<strong><%= project.status %></strong>　项目管理员：<strong><%= project.project_manager_name || '-' %></strong>　<% if (project.source_project_name) { %>基于项目：<strong><%= project.source_project_name %></strong>（创建时复制，之后独立维护）<% } %></span><a class="btn btn-sm btn-outline-primary ms-auto" href="/projects/<%= project.id %>/manage">项目配置与权限</a></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">项目固定基线版本</h3></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>规范</th><th>版本</th><th>快照时间</th><th>标准项数</th></tr></thead><tbody><% (versionsInProject || []).forEach(version => { %><tr><td><%= version.standard_code %> · <%= version.standard_name %></td><td><%= version.version %></td><td><%= new Date(version.snapshot_at).toLocaleString('zh-CN') %></td><td><%= version.item_count %></td></tr><% }) %><% if (!(versionsInProject || []).length) { %><tr><td colspan="4" class="text-center text-secondary">尚未配置固定基线</td></tr><% } %></tbody></table></div></div>
<div class="card"><div class="card-header"><h3 class="card-title">章节应答（项目标准项快照）</h3><div class="card-tools text-secondary">共 <%= items.length %> 项</div></div><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead><tr><th>标准项</th><th>规范要求</th><th>项目适用性</th><th>应答状态</th><th>项目实际证据</th><th>落实情况</th><th>操作</th></tr></thead><tbody>
<% items.forEach(item => { %><tr><td><strong><%= item.item_code_snapshot %></strong><div class="small text-secondary font-monospace"><%= item.standard_number_snapshot || '-' %></div><div class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.title || '' %></div><div class="small text-secondary"><%= item.standard_level || '-' %> · <%= item.is_key ? '重点项' : '普通项' %></div></td><td><div><%= item.content_snapshot %></div></td><td><span class="badge <%= item.applicability === 'applicable' ? 'text-bg-primary' : item.applicability === 'not_applicable' ? 'text-bg-secondary' : 'text-bg-light' %>"><%= item.applicability === 'applicable' ? '适用' : item.applicability === 'not_applicable' ? '不适用' : '未判断' %></span><% if (item.applicability_scope) { %><div class="small text-secondary mt-1"><%= item.applicability_scope %></div><% } %></td><td><span class="badge <%= item.answer_status === 'satisfied' ? 'text-bg-success' : item.answer_status === 'partially_satisfied' ? 'text-bg-warning' : item.answer_status === 'not_satisfied' ? 'text-bg-danger' : 'text-bg-secondary' %>"><%= item.answer_status === 'satisfied' ? '满足' : item.answer_status === 'partially_satisfied' ? '部分满足' : item.answer_status === 'not_satisfied' ? '不满足' : '未评估' %></span></td><td><%= item.actual_evidence || '-' %></td><td><%= item.measure_description || '-' %><% if (item.problem_description) { %><div class="small text-danger mt-1">问题：<%= item.problem_description %></div><% } %></td><td><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#answerModal-<%= item.standard_item_id %>">编辑应答</button></td></tr><% }) %>
<% if (!items.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">当前项目尚无标准项快照。请先将规范版本纳入项目基线。</td></tr><% } %></tbody></table></div></div>
<% items.forEach(item => { %>
  <div class="modal fade" id="answerModal-<%= item.standard_item_id %>" tabindex="-1" aria-labelledby="answerModalLabel-<%= item.standard_item_id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <form method="post" action="/projects/<%= project.id %>/answers/<%= item.standard_item_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="answerModalLabel-<%= item.standard_item_id %>">编辑章节应答 · <%= item.item_code_snapshot %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body">
        <p class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.title || '' %></p>
        <div class="border rounded p-3 mb-3 bg-body-tertiary"><%= item.content_snapshot %></div>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label" for="standardLevel-<%= item.standard_item_id %>">级别</label><input class="form-control" id="standardLevel-<%= item.standard_item_id %>" name="standardLevel" value="<%= item.standard_level %>" placeholder="例如：一般要求"></div>
          <div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="isKey-<%= item.standard_item_id %>" name="isKey" value="true" <%= item.is_key ? 'checked' : '' %>><label class="form-check-label" for="isKey-<%= item.standard_item_id %>">重点项</label></div></div>
          <div class="col-md-4"><label class="form-label" for="clauseAssignment-<%= item.standard_item_id %>">条款占位符赋值</label><input class="form-control" id="clauseAssignment-<%= item.standard_item_id %>" name="clauseAssignment" value="<%= item.clause_assignment %>" placeholder="例如：7天、火灾"></div>
          <div class="col-md-6"><label class="form-label" for="unifiedRequirement-<%= item.standard_item_id %>">多云统管体系具体要求</label><textarea class="form-control" id="unifiedRequirement-<%= item.standard_item_id %>" name="unifiedRequirement" rows="3"><%= item.unified_requirement %></textarea></div>
          <div class="col-md-6"><label class="form-label" for="expectedEvidence-<%= item.standard_item_id %>">统一规范实施证据列表</label><textarea class="form-control" id="expectedEvidence-<%= item.standard_item_id %>" name="expectedEvidence" rows="3"><%= item.expected_evidence %></textarea></div>
          <div class="col-md-5"><label class="form-label" for="applicability-<%= item.standard_item_id %>">项目适用性</label><select class="form-select" id="applicability-<%= item.standard_item_id %>" name="applicability"><option value="unspecified" <%= item.applicability === 'unspecified' ? 'selected' : '' %>>未判断</option><option value="applicable" <%= item.applicability === 'applicable' ? 'selected' : '' %>>适用</option><option value="not_applicable" <%= item.applicability === 'not_applicable' ? 'selected' : '' %>>不适用</option></select></div>
          <div class="col-md-7"><label class="form-label" for="applicabilityScope-<%= item.standard_item_id %>">适用云中心或服务商范围</label><input class="form-control" id="applicabilityScope-<%= item.standard_item_id %>" name="applicabilityScope" value="<%= item.applicability_scope %>" placeholder="例如：抚州政务云、新疆政务云"></div>
          <div class="col-md-5"><label class="form-label" for="answerStatus-<%= item.standard_item_id %>">满足情况</label><select class="form-select" id="answerStatus-<%= item.standard_item_id %>" name="status"><option value="unassessed" <%= item.answer_status === 'unassessed' ? 'selected' : '' %>>未评估</option><option value="satisfied" <%= item.answer_status === 'satisfied' ? 'selected' : '' %>>满足</option><option value="partially_satisfied" <%= item.answer_status === 'partially_satisfied' ? 'selected' : '' %>>部分满足</option><option value="not_satisfied" <%= item.answer_status === 'not_satisfied' ? 'selected' : '' %>>不满足</option></select></div>
          <div class="col-md-7"><label class="form-label" for="actualEvidence-<%= item.standard_item_id %>">项目实际证据清单</label><textarea class="form-control" id="actualEvidence-<%= item.standard_item_id %>" name="actualEvidence" rows="2" placeholder="填写本项目实际已有或应上传的证据材料名称"><%= item.actual_evidence %></textarea></div>
          <div class="col-12"><label class="form-label" for="measureDescription-<%= item.standard_item_id %>">实际落实情况</label><textarea class="form-control" id="measureDescription-<%= item.standard_item_id %>" name="measureDescription" rows="4" placeholder="说明本项目已经采取的措施、实施范围和检查结论"><%= item.measure_description %></textarea></div>
          <div class="col-12"><label class="form-label" for="problemDescription-<%= item.standard_item_id %>">问题与整改说明</label><textarea class="form-control" id="problemDescription-<%= item.standard_item_id %>" name="problemDescription" rows="3"><%= item.problem_description %></textarea></div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存应答</button></div>
    </form>
  </div></div></div>
<% }) %>
