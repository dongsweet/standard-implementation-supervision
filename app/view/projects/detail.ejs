<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="text-secondary">当前项目：<strong><%= project.name %></strong>　状态：<span class="badge text-bg-secondary"><%= project.status %></span><% if (project.project_manager_name) { %>　项目管理员：<strong><%= project.project_manager_name %></strong><% } %></div>
  <div class="ms-auto d-flex gap-2"><a class="btn btn-sm btn-primary" href="/chapter-answers">进入章节应答</a><a class="btn btn-sm btn-outline-primary" href="/projects/<%= project.id %>/manage">项目配置与权限</a></div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="small text-secondary">纳入规范</div><div class="fs-3 fw-semibold"><%= (versionsInProject || []).length %></div><div class="small text-secondary">个规范版次</div></div></div></div>
  <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="small text-secondary">标准项总数</div><div class="fs-3 fw-semibold"><%= (versionsInProject || []).reduce((sum, version) => sum + Number(version.item_count || 0), 0) %></div><div class="small text-secondary">当前项目规范快照</div></div></div></div>
  <div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="small text-secondary">已完成应答</div><div class="fs-3 fw-semibold"><%= (versionsInProject || []).reduce((sum, version) => sum + Number(version.answered_count || 0), 0) %></div><div class="small text-secondary">按规范项统计</div></div></div></div>
</div>

<div class="card mb-3"><div class="card-header"><h2 class="card-title h6 mb-0">项目规范概览</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>规范</th><th>版次</th><th>快照时间</th><th>标准项</th><th>已应答</th><th>完整率</th><th>符合性分布</th><th class="text-end">操作</th></tr></thead><tbody>
<% (versionsInProject || []).forEach(version => { const total = Number(version.item_count || 0); const answered = Number(version.answered_count || 0); const completeness = total ? Math.round(answered * 100 / total) : 0; %><tr><td><strong><%= version.standard_code %></strong><div class="small text-secondary"><%= version.standard_name %></div></td><td><%= version.version %></td><td><%= version.snapshot_at ? new Date(version.snapshot_at).toLocaleString('zh-CN') : '-' %></td><td><%= total %></td><td><%= answered %></td><td><%= completeness %>%</td><td><span class="text-success">符合 <%= version.satisfied_count || 0 %></span>　<span class="text-warning">部分 <%= version.partially_satisfied_count || 0 %></span>　<span class="text-danger">不符合 <%= version.not_satisfied_count || 0 %></span></td><td class="text-end"><a class="btn btn-sm btn-primary" href="/chapter-answers/<%= version.id %>">进入应答</a></td></tr><% }) %>
<% if (!(versionsInProject || []).length) { %><tr><td colspan="8" class="text-center text-secondary py-5">当前项目尚未纳入规范。请先到项目配置与权限中纳入规范版次。</td></tr><% } %></tbody></table></div></div>

<div class="card"><div class="card-header"><h2 class="card-title h6 mb-0">项目导航</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><a class="btn btn-outline-primary w-100" href="/chapter-answers">章节应答</a><div class="small text-secondary mt-2">按章节分页维护条款应答、赋值、适用性和制度证据。</div></div><div class="col-md-4"><a class="btn btn-outline-primary w-100" href="/supervision-definitions">监督定义</a><div class="small text-secondary mt-2">维护持续监督方法及标准项覆盖关系。</div></div><div class="col-md-4"><a class="btn btn-outline-primary w-100" href="/supervision-executions">检查记录</a><div class="small text-secondary mt-2">查看和登记监督执行结果。</div></div></div></div></div>
