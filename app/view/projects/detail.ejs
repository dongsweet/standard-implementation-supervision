<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><span class="text-secondary">项目状态：<strong><%= project.status %></strong>　项目管理员：<strong><%= project.project_manager_name || '-' %></strong>　<% if (project.source_project_id) { %>来源：<strong>基线项目派生</strong><% } %></span><a class="btn btn-sm btn-outline-primary ms-auto" href="/projects/<%= project.id %>/manage">项目配置与权限</a></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">项目固定基线版本</h3></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>规范</th><th>版本</th><th>快照时间</th><th>标准项数</th></tr></thead><tbody><% (versionsInProject || []).forEach(version => { %><tr><td><%= version.standard_code %> · <%= version.standard_name %></td><td><%= version.version %></td><td><%= new Date(version.snapshot_at).toLocaleString('zh-CN') %></td><td><%= version.item_count %></td></tr><% }) %><% if (!(versionsInProject || []).length) { %><tr><td colspan="4" class="text-center text-secondary">尚未配置固定基线</td></tr><% } %></tbody></table></div></div>
<% items.forEach(item => { %><form id="answer-<%= item.standard_item_id %>" method="post" action="/projects/<%= project.id %>/answers/<%= item.standard_item_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"></form><% }) %>
<div class="card"><div class="card-header"><h3 class="card-title">章节应答（项目标准项快照）</h3><div class="card-tools text-secondary">共 <%= items.length %> 项</div></div><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead><tr><th>标准项</th><th>标准内容</th><th>应答状态</th><th>满足情况说明</th><th>问题与整改说明</th><th>操作</th></tr></thead><tbody>
<% items.forEach(item => { %><tr><td><strong><%= item.item_code_snapshot %></strong><div class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.title || '' %></div></td><td><%= item.content_snapshot %></td><td><select class="form-select form-select-sm" name="status" form="answer-<%= item.standard_item_id %>"><option value="unassessed" <%= item.answer_status === 'unassessed' ? 'selected' : '' %>>未评估</option><option value="satisfied" <%= item.answer_status === 'satisfied' ? 'selected' : '' %>>满足</option><option value="partially_satisfied" <%= item.answer_status === 'partially_satisfied' ? 'selected' : '' %>>部分满足</option><option value="not_satisfied" <%= item.answer_status === 'not_satisfied' ? 'selected' : '' %>>不满足</option><option value="not_applicable" <%= item.answer_status === 'not_applicable' ? 'selected' : '' %>>不适用</option></select></td><td><textarea class="form-control form-control-sm" name="measureDescription" form="answer-<%= item.standard_item_id %>" rows="2"><%= item.measure_description %></textarea></td><td><textarea class="form-control form-control-sm" name="problemDescription" form="answer-<%= item.standard_item_id %>" rows="2"><%= item.problem_description %></textarea></td><td><button class="btn btn-sm btn-primary" type="submit" form="answer-<%= item.standard_item_id %>">保存</button></td></tr><% }) %>
<% if (!items.length) { %><tr><td colspan="6" class="text-center text-secondary py-5">该项目创建时未选择基线项目，当前没有标准项快照。</td></tr><% } %></tbody></table></div></div>
