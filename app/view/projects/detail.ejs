<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><span class="text-secondary">项目状态：<strong><%= project.status %></strong>　项目管理员：<strong><%= project.project_manager_name || '-' %></strong>　<% if (project.source_project_name) { %>基于项目：<strong><%= project.source_project_name %></strong>（创建时复制，之后独立维护）<% } %></span><a class="btn btn-sm btn-outline-primary ms-auto" href="/projects/<%= project.id %>/manage">项目配置与权限</a></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">项目固定基线版本</h3></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>规范</th><th>版本</th><th>快照时间</th><th>标准项数</th></tr></thead><tbody><% (versionsInProject || []).forEach(version => { %><tr><td><%= version.standard_code %> · <%= version.standard_name %></td><td><%= version.version %></td><td><%= new Date(version.snapshot_at).toLocaleString('zh-CN') %></td><td><%= version.item_count %></td></tr><% }) %><% if (!(versionsInProject || []).length) { %><tr><td colspan="4" class="text-center text-secondary">尚未配置固定基线</td></tr><% } %></tbody></table></div></div>
<div class="card"><div class="card-header"><h3 class="card-title">章节应答（项目标准项快照）</h3><div class="card-tools text-secondary">共 <%= items.length %> 项</div></div><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead><tr><th>标准项</th><th>标准内容</th><th>应答状态</th><th>满足情况说明</th><th>问题与整改说明</th><th>操作</th></tr></thead><tbody>
<% items.forEach(item => { %><tr><td><strong><%= item.item_code_snapshot %></strong><div class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.title || '' %></div></td><td><%= item.content_snapshot %></td><td><span class="badge <%= item.answer_status === 'satisfied' ? 'text-bg-success' : item.answer_status === 'partially_satisfied' ? 'text-bg-warning' : item.answer_status === 'not_satisfied' ? 'text-bg-danger' : 'text-bg-secondary' %>"><%= item.answer_status === 'satisfied' ? '满足' : item.answer_status === 'partially_satisfied' ? '部分满足' : item.answer_status === 'not_satisfied' ? '不满足' : item.answer_status === 'not_applicable' ? '不适用' : '未评估' %></span></td><td><%= item.measure_description || '-' %></td><td><%= item.problem_description || '-' %></td><td><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#answerModal-<%= item.standard_item_id %>">编辑应答</button></td></tr><% }) %>
<% if (!items.length) { %><tr><td colspan="6" class="text-center text-secondary py-5">当前项目尚无标准项快照。创建项目时可选择“基于项目”复制已有内容。</td></tr><% } %></tbody></table></div></div>
<% items.forEach(item => { %>
  <div class="modal fade" id="answerModal-<%= item.standard_item_id %>" tabindex="-1" aria-labelledby="answerModalLabel-<%= item.standard_item_id %>" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <form method="post" action="/projects/<%= project.id %>/answers/<%= item.standard_item_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="answerModalLabel-<%= item.standard_item_id %>">编辑章节应答 · <%= item.item_code_snapshot %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body">
        <p class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.title || '' %></p><div class="border rounded p-3 mb-3 bg-body-tertiary"><%= item.content_snapshot %></div>
        <div class="mb-3"><label class="form-label" for="answerStatus-<%= item.standard_item_id %>">应答状态</label><select class="form-select" id="answerStatus-<%= item.standard_item_id %>" name="status"><option value="unassessed" <%= item.answer_status === 'unassessed' ? 'selected' : '' %>>未评估</option><option value="satisfied" <%= item.answer_status === 'satisfied' ? 'selected' : '' %>>满足</option><option value="partially_satisfied" <%= item.answer_status === 'partially_satisfied' ? 'selected' : '' %>>部分满足</option><option value="not_satisfied" <%= item.answer_status === 'not_satisfied' ? 'selected' : '' %>>不满足</option><option value="not_applicable" <%= item.answer_status === 'not_applicable' ? 'selected' : '' %>>不适用</option></select></div>
        <div class="mb-3"><label class="form-label" for="measureDescription-<%= item.standard_item_id %>">满足情况说明</label><textarea class="form-control" id="measureDescription-<%= item.standard_item_id %>" name="measureDescription" rows="4"><%= item.measure_description %></textarea></div>
        <div><label class="form-label" for="problemDescription-<%= item.standard_item_id %>">问题与整改说明</label><textarea class="form-control" id="problemDescription-<%= item.standard_item_id %>" name="problemDescription" rows="3"><%= item.problem_description %></textarea></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存应答</button></div>
    </form>
  </div></div></div>
<% }) %>
