<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><div class="text-secondary">项目：<strong><%= project.name %></strong>　文件：<strong><%= job.original_filename %></strong></div><a class="btn btn-sm btn-outline-secondary ms-auto" href="/projects/<%= project.id %>/manage">返回项目配置</a></div>

<div class="alert alert-info"><strong>导入方式：</strong>系统按“条款号”匹配当前项目的标准项快照；项目整理表中的云中心列组、应答、证据、监督措施和检查记录会分别写入对应模块。未匹配条款不会写入，正文差异只提示并等待确认。</div>

<div class="row g-3 mb-3"><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">工作簿条款</div><div class="fs-3 fw-semibold"><%= summary.rowCount %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">可匹配</div><div class="fs-3 fw-semibold text-success"><%= summary.matchedCount %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">未匹配</div><div class="fs-3 fw-semibold <%= summary.unmatchedCount ? 'text-danger' : 'text-success' %>"><%= summary.unmatchedCount %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">正文差异</div><div class="fs-3 fw-semibold <%= summary.contentDifferenceCount ? 'text-warning' : 'text-success' %>"><%= summary.contentDifferenceCount %></div></div></div></div></div>

<% if (cloudGroups.length) { %><div class="card mb-3"><div class="card-header"><h2 class="card-title h6 mb-0">云中心列组映射</h2></div><div class="card-body"><p class="small text-secondary">参考工作簿没有把云中心名称固定在两行表头中，导入前请把每个列组映射到当前项目的云中心。未映射的列组会跳过。</p><div class="row g-3"><% cloudGroups.forEach((group, index) => { const groupText = String(group || '').replace(/\s/g, ''); const matchedCenter = cloudCenters.find(center => { const centerText = String(center.name || '').replace(/\s/g, ''); return centerText && groupText && (centerText.includes(groupText) || groupText.includes(centerText)); }); %><div class="col-md-4"><label class="form-label" for="cloudCenter-<%= index %>"><%= group %></label><select class="form-select" id="cloudCenter-<%= index %>" name="cloudCenterIds"><option value="">不导入该列组</option><% cloudCenters.forEach(center => { %><option value="<%= center.id %>" <%= matchedCenter && matchedCenter.id === center.id ? 'selected' : '' %>><%= center.name %>（<%= center.code %>）</option><% }) %></select></div><% }) %></div></div></div><% } %>

<% if (unmatched.length) { %><div class="card mb-3 border-danger"><div class="card-header text-danger"><h2 class="card-title h6 mb-0">未匹配条款（前50条）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>工作表</th><th>行号</th><th>条款号</th><th>原因</th></tr></thead><tbody><% unmatched.slice(0, 50).forEach(row => { %><tr><td><%= row.sourceSheet %></td><td><%= row.sourceRow %></td><td><%= row.clauseNumber %></td><td><%= row.reason || '未匹配' %></td></tr><% }) %></tbody></table></div></div><% } %>
<% if (contentDifferences.length) { %><div class="card mb-3 border-warning"><div class="card-header text-warning-emphasis"><h2 class="card-title h6 mb-0">正文差异（前20条）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>条款号</th><th>项目快照正文</th><th>导入正文</th></tr></thead><tbody><% contentDifferences.slice(0, 20).forEach(row => { %><tr><td class="text-nowrap"><%= row.clauseNumber %></td><td><div class="small text-break"><%= row.snapshotContent %></div></td><td><div class="small text-break"><%= row.importedContent %></div></td></tr><% }) %></tbody></table></div></div><% } %>

<div class="card mb-3"><div class="card-header"><h2 class="card-title h6 mb-0">匹配预览（前8条）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>条款号</th><th>来源工作表</th><th>工作簿正文</th></tr></thead><tbody><% previewRows.forEach(row => { %><tr><td class="text-nowrap"><%= row.clauseNumber %></td><td><%= row.sourceSheet %></td><td><div class="text-break"><%= row.content %></div></td></tr><% }) %><% if (!previewRows.length) { %><tr><td colspan="3" class="text-center text-secondary py-4">没有可预览的匹配条款。</td></tr><% } %></tbody></table></div></div>

<form method="post" action="/projects/<%= project.id %>/data-imports/<%= job.id %>/apply" data-confirm="确认把匹配到的项目整理数据写入当前项目吗？系统会写入项目应答、云中心应答、监督定义和可解析的检查记录。" data-confirm-title="确认导入项目数据"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if (summary.unmatchedCount) { %><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="ackUnmatched" name="acknowledgeUnmatched" value="true"><label class="form-check-label" for="ackUnmatched">忽略未匹配条款，仅导入已匹配条款</label></div><% } %><% if (summary.contentDifferenceCount) { %><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="ackDiff" name="acknowledgeContentDifferences" value="true"><label class="form-check-label" for="ackDiff">我已查看正文差异，允许按项目快照继续导入</label></div><% } %><button class="btn btn-primary" type="submit" <%= (summary.unmatchedCount || summary.contentDifferenceCount) ? 'disabled' : '' %> id="applyImportButton">确认导入匹配数据</button></form>

<script>
(() => {
  const button = document.getElementById('applyImportButton');
  const unmatched = document.getElementById('ackUnmatched');
  const diff = document.getElementById('ackDiff');
  const refresh = () => { if (button) button.disabled = Boolean((unmatched && !unmatched.checked) || (diff && !diff.checked)); };
  unmatched?.addEventListener('change', refresh);
  diff?.addEventListener('change', refresh);
  refresh();
})();
</script>
