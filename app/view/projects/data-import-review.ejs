<% const isAnswerImport = summary.importMode === 'answer'; %>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><div class="text-secondary">项目：<strong><%= project.name %></strong>　文件：<strong><%= job.original_filename %></strong></div><a class="btn btn-sm btn-outline-secondary ms-auto" href="/chapter-answers">返回章节应答</a></div>

<div class="alert alert-info"><strong>导入方式：</strong><%= isAnswerImport ? '系统按“标准化编号”匹配项目标准项快照，导入规范体系具体要求、证据列表以及赋值/选择明细。' : '系统按“条款号”匹配当前项目的标准项快照；项目整理表中的云中心列组、应答、证据、监督措施和检查记录会分别写入对应模块。' %> <%= isAnswerImport ? '赋值明细会保留原文占位符、当前赋值和复核状态。' : '未匹配条款不会写入，正文差异只提示并等待确认。' %></div>
<% if (isAnswerImport && summary.snapshotMissingCount) { %><div class="alert alert-warning"><strong>项目基线缺少标准项：</strong>有 <%= summary.snapshotMissingCount %> 条数据对应的标准项存在于项目所选规范版本，但不在当前项目快照中。导入不会新增标准项；请返回章节应答刷新后重新预览，如仍缺失则检查标准版本与基线数据。若选择忽略未匹配项，这些数据不会导入。</div><% } %>

<div class="row g-3 mb-3"><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">工作簿条款</div><div class="fs-3 fw-semibold"><%= summary.rowCount %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">可匹配</div><div class="fs-3 fw-semibold text-success"><%= summary.matchedCount %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary">未匹配</div><div class="fs-3 fw-semibold <%= summary.unmatchedCount ? 'text-danger' : 'text-success' %>"><%= summary.unmatchedCount %></div></div></div></div><div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-secondary"><%= isAnswerImport ? '赋值待复核' : '正文差异' %></div><div class="fs-3 fw-semibold <%= (isAnswerImport ? summary.assignmentReviewCount : summary.contentDifferenceCount) ? 'text-warning' : 'text-success' %>"><%= isAnswerImport ? summary.assignmentReviewCount : summary.contentDifferenceCount %></div></div></div></div></div>

<% if (cloudGroups.length) { %><div class="card mb-3"><div class="card-header"><h2 class="card-title h6 mb-0">云中心列组映射</h2></div><div class="card-body"><p class="small text-secondary">参考工作簿没有把云中心名称固定在两行表头中，导入前请把每个列组映射到当前项目的云中心。未映射的列组会跳过。</p><div class="row g-3"><% cloudGroups.forEach((group, index) => { const groupText = String(group || '').replace(/\s/g, ''); const matchedCenter = cloudCenters.find(center => { const centerText = String(center.name || '').replace(/\s/g, ''); return centerText && groupText && (centerText.includes(groupText) || groupText.includes(centerText)); }); %><div class="col-md-4"><label class="form-label" for="cloudCenter-<%= index %>"><%= group %></label><select class="form-select" id="cloudCenter-<%= index %>" name="cloudCenterIds"><option value="">不导入该列组</option><% cloudCenters.forEach(center => { %><option value="<%= center.id %>" <%= matchedCenter && matchedCenter.id === center.id ? 'selected' : '' %>><%= center.name %>（<%= center.code %>）</option><% }) %></select></div><% }) %></div></div></div><% } %>

<% if (unmatched.length) { %><div class="card mb-3 border-danger"><div class="card-header text-danger"><h2 class="card-title h6 mb-0">未匹配条款（前50条）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>工作表</th><th>行号</th><th>标准化编号/条款号</th><th>原因</th></tr></thead><tbody><% unmatched.slice(0, 50).forEach(row => { %><tr><td><%= row.sourceSheet %></td><td><%= row.sourceRow %></td><td><%= row.standardNumber || row.clauseNumber %></td><td><%= row.reason || '未匹配' %></td></tr><% }) %></tbody></table></div></div><% } %>
<% if (contentDifferences.length) { %><div class="card mb-3 border-warning"><div class="card-header text-warning-emphasis"><h2 class="card-title h6 mb-0">正文差异（前20条）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>条款号</th><th>项目快照正文</th><th>导入正文</th></tr></thead><tbody><% contentDifferences.slice(0, 20).forEach(row => { %><tr><td class="text-nowrap"><%= row.clauseNumber %></td><td><div class="small text-break"><%= row.snapshotContent %></div></td><td><div class="small text-break"><%= row.importedContent %></div></td></tr><% }) %></tbody></table></div></div><% } %>
<% if (isAnswerImport && summary.assignmentReviewCount) { %><div class="card mb-3 border-warning"><div class="card-header text-warning-emphasis"><h2 class="card-title h6 mb-0">赋值/选择对应待复核（前50项）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>标准化编号</th><th>原文占位符</th><th>当前赋值</th><th>复核原因</th></tr></thead><tbody><% matches.flatMap(row => (row.assignmentDetails || []).filter(detail => detail.reviewRequired).map(detail => ({ row, detail }))).slice(0, 50).forEach(entry => { %><tr><td class="text-nowrap"><%= entry.row.standardNumber %></td><td><%= entry.detail.placeholder || entry.detail.label || '-' %></td><td><div class="text-break"><%= entry.detail.value || '-' %></div></td><td><%= entry.detail.reviewReason || '需要人工确认' %></td></tr><% }) %></tbody></table></div></div><% } %>
<% if (isAnswerImport && summary.assignmentIgnoredCount) { %><div class="alert alert-secondary py-2">有 <%= summary.assignmentIgnoredCount %> 条工作簿赋值没有在对应标准项正文或条款说明中找到赋值占位符，系统已跳过这些赋值内容；规范满足描述和证据仍可正常导入。</div><% } %>

<div class="card mb-3"><div class="card-header"><h2 class="card-title h6 mb-0">匹配预览（前8条）</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>标准化编号/条款号</th><th>来源工作表</th><th>赋值明细</th><th><%= isAnswerImport ? '规范体系具体要求' : '工作簿正文' %></th></tr></thead><tbody><% previewRows.forEach(row => { %><tr><td class="text-nowrap"><%= row.clauseNumber %></td><td><%= row.sourceSheet %></td><td><%= row.assignmentText || '-' %></td><td><div class="text-break"><%= row.content || '-' %></div></td></tr><% }) %><% if (!previewRows.length) { %><tr><td colspan="4" class="text-center text-secondary py-4">没有可预览的匹配条款。</td></tr><% } %></tbody></table></div></div>

<form method="post" action="/projects/<%= project.id %>/data-imports/<%= job.id %>/apply" data-confirm="确认把匹配到的规范满足数据写入当前项目吗？请先核对未匹配项及赋值关联。" data-confirm-title="确认导入规范满足数据"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if (summary.unmatchedCount) { %><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="ackUnmatched" name="acknowledgeUnmatched" value="true"><label class="form-check-label" for="ackUnmatched">忽略未匹配条款，仅导入已匹配条款</label></div><% } %><% if (summary.contentDifferenceCount) { %><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="ackDiff" name="acknowledgeContentDifferences" value="true"><label class="form-check-label" for="ackDiff">我已查看正文差异，允许按项目快照继续导入</label></div><% } %><% if (isAnswerImport && summary.assignmentReviewCount) { %><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="ackAssignmentReview" name="acknowledgeAssignmentReview" value="true"><label class="form-check-label" for="ackAssignmentReview">我已查看赋值/选择对应待复核项，允许保留复核标记后导入</label></div><% } %><button class="btn btn-primary" type="submit" <%= (summary.unmatchedCount || summary.contentDifferenceCount || (isAnswerImport && summary.assignmentReviewCount)) ? 'disabled' : '' %> id="applyImportButton">确认导入匹配数据</button></form>

<script>
(() => {
  const button = document.getElementById('applyImportButton');
  const unmatched = document.getElementById('ackUnmatched');
  const diff = document.getElementById('ackDiff');
  const assignment = document.getElementById('ackAssignmentReview');
  const refresh = () => { if (button) button.disabled = Boolean((unmatched && !unmatched.checked) || (diff && !diff.checked) || (assignment && !assignment.checked)); };
  unmatched?.addEventListener('change', refresh);
  diff?.addEventListener('change', refresh);
  assignment?.addEventListener('change', refresh);
  refresh();
})();
</script>
