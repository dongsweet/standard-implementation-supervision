<% const buildUrl = overrides => { const values = { search: filters.search, chapterCode: filters.chapterCode, status: filters.status, sortBy: filters.sortBy, sortDirection: filters.sortDirection, pageSize: pagination.pageSize, page: pagination.page, ...overrides }; const params = Object.entries(values).filter(([, value]) => value !== '' && value !== null && value !== undefined).map(([key, value]) => encodeURIComponent(key) + '=' + encodeURIComponent(value)).join('&'); return '/chapter-answers/' + project.standard_version_id + (params ? '?' + params : ''); }; %>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><span class="text-secondary">当前项目：<strong><%= project.project_name %></strong>　规范：<strong><%= project.standard_code %> · <%= project.standard_name %></strong>　版本：<strong><%= project.version %></strong></span><a class="btn btn-sm btn-outline-secondary ms-auto" href="/chapter-answers">返回规范总览</a></div>

<div class="card mb-3"><div class="card-body"><form method="get" action="/chapter-answers/<%= project.standard_version_id %>" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label small mb-1">搜索条款</label><input class="form-control form-control-sm" name="search" value="<%= filters.search %>" placeholder="编号、标题、正文"></div><div class="col-md-2"><label class="form-label small mb-1">按章筛选</label><select class="form-select form-select-sm" name="chapterCode"><option value="">全部章节</option><% chapters.forEach(chapter => { %><option value="<%= chapter.code %>" <%= filters.chapterCode === String(chapter.code) ? 'selected' : '' %>><%= chapter.code %> · <%= chapter.name %></option><% }) %></select></div><div class="col-md-2"><label class="form-label small mb-1">应答状态</label><select class="form-select form-select-sm" name="status"><option value="">全部状态</option><option value="unassessed" <%= filters.status === 'unassessed' ? 'selected' : '' %>>未标记</option><option value="satisfied" <%= filters.status === 'satisfied' ? 'selected' : '' %>>符合</option><option value="partially_satisfied" <%= filters.status === 'partially_satisfied' ? 'selected' : '' %>>部分符合</option><option value="not_satisfied" <%= filters.status === 'not_satisfied' ? 'selected' : '' %>>不符合</option></select></div><div class="col-md-2"><label class="form-label small mb-1">排序</label><select class="form-select form-select-sm" name="sortBy"><option value="standardNumber" <%= filters.sortBy === 'standardNumber' ? 'selected' : '' %>>标准化编号</option><option value="itemCode" <%= filters.sortBy === 'itemCode' ? 'selected' : '' %>>原文编号</option><option value="chapter" <%= filters.sortBy === 'chapter' ? 'selected' : '' %>>章节</option><option value="status" <%= filters.sortBy === 'status' ? 'selected' : '' %>>应答状态</option></select></div><div class="col-md-1"><label class="form-label small mb-1">方向</label><select class="form-select form-select-sm" name="sortDirection"><option value="asc" <%= filters.sortDirection === 'asc' ? 'selected' : '' %>>正序</option><option value="desc" <%= filters.sortDirection === 'desc' ? 'selected' : '' %>>倒序</option></select></div><div class="col-md-1"><label class="form-label small mb-1">每页</label><select class="form-select form-select-sm" name="pageSize"><% [20,50,100].forEach(size => { %><option value="<%= size %>" <%= pagination.pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></div><div class="col-md-1 d-flex gap-1"><button class="btn btn-sm btn-primary" type="submit">查找</button><a class="btn btn-sm btn-outline-secondary" href="/chapter-answers/<%= project.standard_version_id %>">重置</a></div></form></div></div>

<div class="card"><div class="card-header d-flex align-items-center"><h2 class="card-title h6 mb-0">规范应答明细</h2><span class="small text-secondary ms-3">共 <%= pagination.total %> 项</span></div><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead><tr><th>标准项</th><th>规范要求</th><th>云服务商赋值</th><th>适用性</th><th>符合性</th><th>制度文件/证据</th><th>制度符合性描述</th><th>操作</th></tr></thead><tbody>
<% items.forEach(item => { %><tr><td><strong><%= item.item_code_snapshot %></strong><div class="small text-secondary font-monospace"><%= item.standard_number_snapshot %></div><div class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.chapter_name %></div><% if (item.title) { %><div class="small text-secondary"><%= item.title %></div><% } %></td><td><%= item.content_snapshot %></td><td><% if (Array.isArray(item.assignment_details) && item.assignment_details.length) { %><% item.assignment_details.forEach(detail => { %><div class="small"><%= detail.label || (detail.type === 'selection' ? '选择项' : '需赋值项') %>：<%= detail.value || '待确认' %><% if (detail.reviewRequired) { %><span class="badge text-bg-warning ms-1">待复核</span><% } %></div><% }) %><% } else { %><%= item.clause_assignment || '-' %><% } %></td><td><span class="badge <%= item.applicability === 'applicable' ? 'text-bg-primary' : item.applicability === 'not_applicable' ? 'text-bg-secondary' : 'text-bg-light' %>"><%= item.applicability === 'applicable' ? '适用' : item.applicability === 'not_applicable' ? '不适用' : '未标记' %></span><% if (item.applicability_scope) { %><div class="small text-secondary"><%= item.applicability_scope %></div><% } %></td><td><span class="badge <%= item.answer_status === 'satisfied' ? 'text-bg-success' : item.answer_status === 'partially_satisfied' ? 'text-bg-warning' : item.answer_status === 'not_satisfied' ? 'text-bg-danger' : 'text-bg-secondary' %>"><%= item.answer_status === 'satisfied' ? '符合' : item.answer_status === 'partially_satisfied' ? '部分符合' : item.answer_status === 'not_satisfied' ? '不符合' : '未标记' %></span></td><td><%= item.actual_evidence || '-' %><% if (item.pending_evidence) { %><div class="small text-warning">待提供：<%= item.pending_evidence %></div><% } %></td><td><%= item.measure_description || '-' %><% if (item.problem_description) { %><div class="small text-danger">问题：<%= item.problem_description %></div><% } %></td><td><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#answerModal-<%= item.standard_item_id %>">编辑</button></td></tr><% }) %><% if (!items.length) { %><tr><td colspan="8" class="text-center text-secondary py-5">没有符合条件的标准项。</td></tr><% } %></tbody></table></div><div class="card-footer d-flex align-items-center"><span class="small text-secondary">第 <%= pagination.page %> / <%= pagination.pageCount %> 页</span><nav class="ms-auto"><ul class="pagination pagination-sm mb-0"><li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= pagination.page <= 1 ? '#' : buildUrl({ page: pagination.page - 1 }) %>">上一页</a></li><% for (let page = 1; page <= pagination.pageCount; page += 1) { %><li class="page-item <%= pagination.page === page ? 'active' : '' %>"><a class="page-link" href="<%= buildUrl({ page }) %>"><%= page %></a></li><% } %><li class="page-item <%= pagination.page >= pagination.pageCount ? 'disabled' : '' %>"><a class="page-link" href="<%= pagination.page >= pagination.pageCount ? '#' : buildUrl({ page: pagination.page + 1 }) %>">下一页</a></li></ul></nav></div></div>

<% items.forEach(item => { %><div class="modal fade" id="answerModal-<%= item.standard_item_id %>" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form method="post" action="/projects/<%= currentProject.id %>/answers/<%= item.standard_item_id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= buildUrl({}) %>"><div class="modal-header"><h2 class="modal-title fs-5">编辑章节应答 · <%= item.item_code_snapshot %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><div class="border rounded p-3 mb-3 bg-body-tertiary"><%= item.content_snapshot %></div><div class="row g-3"><div class="col-md-4"><label class="form-label">级别</label><input class="form-control" name="standardLevel" value="<%= item.standard_level %>"></div><div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="isKey" value="true" <%= item.is_key ? 'checked' : '' %>><label class="form-check-label">重点项</label></div></div><div class="col-md-4"><label class="form-label">云服务商赋值</label><input class="form-control" name="clauseAssignment" value="<%= item.clause_assignment %>"></div><div class="col-md-6"><label class="form-label">多云统管体系具体要求</label><textarea class="form-control" name="unifiedRequirement" rows="3"><%= item.unified_requirement %></textarea></div><div class="col-md-6"><label class="form-label">统一规范实施证据列表</label><textarea class="form-control" name="expectedEvidence" rows="3"><%= item.expected_evidence %></textarea></div><div class="col-md-5"><label class="form-label">适用性标记</label><select class="form-select" name="applicability"><option value="unspecified" <%= item.applicability === 'unspecified' ? 'selected' : '' %>>未标记</option><option value="applicable" <%= item.applicability === 'applicable' ? 'selected' : '' %>>适用</option><option value="not_applicable" <%= item.applicability === 'not_applicable' ? 'selected' : '' %>>不适用</option></select></div><div class="col-md-7"><label class="form-label">适用云中心或服务商范围</label><input class="form-control" name="applicabilityScope" value="<%= item.applicability_scope %>"></div><div class="col-md-5"><label class="form-label">符合性标记</label><select class="form-select" name="status"><option value="unassessed" <%= item.answer_status === 'unassessed' ? 'selected' : '' %>>未标记</option><option value="satisfied" <%= item.answer_status === 'satisfied' ? 'selected' : '' %>>符合</option><option value="partially_satisfied" <%= item.answer_status === 'partially_satisfied' ? 'selected' : '' %>>部分符合</option><option value="not_satisfied" <%= item.answer_status === 'not_satisfied' ? 'selected' : '' %>>不符合</option></select></div><div class="col-md-7"><label class="form-label">制度文件/证据材料</label><textarea class="form-control" name="actualEvidence" rows="2"><%= item.actual_evidence %></textarea></div><div class="col-12"><label class="form-label">制度符合性情况描述</label><textarea class="form-control" name="measureDescription" rows="4"><%= item.measure_description %></textarea></div><div class="col-12"><label class="form-label">问题与整改说明</label><textarea class="form-control" name="problemDescription" rows="3"><%= item.problem_description %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存应答</button></div></form></div></div></div><% }) %>
