<%
const buildUrl = overrides => {
  const values = {
    search: filters.search,
    chapterCode: filters.chapterCode,
    status: filters.status,
    sortBy: filters.sortBy,
    sortDirection: filters.sortDirection,
    chapterPage: pagination.page,
    chapterPageSize: pagination.pageSize,
    ...overrides,
  };
  const params = Object.entries(values)
    .filter(([, value]) => value !== '' && value !== null && value !== undefined)
    .map(([key, value]) => encodeURIComponent(key) + '=' + encodeURIComponent(value))
    .join('&');
  return '/chapter-answers/' + project.standard_version_id + (params ? '?' + params : '');
};
const chapterPageUrl = page => buildUrl({ chapterPage: page });
const assignmentDisplayValue = detail => {
  const normalizeOption = input => String(input || '').normalize('NFKC')
    .replace(/^\s*\[?\s*赋值\s*[:：]?\s*/, '')
    .replace(/\]\s*$/, '')
    .replace(/[^\p{L}\p{N}]/gu, '')
    .toLowerCase();
  if (detail.type !== 'selection') return String(detail.value || '').trim();
  const values = Array.isArray(detail.selectedValues)
    ? detail.selectedValues
    : detail.value ? [ detail.value ] : [];
  if (!values.length) return '未选择';
  const nestedOptions = String(detail.placeholder || '').match(/[\[［【]\s*赋值\s*[:：]\s*[^\]］】\r\n]+[\]］】]/gu) || [];
  return values.map(value => {
    const matched = nestedOptions.find(option => normalizeOption(option) === normalizeOption(value));
    return matched ? matched.replace(/^[\[［【]\s*赋值\s*[:：]\s*/, '').replace(/[\]］】]\s*$/, '') : value;
  }).join('；');
};
%>

<style>
  .answer-items-table-wrap { overflow-x: auto; }
  .answer-items-table { min-width: 96rem; table-layout: fixed; }
  .answer-items-table th, .answer-items-table td { padding: .7rem .8rem; vertical-align: top; }
  .answer-items-table .answer-col-number { width: 10.5rem; }
  .answer-items-table .answer-col-code { width: 9rem; }
  .answer-items-table .answer-col-title { width: 21rem; }
  .answer-items-table .answer-col-status { width: 7rem; }
  .answer-items-table .answer-col-action { width: 5.5rem; }
  .answer-items-table thead th { white-space: nowrap; font-size: .9rem; }
  .answer-item-number, .answer-item-code { white-space: nowrap; }
  .answer-item-copy { line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
  .answer-item-explanation { margin-bottom: .45rem; padding: .35rem .6rem; border-left: 3px solid var(--bs-info); background: var(--bs-tertiary-bg); line-height: 1.55; }
  .answer-item-explanation-label { margin-right: .35rem; color: var(--bs-secondary-color); font-weight: 600; }
  .answer-item-heading-path { display: flex; flex-direction: column; gap: .15rem; color: var(--bs-secondary-color); font-size: .82rem; line-height: 1.4; }
  .answer-item-heading { overflow-wrap: anywhere; }
  .answer-item-title { margin-top: .35rem; font-weight: 600; line-height: 1.45; }
  .answer-heading-group-row td { padding: .35rem .75rem; background: var(--bs-tertiary-bg); }
  .answer-heading-toggle { display: flex; align-items: center; gap: .5rem; width: 100%; border: 0; padding: .2rem 0; color: var(--bs-body-color); background: transparent; text-align: left; }
  .answer-heading-toggle-icon { display: inline-grid; place-items: center; width: 1.25rem; height: 1.25rem; border: 1px solid var(--bs-border-color); border-radius: .25rem; font-weight: 700; }
  .answer-heading-group-count { margin-left: auto; color: var(--bs-secondary-color); font-size: .82rem; }
  .answer-chapter-pagination .pagination { margin-bottom: 0; }
  .answer-filter-form { display: grid; grid-template-columns: minmax(15rem,2.1fr) minmax(10rem,1.2fr) minmax(9rem,1fr) minmax(7rem,.85fr) minmax(9rem,1fr) auto; gap: .5rem; align-items: end; }
  .answer-filter-form > .filter-field { min-width: 0; }
  .answer-filter-form .form-label { white-space: nowrap; }
  .answer-filter-actions { display: flex; gap: .5rem; align-items: end; }
  @media (max-width: 991.98px) {
    .answer-filter-form { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .answer-filter-form .filter-search { grid-column: 1 / -1; }
    .answer-items-table { min-width: 76rem; }
  }
</style>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <span class="text-secondary">当前项目：<strong><%= project.project_name %></strong>　规范：<strong><%= project.standard_code %> · <%= project.standard_name %></strong>　版本：<strong><%= project.version %></strong></span>
  <div class="ms-auto d-flex gap-2"><% if (canImport) { %><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#answerImportModal">导入规范满足情况</button><% } %><a class="btn btn-sm btn-outline-secondary" href="/chapter-answers">返回规范总览</a></div>
</div>

<% if (canImport) { %><div class="modal fade" id="answerImportModal" tabindex="-1" aria-labelledby="answerImportModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/projects/<%= currentProject.id %>/data-imports" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="modal-header"><h2 class="modal-title fs-5" id="answerImportModalLabel">导入规范满足情况</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><p class="small text-secondary">上传按标准化编号整理的规范满足工作簿，系统会先匹配、预览赋值和证据，再确认写入当前项目。</p><input class="form-control" type="file" name="file" accept=".xlsx" required><div class="form-text mt-2">说明项中的赋值也会按说明项自己的标准化编号导入。</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">上传并预览</button></div></form></div></div></div><% } %>

<div class="card mb-3">
  <div class="card-body">
    <form method="get" action="/chapter-answers/<%= project.standard_version_id %>" class="answer-filter-form">
      <div class="filter-field filter-search"><label class="form-label small mb-1" for="answerSearch">搜索条款</label><input class="form-control form-control-sm" id="answerSearch" name="search" value="<%= filters.search %>" placeholder="编号、标题、正文或说明"></div>
      <div class="filter-field"><label class="form-label small mb-1" for="answerChapter">按章筛选</label><select class="form-select form-select-sm" id="answerChapter" name="chapterCode"><option value="">全部章节</option><% chapterOptions.forEach(chapter => { %><option value="<%= chapter.code %>" <%= filters.chapterCode === String(chapter.code) ? 'selected' : '' %>><%= chapter.code %> · <%= chapter.name %></option><% }) %></select></div>
      <div class="filter-field"><label class="form-label small mb-1" for="answerStatus">应答范围</label><select class="form-select form-select-sm" id="answerStatus" name="status"><option value="">全部标准项</option><option value="unassessed" <%= filters.status === 'unassessed' ? 'selected' : '' %>>待应答</option><option value="satisfied" <%= filters.status === 'satisfied' ? 'selected' : '' %>>符合</option><option value="partially_satisfied" <%= filters.status === 'partially_satisfied' ? 'selected' : '' %>>部分符合</option><option value="not_satisfied" <%= filters.status === 'not_satisfied' ? 'selected' : '' %>>不符合</option></select></div>
      <div class="filter-field"><label class="form-label small mb-1" for="answerPageSize">每页章节</label><select class="form-select form-select-sm" id="answerPageSize" name="chapterPageSize"><% [ ['1','1章'], ['2','2章'], ['5','5章'], ['10','10章'], ['20','20章'], ['all','全部'] ].forEach(option => { %><option value="<%= option[0] %>" <%= pagination.pageSize === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }) %></select></div>
      <div class="filter-field"><label class="form-label small mb-1" for="answerSort">排序</label><select class="form-select form-select-sm" id="answerSort" name="sortBy"><option value="standardNumber" <%= filters.sortBy === 'standardNumber' ? 'selected' : '' %>>标准化编号</option><option value="itemCode" <%= filters.sortBy === 'itemCode' ? 'selected' : '' %>>原文编号</option><option value="chapter" <%= filters.sortBy === 'chapter' ? 'selected' : '' %>>章节</option><option value="status" <%= filters.sortBy === 'status' ? 'selected' : '' %>>应答状态</option></select></div>
      <div class="filter-field"><label class="form-label small mb-1" for="answerSortDirection">顺序</label><select class="form-select form-select-sm" id="answerSortDirection" name="sortDirection"><option value="asc" <%= filters.sortDirection === 'asc' ? 'selected' : '' %>>正序</option><option value="desc" <%= filters.sortDirection === 'desc' ? 'selected' : '' %>>倒序</option></select></div>
      <div class="filter-field"><label class="form-label small mb-1" for="answerHeadingDepth">标题分组</label><select class="form-select form-select-sm" id="answerHeadingDepth"><option value="0">不分组</option><option value="3">到第2级标题</option><option value="4" selected>到第3级标题</option><option value="5">到第4级标题</option><option value="6">到第5级标题</option></select></div>
      <div class="answer-filter-actions"><button class="btn btn-sm btn-primary" type="submit">查找</button><a class="btn btn-sm btn-outline-secondary" href="/chapter-answers/<%= project.standard_version_id %>">重置</a></div>
    </form>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
      <div class="small text-secondary">当前显示第 <%= pagination.firstChapter %>–<%= pagination.lastChapter %> 章，共 <%= pagination.totalChapters %> 章、<%= pagination.totalItems %> 项<% if (filters.search || filters.status || filters.chapterCode) { %>（筛选后）<% } %></div>
      <div class="d-flex gap-2"><button class="btn btn-sm btn-outline-secondary" id="collapseAnswerGroups" type="button">全部收起</button><button class="btn btn-sm btn-outline-secondary" id="expandAnswerGroups" type="button">全部展开</button></div>
    </div>
  </div>
  <% if (pagination.pageCount > 1 && pagination.pageSize !== 'all') { %>
    <div class="card-footer d-flex flex-wrap align-items-center gap-2 answer-chapter-pagination"><span class="small text-secondary">第 <%= pagination.page %> / <%= pagination.pageCount %> 页</span><nav class="ms-auto" aria-label="章节分页"><ul class="pagination pagination-sm"><li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= pagination.page <= 1 ? '#' : chapterPageUrl(pagination.page - 1) %>">上一页</a></li><% for (let page = 1; page <= pagination.pageCount; page += 1) { %><li class="page-item <%= page === pagination.page ? 'active' : '' %>"><a class="page-link" href="<%= chapterPageUrl(page) %>"><%= page %></a></li><% } %><li class="page-item <%= pagination.page >= pagination.pageCount ? 'disabled' : '' %>"><a class="page-link" href="<%= pagination.page >= pagination.pageCount ? '#' : chapterPageUrl(pagination.page + 1) %>">下一页</a></li></ul></nav></div>
  <% } %>
</div>

<% if (!chapters.length) { %><div class="card"><div class="card-body text-center text-secondary py-5">没有符合条件的标准项。</div></div><% } %>
<% chapters.forEach(chapter => { %>
  <div class="card mb-3">
    <div class="card-header d-flex align-items-center"><h3 class="card-title"><%= chapter.code %> · <%= chapter.name %> <span class="badge text-bg-light ms-2"><%= chapter.item_count %> 项</span></h3></div>
    <div class="table-responsive answer-items-table-wrap"><table class="table table-sm table-striped align-middle mb-0 answer-items-table">
      <colgroup><col class="answer-col-number"><col class="answer-col-code"><col class="answer-col-title"><col><col><col class="answer-col-status"><col class="answer-col-status"><col><col><col class="answer-col-action"></colgroup>
      <thead><tr><th>标准化编号</th><th>原文编号</th><th>标准项标题</th><th>条款说明与标准内容</th><th>应答赋值</th><th>适用性</th><th>符合性</th><th>实际证据</th><th>制度符合性描述</th><th>操作</th></tr></thead>
      <tbody><% const chapterItems = items.filter(item => item.chapter_code_snapshot === chapter.code); const chapterItemsByCode = new Map(chapterItems.map(item => [String(item.item_code_snapshot || '').normalize('NFKC').trim().toLowerCase(), item])); chapterItems.forEach(item => { const headingPath = Array.isArray(item.heading_path_snapshot) ? item.heading_path_snapshot : []; const itemCode = String(item.item_code_snapshot || ''); const normalizedItemCode = itemCode.normalize('NFKC').trim().toLowerCase(); const parentCode = itemCode.replace(/\s+[a-z]\s*[)）)_]\s*$/i, '').normalize('NFKC').trim().toLowerCase(); const parentItem = parentCode !== normalizedItemCode ? chapterItemsByCode.get(parentCode) : null; const inheritedExplanation = parentItem && parentItem.explanation_snapshot && String(parentItem.explanation_snapshot).trim() === String(item.explanation_snapshot || '').trim(); const explanationText = inheritedExplanation ? '' : String(item.explanation_snapshot || '').trim(); const contentText = String(item.content_snapshot || '').trim(); const contentRepeatsExplanation = explanationText && contentText && explanationText === contentText; const lastHeading = headingPath[headingPath.length - 1]; const showTitle = item.title && (!lastHeading || String(lastHeading.title || '').trim() !== String(item.title).trim()); %>
        <tr class="answer-item-row" data-heading-path="<%= JSON.stringify(headingPath) %>">
          <td class="answer-item-number font-monospace"><%= item.standard_number_snapshot %></td>
          <td class="answer-item-code"><strong><%= item.item_code_snapshot %></strong></td>
          <td><% if (headingPath.length) { %><div class="answer-item-heading-path"><% headingPath.forEach(heading => { %><div class="answer-item-heading" style="padding-left:<%= Math.max(0, Number(heading.level || 2) - 2) %>rem"><%= [heading.number, heading.title].filter(Boolean).join(' ') %></div><% }) %></div><% } %><% if (showTitle) { %><div class="answer-item-title"><%= item.title %></div><% } %><% if (!headingPath.length && !item.title) { %><span class="text-secondary">-</span><% } %></td>
          <td class="answer-item-copy"><% if (explanationText) { %><div class="answer-item-explanation"><span class="answer-item-explanation-label">说明：</span><span><%= explanationText %></span></div><% } %><% if (contentText && !contentRepeatsExplanation) { %><div><%= contentText %></div><% } %><% if (!explanationText && !contentText) { %><span class="text-secondary">-</span><% } %></td>
          <td class="answer-item-copy"><% if (Array.isArray(item.assignment_details) && item.assignment_details.length) { %><% item.assignment_details.filter(detail => detail.selected !== false).forEach(detail => { const detailLabel = detail.type === 'selection' ? '选择' : (detail.label || '需赋值项'); const detailClass = detail.parentSelectionId ? 'ms-3 border-start ps-2' : ''; %><div class="<%= detailClass %>"><span class="text-secondary"><%= detailLabel %>：</span><%= assignmentDisplayValue(detail) || '待确认' %><% if (detail.reviewRequired) { %><span class="badge text-bg-warning ms-1">待复核</span><% } %></div><% }) %><% } else { %><%= item.clause_assignment || '-' %><% } %></td>
          <td><span class="badge <%= item.applicability === 'applicable' ? 'text-bg-primary' : item.applicability === 'not_applicable' ? 'text-bg-secondary' : 'text-bg-light' %>"><%= item.applicability === 'applicable' ? '适用' : item.applicability === 'not_applicable' ? '不适用' : '未标记' %></span></td>
          <td><span class="badge <%= item.answer_status === 'satisfied' ? 'text-bg-success' : item.answer_status === 'partially_satisfied' ? 'text-bg-warning' : item.answer_status === 'not_satisfied' ? 'text-bg-danger' : 'text-bg-secondary' %>"><%= item.answer_status === 'satisfied' ? '符合' : item.answer_status === 'partially_satisfied' ? '部分符合' : item.answer_status === 'not_satisfied' ? '不符合' : '未标记' %></span></td>
          <td class="answer-item-copy"><%= item.actual_evidence || '-' %><% if (item.pending_evidence) { %><div class="small text-warning mt-1">待提供：<%= item.pending_evidence %></div><% } %></td>
          <td class="answer-item-copy"><%= item.compliance_description || '-' %><% if (item.answer_notes) { %><div class="small text-secondary mt-1">备注：<%= item.answer_notes %></div><% } %></td>
          <td><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#answerModal-<%= item.standard_item_id %>">编辑</button></td>
        </tr>
      <% }) %><% if (!chapterItems.length) { %><tr><td colspan="10" class="text-center text-secondary py-3">本章节暂无符合筛选的标准项。</td></tr><% } %></tbody>
    </table></div>
  </div>
<% }) %>

<% if (pagination.pageCount > 1 && pagination.pageSize !== 'all') { %><div class="card mb-3"><div class="card-footer d-flex flex-wrap align-items-center gap-2 answer-chapter-pagination"><span class="small text-secondary">第 <%= pagination.page %> / <%= pagination.pageCount %> 页</span><nav class="ms-auto" aria-label="章节分页"><ul class="pagination pagination-sm"><li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= pagination.page <= 1 ? '#' : chapterPageUrl(pagination.page - 1) %>">上一页</a></li><% for (let page = 1; page <= pagination.pageCount; page += 1) { %><li class="page-item <%= page === pagination.page ? 'active' : '' %>"><a class="page-link" href="<%= chapterPageUrl(page) %>"><%= page %></a></li><% } %><li class="page-item <%= pagination.page >= pagination.pageCount ? 'disabled' : '' %>"><a class="page-link" href="<%= pagination.page >= pagination.pageCount ? '#' : chapterPageUrl(pagination.page + 1) %>">下一页</a></li></ul></nav></div></div><% } %>

<% items.forEach(item => { %>
<div class="modal fade" id="answerModal-<%= item.standard_item_id %>" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <form method="post" action="/projects/<%= currentProject.id %>/answers/<%= item.standard_item_id %>" data-answer-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= buildUrl({}) %>">
    <div class="modal-header"><h2 class="modal-title fs-5">编辑章节应答 · <%= item.item_code_snapshot %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><p class="small text-secondary"><%= item.chapter_code_snapshot %> · <%= item.title || '' %></p><div class="border rounded p-3 mb-3 bg-body-tertiary"><% if (item.explanation_snapshot) { %><div class="answer-item-explanation"><span class="answer-item-explanation-label">说明：</span><span><%= item.explanation_snapshot %></span></div><% } %><% if (item.content_snapshot && item.content_snapshot !== item.explanation_snapshot) { %><div class="answer-item-copy"><%= item.content_snapshot %></div><% } %></div><div class="row g-3">
      <div class="col-md-12 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="isKey" value="true" <%= item.is_key ? 'checked' : '' %>><label class="form-check-label">重点项</label></div></div>
      <div class="col-12"><label class="form-label">占位符赋值</label>
        <% if (item.assignment_form && item.assignment_form.hasStructuredControls) { %>
          <div class="assignment-editor border rounded p-3 bg-body-tertiary" data-assignment-editor>
            <% item.assignment_form.controls.forEach(control => { %>
              <% if (control.kind === 'selection') { %>
                <div class="assignment-selection mb-3" data-role="selection-control" data-selection-key="<%= control.key %>" data-placeholder="<%= control.placeholder %>">
                  <div class="form-label mb-2">选择项 <span class="text-secondary small">可多选</span></div>
                  <% control.options.forEach(option => { %>
                    <div class="assignment-choice">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="<%= item.standard_item_id %>-<%= control.key %>-<%= option.label.replace(/[^a-zA-Z0-9\u4e00-\u9fff]/g, '') %>" data-role="selection-option" data-value="<%= option.value %>" data-label="<%= option.label %>" data-assignment-label="<%= option.assignmentLabel %>" data-assignment-placeholder="<%= option.assignmentPlaceholder %>" data-assignment-key="<%= option.assignmentPlaceholderId %>" <%= option.selected ? 'checked' : '' %>>
                        <label class="form-check-label" for="<%= item.standard_item_id %>-<%= control.key %>-<%= option.label.replace(/[^a-zA-Z0-9\u4e00-\u9fff]/g, '') %>"><%= option.label %></label>
                      </div>
                      <% if (option.assignmentPlaceholder) { %>
                        <div class="assignment-branch ms-4 mt-1 mb-2" data-role="assignment-branch">
                          <label class="form-label small mb-1"><%= option.assignmentLabel %> 的赋值</label>
                          <input class="form-control form-control-sm" data-role="assignment-value" data-label="<%= option.assignmentLabel %>" data-placeholder="<%= option.assignmentPlaceholder %>" data-assignment-key="<%= option.assignmentPlaceholderId %>" value="<%= option.assignmentValue %>" placeholder="请填写<%= option.assignmentLabel %>" required>
                        </div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="assignment-standalone mb-2" data-role="standalone-assignment">
                  <label class="form-label small mb-1"><%= control.label %></label>
                  <input class="form-control form-control-sm" data-role="standalone-value" data-label="<%= control.label %>" data-placeholder="<%= control.placeholder %>" data-assignment-key="<%= control.key %>" value="<%= control.value %>" placeholder="请填写<%= control.label %>">
                </div>
              <% } %>
            <% }) %>
          </div>
        <% } else { %>
          <input class="form-control" name="clauseAssignment" value="<%= item.clause_assignment %>" placeholder="该条款没有结构化占位符，可直接填写赋值说明">
        <% } %>
        <input type="hidden" name="assignmentDetails" data-role="assignment-details">
      </div>
      <div class="col-md-6"><label class="form-label">制度符合性描述</label><textarea class="form-control" name="complianceDescription" rows="3"><%= item.compliance_description %></textarea></div>
      <div class="col-md-6"><label class="form-label">所需证据</label><textarea class="form-control" name="expectedEvidence" rows="3"><%= item.expected_evidence %></textarea></div>
      <div class="col-md-5"><label class="form-label">适用性标记</label><select class="form-select" name="applicability"><option value="unspecified" <%= item.applicability === 'unspecified' ? 'selected' : '' %>>未标记</option><option value="applicable" <%= item.applicability === 'applicable' ? 'selected' : '' %>>适用</option><option value="not_applicable" <%= item.applicability === 'not_applicable' ? 'selected' : '' %>>不适用</option></select></div>
      <div class="col-md-5"><label class="form-label">符合性标记</label><select class="form-select" name="status"><option value="unassessed" <%= item.answer_status === 'unassessed' ? 'selected' : '' %>>未标记</option><option value="satisfied" <%= item.answer_status === 'satisfied' ? 'selected' : '' %>>符合</option><option value="partially_satisfied" <%= item.answer_status === 'partially_satisfied' ? 'selected' : '' %>>部分符合</option><option value="not_satisfied" <%= item.answer_status === 'not_satisfied' ? 'selected' : '' %>>不符合</option></select></div>
      <div class="col-12"><label class="form-label">实际证据</label><textarea class="form-control" name="actualEvidence" rows="2"><%= item.actual_evidence %></textarea></div>
      <div class="col-12"><label class="form-label">备注</label><textarea class="form-control" name="answerNotes" rows="3"><%= item.answer_notes %></textarea></div>
    </div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存应答</button></div>
  </form>
</div></div></div>
<% }) %>

<script>
(() => {
  document.querySelectorAll('[data-assignment-editor]').forEach(editor => {
    const refreshBranches = () => {
      editor.querySelectorAll('[data-role="selection-option"]').forEach(option => {
        const branch = option.closest('.assignment-choice')?.querySelector('[data-role="assignment-branch"]');
        if (!branch) return;
        branch.classList.toggle('d-none', !option.checked);
        const input = branch.querySelector('[data-role="assignment-value"]');
        if (input) {
          input.disabled = !option.checked;
          input.required = option.checked;
        }
      });
    };
    editor.querySelectorAll('[data-role="selection-option"]').forEach(option => {
      option.addEventListener('change', refreshBranches);
    });
    refreshBranches();
  });

  document.querySelectorAll('form[data-answer-form]').forEach(form => {
    form.addEventListener('submit', event => {
      const details = [];
      const emptySelectedAssignment = Array.from(form.querySelectorAll('[data-role="assignment-branch"]:not(.d-none) [data-role="assignment-value"]'))
        .find(input => !input.value.trim());
      if (emptySelectedAssignment) {
        event.preventDefault();
        emptySelectedAssignment.focus();
        emptySelectedAssignment.reportValidity();
        return;
      }
      form.querySelectorAll('[data-role="selection-control"]').forEach(control => {
        const options = Array.from(control.querySelectorAll('[data-role="selection-option"]:checked'));
        if (!options.length) return;
        const selectionKey = control.dataset.selectionKey;
        details.push({
          type: 'selection',
          label: '选择',
          placeholder: control.dataset.placeholder,
          placeholderId: selectionKey,
          parentSelectionId: null,
          selected: true,
          selectedValues: options.map(option => option.dataset.value),
          value: options[0].dataset.value,
        });
        for (const option of options) {
          const branch = option.closest('.assignment-choice')?.querySelector('[data-role="assignment-branch"]');
          const input = branch?.querySelector('[data-role="assignment-value"]');
          if (!input) continue;
          details.push({
            type: 'assignment',
            label: input.dataset.label,
            placeholder: input.dataset.placeholder,
            placeholderId: input.dataset.assignmentKey,
            parentSelectionId: selectionKey,
            selected: true,
            value: input.value.trim(),
          });
        }
      });
      form.querySelectorAll('[data-role="standalone-value"]').forEach(input => {
        if (!input.value.trim()) return;
        details.push({
          type: 'assignment',
          label: input.dataset.label,
          placeholder: input.dataset.placeholder,
          placeholderId: input.dataset.assignmentKey,
          parentSelectionId: null,
          selected: true,
          value: input.value.trim(),
        });
      });
      const target = form.querySelector('[data-role="assignment-details"]');
      if (target) target.value = JSON.stringify(details);
    });
  });

  const tables = Array.from(document.querySelectorAll('.answer-items-table'));
  const collapsedByTable = new Map();
  const headingKey = heading => [heading.number || '', heading.title || ''].join(' ').trim();
  const makeGroupId = headings => headings.map(headingKey).join(' / ');

  const applyCollapsedState = table => {
    const collapsed = collapsedByTable.get(table) || new Set();
    for (const row of table.querySelectorAll('.answer-heading-group-row')) {
      const parents = (row.dataset.parentGroupIds || '').split('|').filter(Boolean);
      const hiddenByParent = parents.some(id => collapsed.has(id));
      row.hidden = hiddenByParent;
      const icon = row.querySelector('.answer-heading-toggle-icon');
      if (icon) icon.textContent = collapsed.has(row.dataset.groupId) ? '+' : '−';
    }
    for (const row of table.querySelectorAll('.answer-item-row')) {
      const groups = (row.dataset.groupIds || '').split('|').filter(Boolean);
      row.hidden = groups.some(id => collapsed.has(id));
    }
  };

  const renderGroups = () => {
    const depth = Number(document.getElementById('answerHeadingDepth')?.value || 0);
    for (const table of tables) {
      table.querySelectorAll('.answer-heading-group-row').forEach(row => row.remove());
      const itemRows = Array.from(table.querySelectorAll('.answer-item-row'));
      const collapsed = collapsedByTable.get(table) || new Set();
      collapsedByTable.set(table, collapsed);
      let previousIds = [];
      for (const itemRow of itemRows) {
        let headings = [];
        try { headings = JSON.parse(itemRow.dataset.headingPath || '[]'); } catch {}
        const grouped = headings.filter(heading => Number(heading.level || 0) > 2 && Number(heading.level || 0) <= depth);
        const ids = [];
        for (let index = 0; index < grouped.length; index += 1) ids.push(makeGroupId(grouped.slice(0, index + 1)));
        let shared = 0;
        while (shared < previousIds.length && shared < ids.length && previousIds[shared] === ids[shared]) shared += 1;
        for (let index = shared; index < grouped.length; index += 1) {
          const groupId = ids[index];
          const row = document.createElement('tr');
          row.className = 'answer-heading-group-row';
          row.dataset.groupId = groupId;
          row.dataset.parentGroupIds = ids.slice(0, index).join('|');
          const cell = document.createElement('td');
          cell.colSpan = 10;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'answer-heading-toggle';
          button.innerHTML = '<span class="answer-heading-toggle-icon">−</span>';
          const label = document.createElement('strong');
          label.textContent = [grouped[index].number, grouped[index].title].filter(Boolean).join(' ');
          const count = document.createElement('span');
          count.className = 'answer-heading-group-count';
          count.textContent = itemRows.filter(candidate => {
            try {
              const path = JSON.parse(candidate.dataset.headingPath || '[]').filter(heading => Number(heading.level || 0) > 2 && Number(heading.level || 0) <= depth);
              return makeGroupId(path.slice(0, index + 1)) === groupId;
            } catch { return false; }
          }).length + ' 项';
          button.append(label, count);
          button.addEventListener('click', () => {
            if (collapsed.has(groupId)) collapsed.delete(groupId);
            else collapsed.add(groupId);
            applyCollapsedState(table);
          });
          cell.append(button);
          row.append(cell);
          itemRow.before(row);
        }
        itemRow.dataset.groupIds = ids.join('|');
        previousIds = ids;
      }
      applyCollapsedState(table);
    }
  };

  const depthSelect = document.getElementById('answerHeadingDepth');
  const savedDepth = localStorage.getItem('standardCatalogHeadingDepth');
  if (savedDepth && depthSelect && Array.from(depthSelect.options).some(option => option.value === savedDepth)) depthSelect.value = savedDepth;
  depthSelect?.addEventListener('change', () => {
    localStorage.setItem('standardCatalogHeadingDepth', depthSelect.value);
    renderGroups();
  });
  document.getElementById('collapseAnswerGroups')?.addEventListener('click', () => {
    for (const table of tables) {
      const collapsed = collapsedByTable.get(table) || new Set();
      table.querySelectorAll('.answer-heading-group-row').forEach(row => collapsed.add(row.dataset.groupId));
      collapsedByTable.set(table, collapsed);
      applyCollapsedState(table);
    }
  });
  document.getElementById('expandAnswerGroups')?.addEventListener('click', () => {
    for (const table of tables) {
      collapsedByTable.set(table, new Set());
      applyCollapsedState(table);
    }
  });
  renderGroups();
})();
</script>
