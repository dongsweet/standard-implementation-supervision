<div class="d-flex justify-content-between align-items-center mb-3"><p class="text-secondary mb-0">项目是业务组织边界；关联已发布规范版本时会生成项目标准项快照。</p><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newProjectForm">新建项目</button></div>
<div class="collapse mb-4" id="newProjectForm"><div class="card card-primary card-outline"><form method="post" action="/projects"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="card-body row g-3"><div class="col-md-3"><label class="form-label">项目编号</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">项目名称</label><input class="form-control" name="name" required></div></div><div class="card-footer"><button class="btn btn-primary" type="submit">创建项目</button></div></form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>项目编号</th><th>项目名称</th><th>状态</th><th>项目管理员</th><th>规范版本</th><th>云中心</th><th>操作</th></tr></thead><tbody>
<% projects.forEach(project => { %><tr><td><strong><%= project.code %></strong></td><td><%= project.name %></td><td><span class="badge text-bg-secondary"><%= project.status %></span></td><td><%= project.project_manager_name || '-' %></td><td><%= project.standard_version_count %></td><td><%= project.cloud_center_count %></td><td><a class="btn btn-sm btn-outline-primary" href="/projects/<%= project.id %>">进入项目</a></td></tr><% }) %>
<% if (!projects.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">暂无项目，请先创建项目。</td></tr><% } %></tbody></table></div></div>
