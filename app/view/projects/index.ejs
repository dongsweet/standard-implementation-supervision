<div class="d-flex justify-content-between align-items-center mb-3"><p class="text-secondary mb-0">项目管理独立于项目总览；规范应答、云中心、证据和持续监督都归属于当前项目。</p><% if (user && (user.roles || []).some(role => !role.projectId && ['system_admin','security_admin'].includes(role.code))) { %><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newProjectForm">新建项目</button><% } %></div>
<div class="collapse mb-4" id="newProjectForm"><div class="card card-primary card-outline"><form method="post" action="/projects"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="card-body row g-3"><div class="col-md-3"><label class="form-label">项目编号</label><input class="form-control" name="code" required></div><div class="col-md-5"><label class="form-label">项目名称</label><input class="form-control" name="name" required></div><div class="col-md-4"><label class="form-label">纳入基线项目（可选）</label><select class="form-select" name="sourceProjectId"><option value="">不纳入基线，创建空项目</option><% templates.forEach(template => { %><option value="<%= template.id %>"><%= template.code %> · <%= template.name %></option><% }) %></select><div class="form-text">创建时复制基线项目内容，创建后与基线项目完全独立。</div></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="isTemplate" value="true" id="isTemplate"><label class="form-check-label" for="isTemplate">将本项目标记为基线项目，允许后续项目从此项目创建</label></div></div></div><div class="card-footer"><button class="btn btn-primary" type="submit">创建项目</button></div></form></div></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>项目编号</th><th>项目名称</th><th>类型</th><th>来源项目</th><th>状态</th><th>项目管理员</th><th>规范版本</th><th>云中心</th><th>操作</th></tr></thead><tbody>
<% projects.forEach(project => { %><tr><td><strong><%= project.code %></strong><% if (currentProject && currentProject.id === project.id) { %><span class="badge text-bg-primary ms-2">当前项目</span><% } %></td><td><%= project.name %></td><td><span class="badge <%= project.is_template ? 'text-bg-info' : 'text-bg-light' %>"><%= project.is_template ? '基线项目' : '业务项目' %></span></td><td><%= project.source_project_id ? '基线派生' : '-' %></td><td><span class="badge text-bg-secondary"><%= project.status %></span></td><td><%= project.project_manager_name || '-' %></td><td><%= project.standard_version_count %></td><td><%= project.cloud_center_count %></td><td><a class="btn btn-sm btn-outline-primary" href="/projects/<%= project.id %>/manage">项目配置</a></td></tr><% }) %>
<% if (!projects.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">暂无项目，请先创建项目。</td></tr><% } %></tbody></table></div></div>
