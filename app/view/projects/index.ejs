<div class="d-flex justify-content-between align-items-center mb-3">
  <p class="text-secondary mb-0">项目管理独立于项目总览；规范应答、云中心、证据和持续监督都归属于当前项目。</p>
  <% if (user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createProjectModal">新建项目</button>
  <% } %>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>项目名称</th><th>基于项目</th><th>状态</th><th>项目管理员</th><th>规范版本</th><th>云中心</th><th>操作</th></tr></thead>
      <tbody>
        <% projects.forEach(project => { %>
          <tr>
            <td><strong><%= project.name %></strong><% if (currentProject && currentProject.id === project.id) { %><span class="badge text-bg-primary ms-2">当前项目</span><% } %></td>
            <td><%= project.source_project_name || '独立创建' %></td>
            <td><span class="badge text-bg-secondary"><%= project.status %></span></td>
            <td><%= project.project_manager_name || '-' %></td>
            <td><%= project.standard_version_count %></td>
            <td><%= project.cloud_center_count %></td>
            <td><a class="btn btn-sm btn-outline-primary" href="/projects/<%= project.id %>/manage">项目配置</a></td>
          </tr>
        <% }) %>
        <% if (!projects.length) { %><tr><td colspan="7" class="text-center text-secondary py-5">暂无项目，请先创建项目。</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<% if (user && (user.roles || []).some(role => !role.projectId && ['system_admin', 'security_admin'].includes(role.code))) { %>
  <div class="modal fade" id="createProjectModal" tabindex="-1" aria-labelledby="createProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <form method="post" action="/projects">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="modal-header"><h2 class="modal-title fs-5" id="createProjectModalLabel">新建项目</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
          <div class="modal-body">
            <div class="mb-3"><label class="form-label" for="newProjectName">项目名称</label><input class="form-control" id="newProjectName" name="name" maxlength="200" required autofocus></div>
            <div class="mb-3">
              <label class="form-label" for="sourceProjectId">基于项目（可选）</label>
              <select class="form-select" id="sourceProjectId" name="sourceProjectId">
                <option value="">不选择，创建空项目</option>
                <% projects.forEach(source => { %><option value="<%= source.id %>"><%= source.name %></option><% }) %>
              </select>
              <div class="form-text">选择后会复制该项目当前的规范基线和已有配置。创建完成后，两个项目独立维护，之后的变更不会互相同步。</div>
            </div>
            <div>
              <label class="form-label" for="projectManagerId">项目管理员（可选）</label>
              <select class="form-select" id="projectManagerId" name="projectManagerId">
                <option value="">稍后在项目配置中指定</option>
                <% (activeUsers || []).forEach(account => { %><option value="<%= account.id %>"><%= account.display_name %>（<%= account.username %>）</option><% }) %>
              </select>
            </div>
          </div>
          <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">创建项目</button></div>
        </form>
      </div>
    </div>
  </div>
<% } %>
