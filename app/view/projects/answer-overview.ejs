<div class="d-flex flex-wrap align-items-center gap-2 mb-3"><span class="text-secondary">当前项目：<strong><%= project.name %></strong></span><div class="ms-auto d-flex gap-2"><% if (canImport) { %><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#answerImportModal">导入规范满足情况</button><% } %><a class="btn btn-sm btn-outline-secondary" href="/project-overview">返回项目总览</a></div></div>

<div class="card"><div class="card-header"><h2 class="card-title h6 mb-0">项目规范总览</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>规范</th><th>版本</th><th>标准项数</th><th>已填写</th><th>完整率</th><th>符合性分布</th><th class="text-end">操作</th></tr></thead><tbody>
<% (standards || []).forEach(standard => { const completeness = standard.item_count ? Math.round(standard.answered_count * 100 / standard.item_count) : 0; %><tr><td><strong><%= standard.standard_code %></strong><div class="small text-secondary"><%= standard.standard_name %></div></td><td><%= standard.version %></td><td><%= standard.item_count %></td><td><%= standard.answered_count %></td><td><%= completeness %>%</td><td><span class="text-success">符合 <%= standard.satisfied_count %></span>　<span class="text-warning">部分 <%= standard.partially_satisfied_count %></span>　<span class="text-danger">不符合 <%= standard.not_satisfied_count %></span></td><td class="text-end"><a class="btn btn-sm btn-primary" href="/chapter-answers/<%= standard.standard_version_id %>">进入规范应答</a></td></tr><% }) %>
<% if (!(standards || []).length) { %><tr><td colspan="7" class="text-center text-secondary py-5">当前项目尚未纳入规范版本。</td></tr><% } %></tbody></table></div></div>

<% if (canImport) { %><div class="modal fade" id="answerImportModal" tabindex="-1" aria-labelledby="answerImportModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/projects/<%= project.id %>/data-imports" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="modal-header"><h2 class="modal-title fs-5" id="answerImportModalLabel">导入规范满足情况</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div><div class="modal-body"><p class="small text-secondary">支持按标准化编号整理的规范满足工作簿。上传后先进行标准项匹配、赋值对应和证据预览，再确认写入。</p><input class="form-control" type="file" name="file" accept=".xlsx" required><div class="form-text mt-2">赋值/选择无法唯一对应的项目会标记为待复核；正文没有占位符的条款不会写入误填赋值。</div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">上传并预览</button></div></form></div></div></div><% } %>
