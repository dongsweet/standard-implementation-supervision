<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="text-secondary">项目：<strong><%= project.name %></strong><% if (project.source_project_name) { %>　基于：<strong><%= project.source_project_name %></strong><% } %></div>
  <a class="btn btn-sm btn-outline-primary ms-auto" href="/project-overview">打开项目总览</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-12 col-xl-5"><div class="card h-100">
    <div class="card-header"><h3 class="card-title">项目信息</h3><button class="btn btn-sm btn-outline-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#editProjectModal">编辑</button></div>
    <div class="card-body"><dl class="row mb-0">
      <dt class="col-sm-4">项目名称</dt><dd class="col-sm-8"><%= project.name %></dd>
      <dt class="col-sm-4">项目状态</dt><dd class="col-sm-8"><span class="badge text-bg-secondary"><%= project.status %></span></dd>
      <dt class="col-sm-4">基于项目</dt><dd class="col-sm-8"><%= project.source_project_name || '独立创建' %></dd>
      <dt class="col-sm-4">规范版本</dt><dd class="col-sm-8"><%= (versions || []).length %> 个</dd>
    </dl></div>
  </div></div>
  <div class="col-12 col-xl-7"><div class="card h-100">
    <div class="card-header"><h3 class="card-title">项目管理员</h3><button class="btn btn-sm btn-outline-primary ms-auto" type="button" data-bs-toggle="modal" data-bs-target="#projectManagerModal">指定管理员</button></div>
    <div class="card-body"><div class="fw-semibold"><%= project.project_manager_name || '尚未指定' %></div><div class="form-text">项目管理员负责本项目的成员和章节负责人配置。</div></div>
  </div></div>
</div>

<div class="card mb-3">
  <div class="card-header"><h3 class="card-title">项目成员与项目角色</h3><span class="badge text-bg-secondary ms-auto me-2"><%= (members || []).length %> 人</span><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#projectMemberModal">添加或调整成员</button></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>用户</th><th>角色</th><th>状态</th><th class="text-end">操作</th></tr></thead>
    <tbody>
      <% (members || []).forEach(member => { %>
        <tr>
          <td><strong><%= member.display_name %></strong><div class="small text-secondary"><%= member.username %></div></td>
          <td><% (member.roles || []).forEach(role => { %><span class="badge <%= role.code === 'project_admin' ? 'text-bg-primary' : 'text-bg-light' %> me-1"><%= role.name %></span><% }) %></td>
          <td><span class="badge <%= member.is_active ? 'text-bg-success' : 'text-bg-secondary' %>"><%= member.is_active ? '启用' : '停用' %></span></td>
          <td class="text-end"><% if (member.id !== user.id) { %>
            <form method="post" action="/projects/<%= project.id %>/members/<%= member.id %>/delete" data-confirm="确定从本项目移除该成员及其章节负责人授权吗？" data-confirm-title="移除项目成员">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" type="submit">移除</button>
            </form>
          <% } else { %><span class="small text-secondary">当前账号</span><% } %></td>
        </tr>
      <% }) %>
      <% if (!(members || []).length) { %><tr><td colspan="4" class="text-center text-secondary py-4">尚未配置项目成员。</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<div class="card mb-3">
  <div class="card-header"><h3 class="card-title">章节负责人</h3><div class="card-tools small text-secondary">每个章节可指定一名或多名负责人，仅可选择本项目成员</div></div>
  <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
    <thead><tr><th style="width:22%">章节</th><th>负责人</th><th class="text-end">操作</th></tr></thead>
    <tbody>
      <% (chapters || []).forEach(chapter => { %>
        <tr>
          <td><strong><%= chapter.code %></strong><div class="small text-secondary"><%= chapter.name %></div></td>
          <td><%= (chapter.responsibles || []).map(account => account.displayName).join('、') || '未指定' %></td>
          <td class="text-end"><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#chapterResponsibilities-<%= chapter.id %>">设置负责人</button></td>
        </tr>
      <% }) %>
      <% if (!(chapters || []).length) { %><tr><td colspan="3" class="text-center text-secondary py-4">该项目尚未包含章节。</td></tr><% } %>
    </tbody>
  </table></div>
</div>

<div class="card"><div class="card-header"><h3 class="card-title">项目固定规范版本</h3></div><div class="table-responsive"><table class="table table-sm mb-0">
  <thead><tr><th>规范</th><th>版本</th><th>快照时间</th><th>标准项数</th></tr></thead>
  <tbody>
    <% (versions || []).forEach(version => { %><tr><td><%= version.standard_code %> · <%= version.standard_name %></td><td><%= version.version %></td><td><%= new Date(version.snapshot_at).toLocaleString('zh-CN') %></td><td><%= version.item_count %></td></tr><% }) %>
    <% if (!(versions || []).length) { %><tr><td colspan="4" class="text-center text-secondary py-4">该项目当前没有固定的规范版本。可在创建项目时基于已有项目复制。</td></tr><% } %>
  </tbody>
</table></div></div>

<div class="modal fade" id="editProjectModal" tabindex="-1" aria-labelledby="editProjectModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/projects/<%= project.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="editProjectModalLabel">编辑项目信息</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><label class="form-label" for="projectName">项目名称</label><input class="form-control" id="projectName" name="name" value="<%= project.name %>" maxlength="200" required></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="projectManagerModal" tabindex="-1" aria-labelledby="projectManagerModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/projects/<%= project.id %>/manager"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="projectManagerModalLabel">指定项目管理员</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body"><label class="form-label" for="projectManager">项目管理员</label><select class="form-select" id="projectManager" name="userId" required><option value="">请选择启用中的用户</option><% (availableUsers || []).forEach(account => { %><option value="<%= account.id %>" <%= project.project_manager_id === account.id ? 'selected' : '' %>><%= account.display_name %>（<%= account.username %>）</option><% }) %></select><div class="form-text">保存后会自动授予该账号本项目的“项目管理员”角色。</div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存管理员</button></div>
  </form>
</div></div></div>

<div class="modal fade" id="projectMemberModal" tabindex="-1" aria-labelledby="projectMemberModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/projects/<%= project.id %>/members"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="modal-header"><h2 class="modal-title fs-5" id="projectMemberModalLabel">添加或调整项目成员</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
    <div class="modal-body">
      <div class="mb-3"><label class="form-label" for="memberUserId">用户</label><select class="form-select" id="memberUserId" name="userId" required><option value="">请选择启用中的用户</option><% (availableUsers || []).forEach(account => { %><option value="<%= account.id %>"><%= account.display_name %>（<%= account.username %>）</option><% }) %></select></div>
      <div><label class="form-label" for="memberRoleCode">项目角色</label><select class="form-select" id="memberRoleCode" name="roleCode" required><option value="project_admin">项目管理员</option><option value="operator">操作员</option></select><div class="form-text">对已在项目中的用户保存新角色，会替换其原项目角色。</div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存成员</button></div>
  </form>
</div></div></div>

<% (chapters || []).forEach(chapter => { const selected = new Set((chapter.responsibles || []).map(account => account.id)); %>
  <div class="modal fade" id="chapterResponsibilities-<%= chapter.id %>" tabindex="-1" aria-labelledby="chapterResponsibilitiesLabel-<%= chapter.id %>" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <form method="post" action="/projects/<%= project.id %>/chapters/<%= chapter.id %>/responsibilities"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="modal-header"><h2 class="modal-title fs-5" id="chapterResponsibilitiesLabel-<%= chapter.id %>">设置章节负责人</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button></div>
      <div class="modal-body"><p class="mb-2"><strong><%= chapter.code %> · <%= chapter.name %></strong></p><label class="form-label" for="responsibles-<%= chapter.id %>">负责人（可多选）</label><select class="form-select" id="responsibles-<%= chapter.id %>" name="userIds" multiple size="6"><% (projectUsers || []).forEach(account => { %><option value="<%= account.id %>" <%= selected.has(account.id) ? 'selected' : '' %>><%= account.display_name %>（<%= account.username %>）</option><% }) %></select><div class="form-text">按住 Ctrl/⌘ 可选择多人。</div></div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button><button class="btn btn-primary" type="submit">保存负责人</button></div>
    </form>
  </div></div></div>
<% }) %>
