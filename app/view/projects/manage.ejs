<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <div class="text-secondary">项目编号：<strong><%= project.code %></strong>　项目名称：<strong><%= project.name %></strong></div>
  <a class="btn btn-sm btn-outline-primary ms-auto" href="/project-overview">打开项目总览</a>
</div>

<div class="row g-3 mb-3">
  <div class="col-12 col-xl-5"><div class="card h-100"><div class="card-header"><h3 class="card-title">项目基本信息</h3></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">项目状态</dt><dd class="col-sm-8"><span class="badge text-bg-secondary"><%= project.status %></span></dd><dt class="col-sm-4">项目类型</dt><dd class="col-sm-8"><%= project.is_template ? '基线项目' : '业务项目' %></dd><dt class="col-sm-4">来源项目</dt><dd class="col-sm-8"><%= project.source_project_id ? '由基线项目派生，已独立复制' : '无' %></dd><dt class="col-sm-4">固定基线</dt><dd class="col-sm-8"><%= (versions || []).length %> 个规范版本</dd></dl></div></div></div>
  <div class="col-12 col-xl-7"><div class="card h-100"><div class="card-header"><h3 class="card-title">项目管理员</h3></div><form method="post" action="/projects/<%= project.id %>/manager"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="card-body"><label class="form-label" for="projectManager">负责统筹本项目的人员</label><div class="input-group"><select class="form-select" id="projectManager" name="userId" required><option value="">请选择项目管理员</option><% (availableUsers || []).forEach(account => { %><option value="<%= account.id %>" <%= project.project_manager_id === account.id ? 'selected' : '' %>><%= account.display_name %>（<%= account.username %>）</option><% }) %></select><button class="btn btn-primary" type="submit">保存管理员</button></div><div class="form-text">保存后会自动授予该账号本项目的“项目管理员”角色。</div></div></form></div></div>
</div>

<div class="card mb-3"><div class="card-header"><h3 class="card-title">项目成员与项目角色</h3><span class="badge text-bg-secondary float-end"><%= (members || []).length %> 人</span></div><div class="card-body border-bottom"><form method="post" action="/projects/<%= project.id %>/members" class="row g-2 align-items-end"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-5"><label class="form-label">选择用户</label><select class="form-select" name="userId" required><option value="">请选择启用中的用户</option><% (availableUsers || []).forEach(account => { %><option value="<%= account.id %>"><%= account.display_name %>（<%= account.username %>）</option><% }) %></select></div><div class="col-md-4"><label class="form-label">项目角色</label><select class="form-select" name="roleCode" required><option value="project_admin">项目管理员</option><option value="operator">操作员</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary w-100" type="submit">添加或更新成员</button></div></form></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>用户</th><th>角色</th><th>状态</th><th class="text-end">操作</th></tr></thead><tbody><% (members || []).forEach(member => { %><tr><td><strong><%= member.display_name %></strong><div class="small text-secondary"><%= member.username %></div></td><td><% (member.roles || []).forEach(role => { %><span class="badge <%= role.code === 'project_admin' ? 'text-bg-primary' : 'text-bg-light' %> me-1"><%= role.name %></span><% }) %></td><td><span class="badge <%= member.is_active ? 'text-bg-success' : 'text-bg-secondary' %>"><%= member.is_active ? '启用' : '停用' %></span></td><td class="text-end"><% if (member.id !== user.id) { %><form method="post" action="/projects/<%= project.id %>/members/<%= member.id %>/delete" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" type="submit">移除</button></form><% } else { %><span class="small text-secondary">当前账号</span><% } %></td></tr><% }) %><% if (!(members || []).length) { %><tr><td colspan="4" class="text-center text-secondary py-4">尚未配置项目成员。</td></tr><% } %></tbody></table></div></div>

<div class="card mb-3"><div class="card-header"><h3 class="card-title">章节负责人</h3><div class="card-tools small text-secondary">每个章节可指定一名或多名负责人，仅可选择本项目成员</div></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th style="width:22%">章节</th><th>负责人</th><th class="text-end">操作</th></tr></thead><tbody><% (chapters || []).forEach(chapter => { const selected = new Set((chapter.responsibles || []).map(account => account.id)); %><tr><td><strong><%= chapter.code %></strong><div class="small text-secondary"><%= chapter.name %></div></td><td><form method="post" action="/projects/<%= project.id %>/chapters/<%= chapter.id %>/responsibilities" id="chapter-<%= chapter.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><select class="form-select form-select-sm" name="userIds" multiple size="3" aria-label="<%= chapter.code %>负责人"><% (projectUsers || []).forEach(account => { %><option value="<%= account.id %>" <%= selected.has(account.id) ? 'selected' : '' %>><%= account.display_name %>（<%= account.username %>）</option><% }) %></select><div class="form-text">按住 Ctrl/⌘ 可选择多人。</div></form></td><td class="text-end"><button class="btn btn-sm btn-outline-primary" type="submit" form="chapter-<%= chapter.id %>">保存负责人</button></td></tr><% }) %><% if (!(chapters || []).length) { %><tr><td colspan="3" class="text-center text-secondary py-4">该项目基线暂未包含章节。</td></tr><% } %></tbody></table></div></div></div>

<div class="card"><div class="card-header"><h3 class="card-title">项目固定基线</h3></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>规范</th><th>版本</th><th>快照时间</th><th>标准项数</th></tr></thead><tbody><% (versions || []).forEach(version => { %><tr><td><%= version.standard_code %> · <%= version.standard_name %></td><td><%= version.version %></td><td><%= new Date(version.snapshot_at).toLocaleString('zh-CN') %></td><td><%= version.item_count %></td></tr><% }) %><% if (!(versions || []).length) { %><tr><td colspan="4" class="text-center text-secondary py-4">该项目尚未配置基线。业务项目应在创建时选择基线项目。</td></tr><% } %></tbody></table></div></div></div>
